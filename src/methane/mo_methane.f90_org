MODULE mo_methane
! --------------------------------------------------------------
! Methane transport throught the soil column
! based on Rita Wania's implementation in LPJ
! as published in GMD (Wania et al., 2013)
!
! Modified for general application in JSBACH by
!
! Thomas Kleinen, MPI for Meteorology
! Feb 14, 2016
! thomas.kleinen@mpimet.mpg.de
! --------------------------------------------------------------
!
! currently, root distribution for plant transport follows Jackson et al. (1996)
! THIS IS INCONSISTENT WITH JSBACH rooting depth!
!
! --------------------------------------------------------------
!
! 

  USE mo_kind,                ONLY: dp
  USE mo_time_control,        ONLY: lstart, & ! .TRUE. for the first time step
                                    delta_time ! [s] seconds per timestep; time step in seconds
  USE mo_physical_constants,  ONLY: grav
  USE mo_math_constants,      ONLY: pi                        ! [-] pi, ratio of a circle's circumference to its diameter
  USE mo_jsbach_constants,    ONLY: tmelt, &                  ! [K] melting temperature of water 273.15 / 0°C
                                    rhoh2o, &                 ! [kg/m^3] density of liquid water 1000.0
                                    p_sealevel, &             ! [Pa] sea level standard pressure 101325
                                    UniversalGasConstant      ! [J/K/mol] = [Pa*m^3/K/mol] universal gas constant 8.3144621
  USE mo_soil,                ONLY: soil_param_type, soil_type
  USE mo_exception,           ONLY: finish, message, message_text, em_warn

  IMPLICIT NONE

  ! === BEGIN OF PUBLIC PART ===================================

  REAL(dp), PARAMETER :: standardPressAtm = 1._dp ! [atm] standard pressure in atm 101325Pa
  REAL(dp), PARAMETER :: atm = 1._dp / p_sealevel ! [atm/Pa] conversion factor for converting Pa in atm
  REAL(dp), PARAMETER :: UniversalGasConstant_atm_l = UniversalGasConstant * atm * 1000._dp  ! gas constant in [atm*l/K/mol]
  
  ! parameters for tile / grid cell consideration
  REAL(dp), PARAMETER :: min_inun_frac = 1.e-3_dp         ! minimum size of inundated fraction to be considered
  INTEGER,  PARAMETER :: minimum_no_layers = 3            ! minimum number of soil layers
  
  ! parameters for pore size consideration
  REAL(dp), PARAMETER :: minimum_porevol = 0.01_dp        ! minimum pore volume to consider
  
  TYPE methane_options_type
    REAL(dp)          :: frac_CH4_anox_mineral         ! [-] fraction of anerobically decomposed carbon that becomes CH4 for mineral soils
    REAL(dp)          :: frac_CH4_anox_organic         ! [-] fraction of anerobically decomposed carbon that becomes CH4 for organic soils
    LOGICAL           :: tile_level_output             ! switch on/off tile level output
    LOGICAL           :: outflux_output                ! switch on/off part flux output
    LOGICAL           :: debug_output                  ! switch on/off debug output
    LOGICAL           :: inst_output                   ! switch on/off output of instantaneous fluxes
    LOGICAL           :: wet_tile_output               ! switch tile level output between dry (FALSE) and wet (TRUE) tile
    INTEGER           :: tile_output_no                ! tile # for tile level output
    LOGICAL           :: tile_aggregated               ! aggregate over tiles (TRUE) or tile level calculations (FALSE)
    REAL(dp)          :: tile_threshold                ! tile size cutoff for CH4 calculations (0 - 0.01 resonable)
    REAL(dp)          :: meth_q10                      ! Q10 for CH4:CO2 ratio
    LOGICAL           :: vmr_namelist                  ! get CO2/CH4 VMR from namelist
    REAL(dp)          :: co2_vmr                       ! VMR of CO2 [m3/m3]
    REAL(dp)          :: ch4_vmr                       ! VMR of CH4 [m3/m3]
    REAL(dp)          :: termite_scale                 ! scale termite CH4 output
    REAL(dp)          :: herbivore_scale               ! scale herbivore CH4 output
    REAL(dp)          :: oxid_scale_dry                ! scale CH4 oxidation dry part
    REAL(dp)          :: oxid_scale_wet                ! scale CH4 oxidation wet part
    REAL(dp)          :: implicit_contrib              ! contribution from implicit part of Crank-Nicolson diffusion equation
    LOGICAL           :: GHG_from_atm                  ! get GHG concentrations from ECHAM
    LOGICAL           :: do_fire                       ! determine fire CH4 emissions
    LOGICAL           :: do_termite                    ! determine termite CH4 emissions
    LOGICAL           :: do_herbivore                  ! determine herbivory CH4 emissions
    INTEGER           :: diffusion_stepnum             ! number of diffusion steps per timestep
  END TYPE methane_options_type

  TYPE methane_type   ! state variables
    INTEGER                :: &
      mtiles                              ! number of tiles for methane
    ! all [mol m-2] are actually [mol m-2 timestep-1]
    REAL(dp)               :: &
      CH4_Air_Conc,           &     ! [mol m-3] surface air concentration of CH4
      CO2_Air_Conc,           &     ! [mol m-3] surface air concentration of CO2
      O2_Air_Conc                   ! [mol m-3] surface air concentration of  O2
    REAL(dp), POINTER, DIMENSION(:,:,:) :: &  ! (nland, nLayer, ntiles)
      CH4_dry,                &     ! [mol m-2] CH4 density in layer, dry part
      CO2_dry,                &     ! [mol m-2] CO2 density in layer, dry part
      O2_dry,                 &     ! [mol m-2]  O2 density in layer, dry part
      CH4_wet,                &     ! [mol m-2] CH4 density in layer, wet part
      CO2_wet,                &     ! [mol m-2] CO2 density in layer, wet part
      O2_wet                        ! [mol m-2]  O2 density in layer, wet part
    REAL(dp), POINTER, DIMENSION(:,:)   :: & ! (nland, ntiles)
      mask_wet,               &     ! calculation mask, wet part
      mask_dry,               &     ! calculation mask, dry part
      meth_landpoint,         &     ! # of land point
      tillers,                &     ! # of tillers
      cover_type,             &     ! land cover type
      wt_layer,               &     ! layer # with water table
      bedrock_layer,          &     ! layer # above bedrock
      inun_frac_pre,          &     ! inundated fraction during previous time step
      areaWeightingFactor,    &     ! area weighting factor for box aggregation
      tile_weight,            &     ! tile weight in aggregation
      
      CH4_prod_out_dry,       &     ! [mol m-2 timestep-1] CH4 production flux, dry part
      CH4_oxid_out_dry,       &     ! [mol m-2 timestep-1] CH4 oxidation flux, dry part
      CH4_diff_out_dry,       &     ! [mol m-2 timestep-1] CH4 diffusion flux, dry part
      CH4_plant_out_dry,      &     ! [mol m-2 timestep-1] CH4 plant transport flux, dry part
      CH4_total_out_dry,      &     ! [mol m-2 timestep-1] sum of CH4 part fluxes, dry part
      CH4_total_initial_dry,  &     ! [mol m-2] total CH4 in soil at beginning, dry part
      CH4_total_final_dry,    &     ! [mol m-2] total CH4 in soil at end, dry part
      
      CH4_prod_out_wet,       &     ! [mol m-2 timestep-1] CH4 production flux, wet part
      CH4_oxid_out_wet,       &     ! [mol m-2 timestep-1] CH4 oxidation flux, wet part
      CH4_ebul_out_wet,       &     ! [mol m-2 timestep-1] CH4 ebullition flux, wet part
      CH4_diff_out_wet,       &     ! [mol m-2 timestep-1] CH4 diffusion flux, wet part
      CH4_plant_out_wet,      &     ! [mol m-2 timestep-1] CH4 plant transport flux, wet part
      CH4_total_out_wet,      &     ! [mol m-2 timestep-1] sum of CH4 part fluxes, wet part
      CH4_total_initial_wet,  &     ! [mol m-2] total CH4 in soil at beginning, wet part
      CH4_total_final_wet,    &     ! [mol m-2] total CH4 in soil at end, wet part
      CH4_prod_ratio_out_wet, &     ! [1] ratio of CH4 to total anoxic production
      
      CO2_prod_out_dry,       &     ! [mol m-2 timestep-1] CO2 production flux, dry part
      CO2_oxid_out_dry,       &     ! [mol m-2 timestep-1] CO2 oxidation flux, dry part
      CO2_diff_out_dry,       &     ! [mol m-2 timestep-1] CO2 diffusion flux, dry part
      CO2_plant_out_dry,      &     ! [mol m-2 timestep-1] CO2 plant transport flux, dry part
      CO2_total_out_dry,      &     ! [mol m-2 timestep-1] sum of CO2 part fluxes, dry part
      CO2_total_initial_dry,  &     ! [mol m-2] total CO2 in soil at beginning, dry part
      CO2_total_final_dry,    &     ! [mol m-2] total CO2 in soil at end, dry part
      
      CO2_prod_out_wet,       &     ! [mol m-2 timestep-1] CO2 production flux, wet part
      CO2_oxid_out_wet,       &     ! [mol m-2 timestep-1] CO2 oxidation flux, wet part
      CO2_diff_out_wet,       &     ! [mol m-2 timestep-1] CO2 diffusion flux, wet part
      CO2_plant_out_wet,      &     ! [mol m-2 timestep-1] CO2 plant transport flux, wet part
      CO2_total_out_wet,      &     ! [mol m-2 timestep-1] sum of CO2 part fluxes, wet part
      CO2_total_initial_wet,  &     ! [mol m-2] total CO2 in soil at beginning, wet part
      CO2_total_final_wet,    &     ! [mol m-2] total CO2 in soil at end, wet part
      
      O2_other_out_dry,       &     ! [mol m-2 timestep-1] O2 other oxidation flux, dry part
      O2_oxid_out_dry,        &     ! [mol m-2 timestep-1] O2 oxidation flux, dry part
      O2_diff_out_dry,        &     ! [mol m-2 timestep-1] O2 diffusion flux, dry part
      O2_plant_out_dry,       &     ! [mol m-2 timestep-1] O2 plant transport flux, dry part
      O2_prod_out_dry,        &     ! [mol m-2 timestep-1] O2 uptake during oxic CO2 production, dry part
      O2_total_initial_dry,   &     ! [mol m-2] total O2 in soil at beginning, dry part
      O2_total_final_dry,     &     ! [mol m-2] total O2 in soil at end, dry part
      O2_total_out_dry,       &     ! [mol m-2 timestep-1] sum of O2 part fluxes, dry part
      O2_total_out_wet,       &     ! [mol m-2 timestep-1] sum of O2 part fluxes, wet part
      
      O2_other_out_wet,       &     ! [mol m-2 timestep-1] O2 other oxidation flux, wet part
      O2_oxid_out_wet,        &     ! [mol m-2 timestep-1] O2 oxidation flux, wet part
      O2_diff_out_wet,        &     ! [mol m-2 timestep-1] O2 diffusion flux, wet part
      O2_plant_out_wet,       &     ! [mol m-2 timestep-1] O2 plant transport flux, wet part
      O2_prod_out_wet,        &     ! [mol m-2 timestep-1] O2 uptake during oxic CO2 production, wet part
      O2_total_initial_wet,   &     ! [mol m-2] total O2 in soil at beginning, wet part
      O2_total_final_wet,     &     ! [mol m-2] total O2 in soil at end, wet part
      
      anox_prod_in,           &     ! [mol m-2 timestep-1] Anoxic production flux
      oxic_prod_in,           &     ! [mol m-2 timestep-1] Oxic production flux
      
      O2_out_dry,             &     ! [mol m-2(canopy) s-1] O2 outgoing flux, dry part
      O2_out_dry_acc,         &     ! [mol m-2(canopy) s-1] O2 outgoing flux, dry part (accumulated)
      O2_out_wet,             &     ! [mol m-2(canopy) s-1] O2 outgoing flux, wet part
      O2_out_wet_acc,         &     ! [mol m-2(canopy) s-1] O2 outgoing flux, wet part (accumulated)
      
      CO2_out_dry,            &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, dry part
      CO2_out_dry_acc,        &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, dry part (accumulated)
      CO2_out_wet,            &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, wet part
      CO2_out_wet_acc,        &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, wet part (accumulated)
      CO2_out_net,            &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, net (dry + wet)
      CO2_out_net_acc,        &     ! [mol m-2(canopy) s-1] CO2 outgoing flux, net (dry + wet) (accumulated)
      
      CH4_out_dry,            &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, dry part
      CH4_out_dry_acc,        &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, dry part (accumulated)
      CH4_out_wet,            &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, wet part
      CH4_out_wet_acc,        &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, wet part (accumulated)
      CH4_out_net,            &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, net (dry + wet)
      CH4_out_net_acc,        &     ! [mol m-2(canopy) s-1] CH4 outgoing flux, net (dry + wet) (accumulated)
      CH4_out_termite,        &     ! [mol m-2(canopy) s-1] CH4 outgoing flux from termites
      CH4_out_herbivore,      &     ! [mol m-2(canopy) s-1] CH4 outgoing flux from herbivores
     
      box_O2_out_dry,         &     ! [mol m-2(grid cell) s-1] O2 outgoing flux, dry part
      box_O2_out_dry_acc,     &     ! [mol m-2(grid cell) s-1] O2 outgoing flux, dry part (accumulated)
      box_O2_out_wet,         &     ! [mol m-2(grid cell) s-1] O2 outgoing flux, wet part
      box_O2_out_wet_acc,     &     ! [mol m-2(grid cell) s-1] O2 outgoing flux, wet part (accumulated)
      
      box_CO2_out_dry,        &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, dry part
      box_CO2_out_dry_acc,    &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, dry part (accumulated)
      box_CO2_out_wet,        &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, wet part
      box_CO2_out_wet_acc,    &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, wet part (accumulated)
      box_CO2_out_net,        &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, net (dry + wet)
      box_CO2_out_net_acc,    &     ! [mol m-2(grid cell) s-1] CO2 outgoing flux, net (dry + wet) (accumulated)
      
      box_CH4_out_dry,        &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, dry part
      box_CH4_out_dry_acc,    &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, dry part (accumulated)
      box_CH4_out_wet,        &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, wet part
      box_CH4_out_wet_acc,    &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, wet part (accumulated)
      box_CH4_out_net,        &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, net (dry + wet)
      box_CH4_out_net_acc,    &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux, net (dry + wet) (accumulated)
      
      box_CH4_out_termite,    &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from termites
      box_CH4_out_termite_acc,&     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from termites (accumulated)
      box_CH4_out_herbivore,    &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from herbivores
      box_CH4_out_herbivore_acc,&     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from herbivores (accumulated)
      
      termite_biomass,        &     ! [g m-2(canopy)]  biomass of termites 
      gpp_prev_year,          &     ! [mol m-2(canopy) yr-1]  annual GPP of previous year
      gpp_ann_sum                   ! [mol m-2(canopy)]  current year total GPP

      
    REAL(dp), POINTER, DIMENSION(:) :: &       ! (nland)
      CH4_conc_air,           &     ! [mol m-3] CH4 concentration in air
      CO2_conc_air,           &     ! [mol m-3] CO2 concentration in air
      CH4_mmr_air,            &     ! [kg kg-1] CH4 concentration in air
      CO2_mmr_air,            &     ! [kg kg-1] CO2 concentration in air
      box_CH4_out_fire,       &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from fire
      box_CH4_out_fire_acc,   &     ! [mol m-2(grid cell) s-1] CH4 outgoing flux from fire (accumulated)
      fire_em_NO,             &     ! [kg m-2(grid cell) s-1] NOx emission from fires
      fire_em_CO,             &     ! [kg m-2(grid cell) s-1] CO emission from fires
      fire_em_iso                   ! [kg m-2(grid cell) s-1] isoprene emission from fires
      
      
    REAL(dp), POINTER, DIMENSION(:,:) :: &       ! (nland, nLayer)
      tile_CH4_initial,       &     ! [mol m-2] initial CH4 density in (ice free pore space of) layer on tile
      tile_CO2_initial,       &     ! [mol m-2] initial CO2 density in (ice free pore space of) layer on tile
      tile_O2_initial,        &     ! [mol m-2] initial O2 density in (ice free pore space of) layer on tile
      
      tile_CH4,               &     ! [mol m-2] CH4 density in (ice free pore space of) layer on tile
      tile_CO2,               &     ! [mol m-2] CO2 density in (ice free pore space of) layer on tile
      tile_O2,                &     ! [mol m-2] O2 density in (ice free pore space of) layer on tile
      
      tile_CH4_conc,          &     ! [mol m-3] CH4 concentration in ice free pore space of layer on tile
      tile_CO2_conc,          &     ! [mol m-3] CO2 concentration in ice free pore space of layer on tile
      tile_O2_conc,           &     ! [mol m-3] O2 concentration in ice free pore space of layer on tile
      
      tile_CH4_plant,         &     ! [mol m-2] CH4 density transported by plants on tile
      tile_CH4_prod,          &     ! [mol m-2] CH4 density produced on tile
      tile_CH4_oxid,          &     ! [mol m-2] CH4 density oxidised on tile
      tile_CH4_ebul,          &     ! [mol m-2] CH4 density ebullited on tile
        
      tile_O2_plant,          &     ! [mol m-2] O2 density transported by plants on tile
      tile_O2_other,          &     ! [mol m-2] O2 density used in oxidation of others on tile
      tile_O2_oxid,           &     ! [mol m-2] O2 density that oxidised CH4 on tile
      
      tile_CO2_prod,          &     ! [mol m-2] CO2 density from production on tile
      tile_CO2_oxid,          &     ! [mol m-2] CO2 density that is oxidised CH4 on tile
      tile_CO2_plant,         &     ! [mol m-2] O2 density transported by plants on tile
      tile_root_dist,         &     ! [-] root distribution per layer
      effective_layer_volume, D_used
  END TYPE methane_type

  TYPE(methane_type), SAVE :: methane
  TYPE(methane_options_type), SAVE  :: methane_options

  PUBLIC :: methane_type, methane_options_type, methane, init_methane, update_methane, update_methane_fire, &
            update_methane_termites, update_methane_herbivores

  ! === END OF PUBLIC PART === BEGIN OF PRIVATE PART ===========

  PRIVATE
  LOGICAL,  PRIVATE   :: module_initialised = .FALSE.  ! Have config and init  been called?

  CONTAINS
  
!------------------------------------------------------------------------------------
    SUBROUTINE methane_init_config(ldisturbance, nml_unit)
      USE mo_namelist,         ONLY: position_nml, POSITIONED, LENGTH_ERROR, READ_ERROR
      USE mo_io_units,         ONLY: nout
      USE mo_mpi,              ONLY: p_parallel_io, p_io, p_parallel, p_bcast

      ! Input PARAMETERs
      LOGICAL, INTENT(IN) :: ldisturbance
      INTEGER, INTENT(IN) :: nml_unit

      ! Local namelist PARAMETERs
      REAL(dp)          :: frac_CH4_anox_mineral        ! [-] fraction of anerobically decomposed carbon that becomes CH4 for mineral soils
      REAL(dp)          :: frac_CH4_anox_organic        ! [-] fraction of anerobically decomposed carbon that becomes CH4 for organic soils
      LOGICAL           :: tile_level_output            ! switch on/off tile level output
      LOGICAL           :: outflux_output               ! switch on/off part flux output
      LOGICAL           :: debug_output                 ! switch on/off debug output
      LOGICAL           :: inst_output                  ! switch on/off output of instantaneous fluxes
      LOGICAL           :: wet_tile_output              ! tile level output for wet / dry tile => TRUE = output for wet tile
      INTEGER           :: tile_output_no               ! tile # for tile level output
      LOGICAL           :: tile_aggregated              ! tile aggregated (TRUE) or tile level calculation (FALSE)
      REAL(dp)          :: tile_threshold               ! [-] tile size cutoff for CH4 calculations (0 - 0.01 resonable)
      REAL(dp)          :: meth_q10                     ! Q10 for CH4:CO2 ratio
      LOGICAL           :: vmr_namelist                 ! get CO2/CH4 VMR from namelist
      REAL(dp)          :: co2_vmr                      ! VMR of CO2 [m3/m3]
      REAL(dp)          :: ch4_vmr                      ! VMR of CH4 [m3/m3]
      REAL(dp)          :: termite_scale                ! scale termite CH4 output
      REAL(dp)          :: herbivore_scale              ! scale herbivore CH4 output
      REAL(dp)          :: oxid_scale_dry               ! scale CH4 oxidation dry part
      REAL(dp)          :: oxid_scale_wet               ! scale CH4 oxidation wet part
      REAL(dp)          :: implicit_contrib             ! contribution from implicit part of Crank-Nicolson diffusion equation
      LOGICAL           :: GHG_from_atm                 ! get GHG concentration from ECHAM
      LOGICAL           :: do_fire                      ! determine fire CH4 emissions
      LOGICAL           :: do_termite                   ! determine termite CH4 emissions
      LOGICAL           :: do_herbivore                 ! determine herbivory CH4 emissions
      INTEGER           :: diffusion_stepnum            ! number of diffusion steps per timestep
      
      !other locals
      INTEGER  :: read_status
      INTEGER  :: f_unit

      INCLUDE 'methane_ctl.inc'

      IF (module_initialised) CALL finish('methane_init_config','Attempted to initialize module twice')
      IF (p_parallel_io) THEN
        ! set default values
        frac_CH4_anox_mineral = 0.1_dp
        frac_CH4_anox_organic = 0.1_dp
        tile_level_output = .FALSE.
        outflux_output = .FALSE.
        debug_output = .FALSE.
        inst_output = .FALSE.
        wet_tile_output = .FALSE.
        tile_output_no = 0
        tile_aggregated = .FALSE.
        tile_threshold = 0._dp
        meth_q10 = 1._dp
        vmr_namelist = .FALSE.
        co2_vmr = 400.e-6_dp
        ch4_vmr = 1885.e-9_dp
        termite_scale = 1.0_dp
        herbivore_scale = 1.0_dp
        oxid_scale_dry = 1.0_dp
        oxid_scale_wet = 1.0_dp
        implicit_contrib = 0.5_dp
        GHG_from_atm = .FALSE.
        do_fire = .TRUE.
        do_termite = .TRUE.
        do_herbivore = .TRUE.
        diffusion_stepnum = 1
        
        f_unit = position_nml ('METHANE_CTL', nml_unit, status=read_status)
        SELECT CASE (read_status)
          CASE (POSITIONED)
            READ (f_unit, methane_ctl)
            CALL message('methane_init_config','Namelist METHANE_CTL: ')
            WRITE(nout, methane_ctl)
          CASE (LENGTH_ERROR)
            CALL finish ('methane_init_config','Length error in namelist methane_ctl')
          CASE (READ_ERROR)
            CALL finish ('methane_init_config','Error reading namelist methane_ctl ')
          END SELECT

        IF ((.NOT. tile_level_output) .AND. (tile_output_no .GT. 0)) THEN
          tile_output_no = 0
          CALL message ('methane_init_config','tile level output is disabled, but output tile > 0 -- resetting output tile')
        END IF
        
        IF (GHG_from_atm .AND. vmr_namelist) THEN
          CALL message ('methane_init_config','GHG concentration input from BOTH namelist and ECHAM enabled -- disabling namelist')
          vmr_namelist = .FALSE.
        END IF
        
        IF (implicit_contrib < 0.1_dp) THEN
          CALL message ('methane_init_config','Crank-Nicolson contribution from implicit part implicit_contrib < 0.1 -- resetting to 0.')
          implicit_contrib = 0._dp
        END IF
        
        IF (do_fire .AND. .NOT. ldisturbance) THEN
          CALL message ('methane_init_config','fire methane emissions enable, but disturbance disabled -- disabling fire methane emissions')
          do_fire = .FALSE.
        END IF

        WRITE(message_text,*) '------------------------------------'
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'Running CH4 soil transport model with parameters:'
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'CH4 production fraction mineral soil ', frac_CH4_anox_mineral
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'CH4 production fraction organic soil ', frac_CH4_anox_organic
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'tile level output ', tile_level_output
        CALL message('methane_init_config', message_text)
        IF (tile_level_output) THEN
          WRITE(message_text,*) '  wet tile output ', wet_tile_output
          CALL message('methane_init_config', message_text)
          WRITE(message_text,*) '  tile no for output ', tile_output_no
          CALL message('methane_init_config', message_text)
        END IF
        WRITE(message_text,*) 'outflux output ', outflux_output
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) '  debug output ', debug_output
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) '  instantaneous flux output ', inst_output
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) '  tile aggregation ', tile_aggregated
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) '  tile size threshold ', tile_threshold
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'Q10 for methane production fraction ', meth_q10
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'implicit contribution in Crank-Nicolson diffusion ', implicit_contrib
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'diffusion steps per timestep ', diffusion_stepnum
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'fire methane emissions ', do_fire
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'termite methane emissions ', do_termite
        CALL message('methane_init_config', message_text)
        WRITE(message_text,*) 'herbivore methane emissions ', do_herbivore
        CALL message('methane_init_config', message_text)
        IF (GHG_from_atm) THEN
          WRITE(message_text,*) '  Using ECHAM values for GHG mmr'
          CALL message('methane_init_config', message_text)
        ELSE
          IF (vmr_namelist) THEN
            WRITE(message_text,*) '  Using namelist values for GHG vmr'
            CALL message('methane_init_config', message_text)
            WRITE(message_text,*) '  CO2 VMR: ', co2_vmr
            CALL message('methane_init_config', message_text)
            WRITE(message_text,*) '  CH4 VMR: ', ch4_vmr
            CALL message('methane_init_config', message_text)
          ELSE
            WRITE(message_text,*) '  Using default values for GHG vmr'
            CALL message('methane_init_config', message_text)
          END IF
        END IF
        IF (termite_scale .NE. 1.0_dp) THEN
          WRITE(message_text,*) 'Scaling termite CH4 production by ', termite_scale
          CALL message('methane_init_config', message_text)
        END IF
        IF (herbivore_scale .NE. 1.0_dp) THEN
          WRITE(message_text,*) 'Scaling herbivore CH4 production by ', herbivore_scale
          CALL message('methane_init_config', message_text)
        END IF
        IF (oxid_scale_dry .NE. 1.0_dp) THEN
          WRITE(message_text,*) 'Scaling dry CH4 oxidation by ', oxid_scale_dry
          CALL message('methane_init_config', message_text)
        END IF
        IF (oxid_scale_wet .NE. 1.0_dp) THEN
          WRITE(message_text,*) 'Scaling wet CH4 oxidation by ', oxid_scale_wet
          CALL message('methane_init_config', message_text)
        END IF
        WRITE(message_text,*) '------------------------------------'
        CALL message('methane_init_config', message_text)
      END IF

      ! Distribute namelist PARAMETERs
      IF (p_parallel) THEN
        CALL p_bcast(frac_CH4_anox_mineral,p_io)
        CALL p_bcast(frac_CH4_anox_organic,p_io)
        CALL p_bcast(tile_level_output,p_io)
        CALL p_bcast(outflux_output,p_io)
        CALL p_bcast(debug_output,p_io)
        CALL p_bcast(inst_output,p_io)
        CALL p_bcast(wet_tile_output,p_io)
        CALL p_bcast(tile_output_no,p_io)
        CALL p_bcast(tile_aggregated,p_io)
        CALL p_bcast(tile_threshold,p_io)
        CALL p_bcast(meth_q10,p_io)
        CALL p_bcast(vmr_namelist,p_io)
        CALL p_bcast(co2_vmr,p_io)
        CALL p_bcast(ch4_vmr,p_io)
        CALL p_bcast(termite_scale,p_io)
        CALL p_bcast(herbivore_scale,p_io)
        CALL p_bcast(oxid_scale_dry,p_io)
        CALL p_bcast(oxid_scale_wet,p_io)
        CALL p_bcast(implicit_contrib,p_io)
        CALL p_bcast(GHG_from_atm,p_io)
        CALL p_bcast(do_fire,p_io)
        CALL p_bcast(do_termite,p_io)
        CALL p_bcast(do_herbivore,p_io)
        CALL p_bcast(diffusion_stepnum,p_io)
      END IF

      methane_options%frac_CH4_anox_mineral     = frac_CH4_anox_mineral
      methane_options%frac_CH4_anox_organic     = frac_CH4_anox_organic
      methane_options%tile_level_output         = tile_level_output
      methane_options%outflux_output            = outflux_output
      methane_options%debug_output              = debug_output
      methane_options%inst_output               = inst_output
      methane_options%wet_tile_output           = wet_tile_output
      methane_options%tile_output_no            = tile_output_no
      methane_options%tile_aggregated           = tile_aggregated
      methane_options%tile_threshold            = tile_threshold
      methane_options%meth_q10                  = meth_q10
      methane_options%vmr_namelist              = vmr_namelist
      methane_options%co2_vmr                   = co2_vmr
      methane_options%ch4_vmr                   = ch4_vmr
      methane_options%termite_scale             = termite_scale
      methane_options%herbivore_scale           = herbivore_scale
      methane_options%oxid_scale_dry            = oxid_scale_dry
      methane_options%oxid_scale_wet            = oxid_scale_wet 
      methane_options%implicit_contrib          = implicit_contrib 
      methane_options%GHG_from_atm              = GHG_from_atm 
      methane_options%do_fire                   = do_fire 
      methane_options%do_termite                = do_termite
      methane_options%do_herbivore              = do_herbivore
      methane_options%diffusion_stepnum         = diffusion_stepnum
      
    END SUBROUTINE methane_init_config

!------------------------------------------------------------------------------------
    SUBROUTINE init_methane(grid, domain, soil, fileformat, fileztype, &
                            methane, stream, ldisturbance, nml_unit)
      ! Initialises the methane module.
      ! In particular the structure "methane" is initialised.

      USE mo_jsbach_grid,  ONLY: grid_type, domain_type
      USE mo_linked_list,  ONLY: t_stream, LAND, TILES, NETCDF, METHT, SOILLEV
      USE mo_memory_base,  ONLY: new_stream, &
                                 default_stream_setting, &
                                 add => add_stream_element
      USE mo_output,       ONLY: methane_table
      USE mo_jsbach,       ONLY: missing_value
      USE mo_netCDF,       ONLY: max_dim_name, add_dim

      IMPLICIT NONE

      TYPE(grid_type),         INTENT(IN)    :: grid
      TYPE(domain_type),       INTENT(IN)    :: domain
      TYPE(soil_type),         INTENT(IN)    :: soil

      INTEGER,                 INTENT(IN)    :: fileformat, fileztype
      LOGICAL,                 INTENT(IN)    :: ldisturbance
      INTEGER,                 INTENT(IN)    :: nml_unit

      TYPE(methane_type),      INTENT(INOUT) :: methane
      TYPE(t_stream), POINTER, OPTIONAL      :: stream

      ! local variables
      INTEGER  :: g_nland, l_nland, ntiles, nsoil, ctiles
      INTEGER  :: k, i
      INTEGER  :: dim1p(1), dim1(1), dim2p(2), dim2(2), dim3p(2)
      INTEGER  :: dim3(2), dim4p(3), dim4(3), dim5p(2), dim5(2)
      LOGICAL  :: tile_output, outflux_output, debug_output, inst_output

      CHARACTER(LEN=max_dim_name) :: dim1n(1), dim2n(2), dim3n(2), &
                                     dim4n(3), dim5n(2)
      TYPE(t_stream), POINTER     :: IO_methane
      REAL(dp)                    :: meth_tile(soil%ntiles)

      CALL methane_init_config(ldisturbance, nml_unit)
      module_initialised = .TRUE.
      
      g_nland = grid%nland
      l_nland = domain%nland
      ntiles  = soil%ntiles
      nsoil = soil%nsoil
      
      IF (methane_options%tile_aggregated) THEN
        ctiles = 2
      ELSE
        ctiles = ntiles
      END IF
      methane%mtiles = ctiles
      
      DO i = 1, ctiles
        meth_tile(i) = REAL(i,dp)
      END DO
      CALL add_dim ("meth_tile", ctiles, longname='methane tile', levtyp = 75, &
                    units = '1', value = meth_tile(1:ctiles), indx = METHT)
      
      dim1p = (/ l_nland /)
      dim1  = (/ g_nland /)
      dim1n = (/ 'landpoint' /)

      dim2p = (/ l_nland, nsoil /)
      dim2  = (/ g_nland, nsoil /)
      dim2n(1) = 'landpoint'
      dim2n(2) = 'soil_layer'

      dim3p = (/ l_nland, ctiles /)
      dim3  = (/ g_nland, ctiles /)
      dim3n(1) = 'landpoint'
      dim3n(2) = 'meth_tile'

      dim4p = (/ l_nland, nsoil, ctiles /)
      dim4  = (/ g_nland, nsoil, ctiles /)
      dim4n(1) = 'landpoint'
      dim4n(2) = 'soil_layer'
      dim4n(3) = 'meth_tile'
      
      dim5p = (/ l_nland, ntiles /)
      dim5  = (/ g_nland, ntiles /)
      dim5n(1) = 'landpoint'
      dim5n(2) = 'tiles'
      
      tile_output = methane_options%tile_level_output
      outflux_output = methane_options%outflux_output
      debug_output = methane_options%debug_output
      inst_output = methane_options%inst_output
      
      IF (.NOT. ASSOCIATED(soil%thaw_depth)) THEN
        CALL message('init_methane','Methane configured without permafrost. This is not intended, but may work.')
      END IF

      ! Stream definition
      IF (PRESENT(stream)) THEN
        IF (.NOT. ASSOCIATED(stream)) THEN
          ! Add new stream
          CALL new_stream(stream, 'methane', filetype=fileformat, ztype=fileztype)
          ! Set default stream options
          CALL default_stream_setting(stream, table=methane_table, repr=LAND, contnorest=.TRUE., lpost=.TRUE., &
                                      lrerun=.TRUE., leveltype=METHT)
        END IF
        IO_methane => stream
      ELSE
        ! Add new stream
        CALL new_stream(IO_methane, 'methane', filetype=fileformat, ztype=fileztype)
        ! Set default stream options
        CALL default_stream_setting(IO_methane, table=methane_table, repr=LAND, contnorest=.TRUE., lpost=.TRUE., &
                                    lrerun=.TRUE., leveltype=METHT)
      END IF


      ! --- Define variables as stream elements
      ! code numbers of this routine range from 1 to 209,
      ! using the GRIB methane_table
      ! used numbers: 1-200
      CALL add(IO_methane, 'CH4_wet', methane%CH4_wet, longname= 'CH4 density in layer, wet fraction',       &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=1, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
      CALL add(IO_methane, 'CO2_wet', methane%CO2_wet, longname= 'CO2 density in layer, wet fraction',       &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=2, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
      CALL add(IO_methane, 'O2_wet', methane%O2_wet, longname= ' O2 density in layer, wet fraction',         &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=3, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
              
      CALL add(IO_methane, 'CH4_dry', methane%CH4_dry, longname= 'CH4 density in layer, dry fraction',       &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=4, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
      CALL add(IO_methane, 'CO2_dry', methane%CO2_dry, longname= 'CO2 density in layer, dry fraction',       &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=5, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
      CALL add(IO_methane, 'O2_dry', methane%O2_dry, longname= ' O2 density in layer, dry fraction',         &
              units='mol m-2', ldims=dim4p, gdims=dim4, dimnames=dim4n, code=6, lpost=.FALSE., lmiss=.TRUE., &
              missval=missing_value, lrerun=.TRUE., leveltype=SOILLEV)
              
      CALL add(IO_methane,'inun_frac_pre', methane%inun_frac_pre,                                            &
              longname= 'inundated fraction previous time step',                                             &
              units='-', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=7, contnorest=.TRUE., lpost=.TRUE.,   &
              lmiss=.TRUE., lrerun=.TRUE., missval=missing_value)
              
      IF (methane_options%outflux_output) THEN
        ! code number gap 8-9
        CALL add(IO_methane, 'CH4_total_initial_wet', methane%CH4_total_initial_wet, longname= 'Total CH4_wet in soil at start', &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=10,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_total_final_wet', methane%CH4_total_final_wet, longname= 'Total CH4_wet in soil at end',       &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=11,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_total_initial_wet', methane%CO2_total_initial_wet, longname= 'Total CO2_wet in soil at start', &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=12,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_total_final_wet', methane%CO2_total_final_wet, longname= 'Total CO2_wet in soil at end',       &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=13,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'O2_total_initial_wet', methane%O2_total_initial_wet, longname= 'Total O2_wet in soil at start',    &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=14,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'O2_total_final_wet', methane%O2_total_final_wet, longname= 'Total O2_wet in soil at end',          &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=15,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)

        CALL add(IO_methane, 'CH4_total_initial_dry', methane%CH4_total_initial_dry, longname= 'Total CH4_dry in soil at start', &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=16,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_total_final_dry', methane%CH4_total_final_dry, longname= 'Total CH4_dry in soil at end',       &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=17,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_total_initial_dry', methane%CO2_total_initial_dry, longname= 'Total CO2_dry in soil at start', &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=18,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_total_final_dry', methane%CO2_total_final_dry, longname= 'Total CO2_dry in soil at end',       &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=19,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'O2_total_initial_dry', methane%O2_total_initial_dry, longname= 'Total O2_dry in soil at start',    &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=20,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'O2_total_final_dry', methane%O2_total_final_dry, longname= 'Total O2_dry in soil at end',          &
                units='mol m-2', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=21,                                               &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)

        ! code number gap 22-24
        CALL add(IO_methane, 'CH4_prod_out_wet', methane%CH4_prod_out_wet, longname= 'CH4_wet production flux',    &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=25,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_oxid_out_wet', methane%CH4_oxid_out_wet, longname= 'CH4_wet oxidation flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=26,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_ebul_out_wet', methane%CH4_ebul_out_wet, longname= 'CH4_wet ebullition flux',    &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=27,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_diff_out_wet', methane%CH4_diff_out_wet, longname= 'CH4_wet diffusion flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=28,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_plant_out_wet', methane%CH4_plant_out_wet, longname= 'CH4_wet plant transport flux', &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=29,                          &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
                
        CALL add(IO_methane, 'CH4_prod_out_dry', methane%CH4_prod_out_dry, longname= 'CH4_dry production flux',    &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=31,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_oxid_out_dry', methane%CH4_oxid_out_dry, longname= 'CH4_dry oxidation flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=32,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_diff_out_dry', methane%CH4_diff_out_dry, longname= 'CH4_dry diffusion flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=34,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CH4_plant_out_dry', methane%CH4_plant_out_dry, longname= 'CH4_dry plant transport flux', &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=35,                          &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
                
        CALL add(IO_methane, 'CO2_prod_out_wet', methane%CO2_prod_out_wet, longname= 'CO2_wet production flux',    &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=37,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_oxid_out_wet', methane%CO2_oxid_out_wet, longname= 'CO2_wet oxidation flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=38,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_diff_out_wet', methane%CO2_diff_out_wet, longname= 'CO2_wet diffusion flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=39,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_plant_out_wet', methane%CO2_plant_out_wet, longname= 'CO2_wet plant transport flux', &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=40,                          &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
                
        CALL add(IO_methane, 'CO2_prod_out_dry', methane%CO2_prod_out_dry, longname= 'CO2_dry production flux',    &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=42,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_oxid_out_dry', methane%CO2_oxid_out_dry, longname= 'CO2_dry oxidation flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=43,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_diff_out_dry', methane%CO2_diff_out_dry, longname= 'CO2_dry diffusion flux',     &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=44,                      &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'CO2_plant_out_dry', methane%CO2_plant_out_dry, longname= 'CO2_dry plant transport flux', &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=45,                          &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
                
        CALL add(IO_methane, 'O2_other_out_wet', methane%O2_other_out_wet, longname= 'O2_wet other oxidation flux', &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=47,                       &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
        CALL add(IO_methane, 'O2_oxid_out_wet', methane%O2_oxid_out_wet, longname= 'O2_wet oxidation flux',         &
                units='mol m-2 timestep-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=48,                       &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=outflux_output)
