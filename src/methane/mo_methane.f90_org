               units='mol(CH4) m-2(grid box) s-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=125, laccu=.TRUE., &
               contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      CALL add(IO_methane, 'box_CO2_out_wet', methane%box_CO2_out_wet, longname= 'box CO2_wet flux', &
               units='mol(CO2) m-2(grid box) s-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=126, &
               lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CO2_out_wet_acc', methane%box_CO2_out_wet_acc, longname= 'CO2_wet flux (avg)', &
               units='mol(CO2) m-2(grid box) s-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=127, laccu=.TRUE., &
               contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      CALL add(IO_methane, 'box_O2_out_wet', methane%box_O2_out_wet, longname= 'box O2_wet flux', &
               units='mol(O2) m-2(grid box) s-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=128, &
               lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_O2_out_wet_acc', methane%box_O2_out_wet_acc, longname= 'O2_wet flux (avg)', &
               units='mol(O2) m-2(grid box) s-1', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=129, laccu=.TRUE., &
               contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)

      IF (methane_options%debug_output) THEN
        CALL add(IO_methane,'wt_layer', methane%wt_layer, longname= 'Water table layer', &
                units='layer', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=130, contnorest=.TRUE., lpost=debug_output, &
                lrerun=.FALSE., lmiss=.TRUE., missval=missing_value)
        CALL add(IO_methane,'bedrock_layer', methane%bedrock_layer, longname= 'layer above bedrock', &
                units='layer', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=131, contnorest=.TRUE., lpost=debug_output, &
                lrerun=.FALSE., lmiss=.TRUE., missval=missing_value)
        CALL add(IO_methane, 'mask_wet', methane%mask_wet, longname= 'calculation mask, wet part', &
                units='', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=132, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
        CALL add(IO_methane, 'mask_dry', methane%mask_dry, longname= 'calculation mask, dry part', &
                units='', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=133, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
        CALL add(IO_methane, 'meth_landpoint', methane%meth_landpoint, longname= 'methane landpoint', &
                units='', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=134, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)

        CALL add(IO_methane, 'tillers', methane%tillers, longname= 'tillers', &
                units='', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=136, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
      END IF  ! methane_options%debug_output
      
      IF (methane_options%tile_level_output) THEN
        CALL add(IO_methane,'effective_layer_volume', methane%effective_layer_volume, longname= 'effective layer volume', &
                units='m3', ldims=dim2p, gdims=dim2, dimnames=dim2n, code=137, contnorest=.TRUE., lpost=tile_output, &
                lmiss=.TRUE., lrerun=.FALSE., missval=missing_value, leveltype=SOILLEV)
      END IF  ! methane_options%tile_level_output
      
      IF (methane_options%debug_output) THEN
        CALL add(IO_methane, 'areaWeightingFactor', methane%areaWeightingFactor, longname= 'weighting factor for box aggregation', &
                units='', ldims=dim3p, gdims=dim3, dimnames=dim3n, code=138, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
        CALL add(IO_methane, 'tile_weight', methane%tile_weight, longname= 'tile weight in aggregation', &
                units='', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=139, leveltype=TILES, &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
      END IF   ! methane_options%debug_output
      
      ! code number gap 146-149
      CALL add(IO_methane, 'box_CH4_out_fire', methane%box_CH4_out_fire, longname= 'box CH4 flux from fire',               &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=150,                     &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CH4_out_fire_acc', methane%box_CH4_out_fire_acc, longname= 'box CH4 flux from fire (avg)', &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=151, laccu=.TRUE.,       &
                contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
              
      CALL add(IO_methane, 'CH4_out_termite', methane%CH4_out_termite, longname= 'CH4 flux from termites',                 &
                units='mol(CH4) m-2(canopy) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=152,                       &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CH4_out_termite', methane%box_CH4_out_termite, longname= 'box CH4 flux from termites',     &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=153,                     &
                contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CH4_out_termite_acc', methane%box_CH4_out_termite_acc, longname= 'CH4 flux from termites (avg)', &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=154, laccu=.TRUE., &
                contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      
      CALL add(IO_methane, 'gpp_prev_year', methane%gpp_prev_year, longname= 'GPP previous year', &
              units='mol(C) m-2(canopy) yr-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=155, &
              lrerun=.TRUE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
      CALL add(IO_methane, 'gpp_ann_sum', methane%gpp_ann_sum, longname= 'GPP sum current year', &
              units='mol(C) m-2(canopy)', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=156, &
              lrerun=.TRUE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)
      CALL add(IO_methane, 'termite_biomass', methane%termite_biomass, longname= 'Termite biomass', &
              units='g m-2(canopy)', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=157, &
              lrerun=.FALSE., lmiss=.TRUE., missval=missing_value, lpost=debug_output)

      CALL add(IO_methane, 'CH4_out_herbivore', methane%CH4_out_herbivore, longname= 'CH4 flux from herbivores',                 &
                units='mol(CH4) m-2(canopy) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=170,                       &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CH4_out_herbivore', methane%box_CH4_out_herbivore, longname= 'box CH4 flux from herbivores',     &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=171,                     &
                contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=inst_output)
      CALL add(IO_methane, 'box_CH4_out_herbivore_acc', methane%box_CH4_out_herbivore_acc, longname= 'CH4 flux from herbivores (avg)', &
                units='mol(CH4) m-2(grid box) s-1', ldims=dim5p, gdims=dim5, dimnames=dim5n, code=172, laccu=.TRUE., &
                contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
              
      
      IF (methane_options%tile_level_output) THEN
        CALL add(IO_methane,'D_used', methane%D_used, longname= 'Diffusivity used CO2', &
                units='m3', ldims=dim2p, gdims=dim2, dimnames=dim2n, code=160, contnorest=.TRUE., lpost=tile_output, &
                lmiss=.TRUE., lrerun=.FALSE., missval=missing_value, leveltype=SOILLEV)
      END IF
      
      CALL add(IO_methane, 'CH4_conc_air', methane%CH4_conc_air, longname= 'CH4 concentration in air', &
               units='mol(CH4) m-3', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=161,                & 
               lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      CALL add(IO_methane, 'CO2_conc_air', methane%CO2_conc_air, longname= 'CO2 concentration in air', &
               units='mol(CO2) m-3', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=162,                &
               lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)

      IF (methane_options%GHG_from_atm) THEN
        CALL add(IO_methane, 'CH4_mmr_air', methane%CH4_mmr_air, longname= 'CH4 mmr in air',           &
                units='kg(CH4) kg(air)-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=163,          & 
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
        CALL add(IO_methane, 'CO2_mmr_air', methane%CO2_mmr_air, longname= 'CO2 mmr in air',           &
                units='kg(CO2) kg(air)-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=164,          &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      END IF  ! methane_options%GHG_from_atm
              
      CALL add(IO_methane, 'fire_em_NO', methane%fire_em_NO, longname= 'NO emissions from fire',         &
                units='kg m-2(grid box) s-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=165,         &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      CALL add(IO_methane, 'fire_em_CO', methane%fire_em_CO, longname= 'CO emissions from fire',         &
                units='kg m-2(grid box) s-1', ldims=dim1p, gdims=dim1, dimnames=dim1n, code=166,         &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)
      CALL add(IO_methane, 'fire_em_isoprene', methane%fire_em_iso, longname= 'Isoprene emissions from fire',      &
                units='10-3 kg m-2(grid box) s-1', bits=24, ldims=dim1p, gdims=dim1, dimnames=dim1n, code=167,     &
                lrerun=.FALSE., contnorest=.TRUE., lmiss=.TRUE., missval=missing_value, lpost=.TRUE.)

      methane%CH4_air_conc = 0.00007706281_dp ! [mol m-3] 
      ! 0.0001885375% 03.2012
      ! http://agage.eas.gatech.edu/data.htm MHD-gcmd.mon
      ! 0.0001885375 / 24.465433 * 10
      ! 24.465433dm^3/mol molar volume at 1atm=101.325kPa, 25°C
      methane%O2_air_conc  = 8.561467_dp ! [mol m-3] 20.946% 2012
      ! 20.946       / 24.465433 * 10
      methane%CO2_air_conc = 0.016349598227_dp ! [mol m-3], 400 ppm = 0.04%
      ! 0.04   / 24.465433 * 10

      IF (methane_options%vmr_namelist) THEN
        methane%CH4_air_conc = concentration_vmr_2_mol_m3(methane_options%ch4_vmr)
        methane%CO2_air_conc = concentration_vmr_2_mol_m3(methane_options%co2_vmr)
      END IF

      methane%CH4_total_out_dry        = 0._dp
      methane%CO2_total_out_dry        = 0._dp
      methane%CH4_total_out_wet        = 0._dp
      methane%CO2_total_out_wet        = 0._dp
      
      IF (methane_options%outflux_output) THEN
        methane%CH4_prod_out_dry         = 0._dp
        methane%CH4_oxid_out_dry         = 0._dp
        methane%CH4_diff_out_dry         = 0._dp
        methane%CH4_plant_out_dry        = 0._dp
        methane%CH4_total_initial_dry    = 0._dp
        methane%CH4_total_final_dry      = 0._dp
        
        methane%CO2_prod_out_dry         = 0._dp
        methane%CO2_oxid_out_dry         = 0._dp
        methane%CO2_diff_out_dry         = 0._dp
        methane%CO2_plant_out_dry        = 0._dp
        methane%CO2_total_initial_dry    = 0._dp
        methane%CO2_total_final_dry      = 0._dp
        
        methane%O2_other_out_dry         = 0._dp
        methane%O2_oxid_out_dry          = 0._dp
        methane%O2_diff_out_dry          = 0._dp
        methane%O2_plant_out_dry         = 0._dp
        methane%O2_total_initial_dry     = 0._dp
        methane%O2_total_final_dry       = 0._dp
        
        methane%CH4_prod_out_wet         = 0._dp
        methane%CH4_oxid_out_wet         = 0._dp
        methane%CH4_ebul_out_wet         = 0._dp
        methane%CH4_diff_out_wet         = 0._dp
        methane%CH4_plant_out_wet        = 0._dp
        methane%CH4_total_initial_wet    = 0._dp
        methane%CH4_total_final_wet      = 0._dp
        
        methane%CO2_prod_out_wet         = 0._dp
        methane%CO2_oxid_out_wet         = 0._dp
        methane%CO2_diff_out_wet         = 0._dp
        methane%CO2_plant_out_wet        = 0._dp
        methane%CO2_total_initial_wet    = 0._dp
        methane%CO2_total_final_wet      = 0._dp
        
        methane%O2_other_out_wet         = 0._dp
        methane%O2_oxid_out_wet          = 0._dp
        methane%O2_diff_out_wet          = 0._dp
        methane%O2_plant_out_wet         = 0._dp
        methane%O2_total_initial_wet     = 0._dp
        methane%O2_total_final_wet       = 0._dp
      END IF   ! methane_options%outflux_output
      
      methane%CH4_wet                  = 0._dp
      methane%CO2_wet                  = 0._dp
      methane%O2_wet                   = 0._dp
      methane%CH4_dry                  = 0._dp
      methane%CO2_dry                  = 0._dp
      methane%O2_dry                   = 0._dp
      methane%CH4_out_net              = 0._dp
      methane%CO2_out_net              = 0._dp
      methane%CH4_out_dry              = 0._dp
      methane%CO2_out_dry              = 0._dp
      methane%CH4_out_wet              = 0._dp
      methane%CO2_out_wet              = 0._dp
      methane%inun_frac_pre            = 0._dp
      
      methane%gpp_prev_year            = 0._dp
      methane%gpp_ann_sum              = 0._dp
      methane%termite_biomass          = 0._dp
      
      CALL message('init_methane','methane initialised')

    END SUBROUTINE init_methane


! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE update_methane(nland, surface_air_pressure, &
                              soil_respiration, &
                              soil_respiration_anoxic, &
                              acrotelm_height_ag, &
                              acrotelm_height_bg, &
                              catotelm_height, &
                              Cpool_green, &
                              lai, laiMax, &
                              phenoType, c4Flag, is_vegetation, &
                              is_peatland, cover_fract, cover_type, &
                              veg_fract_correction, veg_ratio_max, &
                              CO2_mmr, CH4_mmr, &
                              soil_param, soil, &
                              wt_peat, inun_frac, methane, &
                              wt_inun_frac)
      ! Calculates methane concentration profiles in the soil,
      !        and methane fluxes from the soil to the atmosphere.
      ! Processes incorporated are production, oxidation and
      ! transport by diffusion, ebullition and plants.
      ! Therefore oxygen is also included.

      ! Note with regard to fluxes (GAS _out_net_ PROCESS): Fluxes are defined such that 
      ! any flux INTO the soil or increasing total pool size is defined positive

      USE mo_jsbach_grid,      ONLY: kstart, kend           ! first and last value of kindex() 
                                                            ! (index of first element of block in processor domain)
      USE mo_jsbach,           ONLY: debug, new_day         ! .TRUE. if start of new day
      USE mo_time_control,     ONLY: lstart, lresume
      USE mo_utils,            ONLY: average_tiles
      USE mo_jsbach_constants, ONLY: molarMassCO2_kg, molarMassCH4_kg, molarMassDryAir_kg
      
      IMPLICIT NONE

      TYPE(soil_param_type), INTENT(in) :: soil_param
      TYPE(soil_type),       INTENT(in) :: soil
      
      INTEGER,  INTENT(in) :: nland                                         ! number of land points
      REAL(dp), INTENT(in) :: surface_air_pressure(nland)                   ! [Pa] = [N/m^2] = [1/101325 atm] surface air pressure
      REAL(dp), INTENT(in) :: soil_respiration(nland, soil%ntiles)          ! [mol m-2 s-1]    aerobic respiration rate (CO2)
      REAL(dp), INTENT(in) :: soil_respiration_anoxic(nland, soil%ntiles)   ! [mol m-2 s-1]    anaerobic respiration rate (CO2 + CH4)
      REAL(dp), INTENT(in) :: acrotelm_height_ag(nland, soil%ntiles)        ! [m] acrotelm height from ag litter
      REAL(dp), INTENT(in) :: acrotelm_height_bg(nland, soil%ntiles)        ! [m] acrotelm height from bg litter
      REAL(dp), INTENT(in) :: catotelm_height(nland, soil%ntiles)           ! [m] catotelm height 
      REAL(dp), INTENT(in) :: Cpool_green(nland, soil%ntiles)               ! C-pool for leaves, fine roots, vegetative organs and other living parts 
                                                                            ! of vegetation [mol(C)/m^2(canopy)]
      REAL(dp), INTENT(in) :: lai(nland,soil%ntiles)                        ! [-] leaf area index
      REAL(dp), INTENT(in) :: laiMax(nland,soil%ntiles)                     ! [-] maximum leaf area index
      REAL(dp), INTENT(in) :: wt_peat(nland,soil%ntiles)                    ! [m] position of the water table, positive above surface
      REAL(dp), INTENT(in) :: inun_frac(nland,soil%ntiles)                  ! [-] grid cell inundated fraction
      REAL(dp), INTENT(in) :: wt_inun_frac(nland)                           ! [m] water table in grid cell inundated fraction
      REAL(dp), INTENT(in) :: CO2_mmr(nland)                                ! [kg(CO2)/kg(air)] CO2 mass mixing ratio
      REAL(dp), INTENT(in) :: CH4_mmr(nland)                                ! [kg(CH4)/kg(air)] CH4 mass mixing ratio
      REAL(dp), INTENT(in) :: cover_fract(nland,soil%ntiles)                ! tile cover fraction
      INTEGER,  INTENT(in) :: cover_type(nland,soil%ntiles)                 ! tile cover type
      REAL(dp), INTENT(in) :: veg_fract_correction(nland,soil%ntiles)       ! correction factor for area weighting factor to convert to grid cell average
      REAL(dp), INTENT(in) :: veg_ratio_max(nland)                          ! veg_ratio_max, needed for area weighting factor to convert to grid cell average
      INTEGER,  INTENT(in) :: phenoType(nland,soil%ntiles)                  ! phenology type (only for natural vegetation): none 0
                                                                            ! evergreen 1 summergreen 2 raingreen 3 grasses 4 crops 5
      LOGICAL,  INTENT(in) :: c4Flag(nland,soil%ntiles)                     ! photosynthetic pathway: C4=.TRUE. or C3=.FALSE.
      LOGICAL,  INTENT(in) :: is_vegetation(nland,soil%ntiles)              ! flag, that is true, if tile is covered by vegetation
      LOGICAL,  INTENT(in) :: is_peatland(nland,soil%ntiles)                ! flag, that is true, if cell is a peatland grid cell

      TYPE(methane_type), INTENT(inout) :: methane                          ! structure with methane specific variables

      ! Locals
      INTEGER  :: iLand, iLand_k, iLayer, iTile, iWetness                   ! counters over all land points, layers, tiles, wetness states
      
      ! soil layering structure
      INTEGER  :: mxlay_above_wt                                ! soil layer number above water table
      INTEGER  :: mxlay_acrotelm                                ! soil layer number for bottom of acrotelm
      INTEGER  :: mxlay_above_rock                              ! soil layer number above bedrock

      ! soil pore structure
      REAL(dp), DIMENSION(soil%nsoil) :: relative_porevol       ! [-] relative pore volume in layer
      REAL(dp), DIMENSION(soil%nsoil) :: relative_moist         ! [-] relative moisture content of layer
      REAL(dp), DIMENSION(soil%nsoil) :: relative_pore_air      ! [-] relative pore air content in layer
      REAL(dp), DIMENSION(soil%nsoil) :: relative_ice           ! [-] relative ice content of layer
      REAL(dp), DIMENSION(soil%nsoil) :: relative_pore_moist    ! [-] relative pore moisture in layer
      
      ! conversion factors
      REAL(dp), DIMENSION(soil%nsoil) :: dens2conc              ! conversion factor from density to concentration
      REAL(dp), DIMENSION(soil%nsoil) :: conc2dens              ! conversion factor from concentration to density
      
      ! GAS densities
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_dens               ! [mol m-2] CH4 density in layer
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_dens               ! [mol m-2] CO2 density in layer
      REAL(dp), DIMENSION(soil%nsoil) :: O2_dens                ! [mol m-2] O2 density in layer
      REAL(dp), DIMENSION(soil%nsoil) :: O2_dens_old            ! [mol m-2] O2 density in layer
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_dens_dry           ! [mol m-2] CH4 density in layer, dry part
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_dens_dry           ! [mol m-2] CO2 density in layer, dry part
      REAL(dp), DIMENSION(soil%nsoil) :: O2_dens_dry            ! [mol m-2] O2 density in layer, dry part
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_dens_wet           ! [mol m-2] CH4 density in layer, wet part
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_dens_wet           ! [mol m-2] CO2 density in layer, wet part
      REAL(dp), DIMENSION(soil%nsoil) :: O2_dens_wet            ! [mol m-2] O2 density in layer, wet part
      
      ! GAS concentrations
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_conc               ! [mol m-3] CH4 concentration in ice free pore space of layer
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_conc               ! [mol m-3] CO2 concentration in ice free pore space of layer
      REAL(dp), DIMENSION(soil%nsoil) :: O2_conc                ! [mol m-3]  O2 concentration in ice free pore space of layer
      
      ! C production -> input from decomposition
      REAL(dp), DIMENSION(nland, soil%ntiles) :: OxicDecompCarbon   ! [mol m-2 timestep-1] carbon aerobic decomposition
      REAL(dp), DIMENSION(nland, soil%ntiles) :: AnoxDecompCarbon   ! [mol m-2 timestep-1] carbon anaerobic decomposition
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_Prod               ! [mol m-2 timestep-1] CH4 density produced
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_Prod               ! [mol m-2 timestep-1] CO2 density from production
      REAL(dp), DIMENSION(soil%nsoil) :: O2_Prod                ! [mol m-2 timestep-1] O2 density from uptake during production 
      REAL(dp)                        :: CH4_Prod_ratio         ! [1] ratio of CH4 to total anoxic production
      
      ! Physical conditions
      REAL(dp), DIMENSION(nland,soil%nsoil) :: Tsoil            ! [K] Soil temperature
      REAL(dp), DIMENSION(nland,soil%nsoil) :: ice_content      ! [-] Soil ice content
      REAL(dp), DIMENSION(nland)            :: rel_soil_moist   ! [-] relative soil moisture
      
      ! Diffusion coefficients
      REAL(dp), DIMENSION(soil%nsoil) :: D_CH4                  ! [m2 s-1] diffusivity of CH4 on layers 
      REAL(dp), DIMENSION(soil%nsoil) :: D_CO2                  ! [m2 s-1] diffusivity of CO2 on layers
      REAL(dp), DIMENSION(soil%nsoil) :: D_O2                   ! [m2 s-1] diffusivity of O2 on layers
      REAL(dp)                        :: D_CH4_surface          ! [m2 s-1] diffusivity of CH4 in surface air
      REAL(dp)                        :: D_CO2_surface          ! [m2 s-1] diffusivity of CO2 in surface air
      REAL(dp)                        :: D_O2_surface           ! [m2 s-1] diffusivity of O2 in surface air
      
      ! Diffusion output
      REAL(dp)                              :: CH4_Diff         ! [mol m-2 timestep-1] diffusive CH4 flux
      REAL(dp)                              :: CO2_Diff         ! [mol m-2 timestep-1] diffusive CO2 flux
      REAL(dp)                              :: O2_Diff          ! [mol m-2 timestep-1] diffusive O2 flux
      
      ! layering variables
      REAL(dp), DIMENSION(soil%nsoil) :: Dz                     ! [m] layer thickness 
      REAL(dp), DIMENSION(soil%nsoil) :: layer_thick            ! [m] layer thickness 
      REAL(dp), DIMENSION(soil%nsoil) :: layer_depth            ! [m] layer depth 
      
      ! Plant transport variables / output
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_Plant              ! [mol m-2 timestep-1] CH4 density per layer plant transport
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_Plant              ! [mol m-2 timestep-1] CO2 density per layer plant transport
      REAL(dp), DIMENSION(soil%nsoil) :: O2_Plant               ! [mol m-2 timestep-1] O2 density per layer plant transport
      
      ! oxidation
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_Oxid               ! [mol m-2 timestep-1] CH4 density oxidised per layer
      REAL(dp), DIMENSION(soil%nsoil) :: CO2_Oxid               ! [mol m-2 timestep-1] CO2 density from oxidation of CH4 per layer
      REAL(dp), DIMENSION(soil%nsoil) :: O2_Oxid                ! [mol m-2 timestep-1] O2 density used in oxidation of CH4 per layer
      REAL(dp), DIMENSION(soil%nsoil) :: O2_Other               ! [mol m-2 timestep-1] O2 density used in oxidation of others per layer
      
      REAL(dp), DIMENSION(soil%nsoil) :: D_used

      ! Ebullition variables
      REAL(dp), DIMENSION(soil%nsoil) :: CH4_Ebul               ! [mol m-2 timestep-1] CH4 density per layer transported by ebullition
      
      ! tile GLOBAL fields (exist on soil%ntiles)
      ! tile weight, water table
      REAL(dp), DIMENSION(soil%ntiles)              :: tile_weight    ! weight of tile in aggregation
      REAL(dp), DIMENSION(soil%ntiles)              :: water_table    ! tile water table: wt_inun_frac for non-peatland tiles, wt_peat for peatland tile
      
      ! Plant transport parameters
      REAL(dp), DIMENSION(soil%nsoil,soil%ntiles)   :: root_dist      ! root distribution in each layer
      REAL(dp), DIMENSION(soil%ntiles)              :: tillers        ! number of tillers
      REAL(dp), DIMENSION(soil%nsoil,soil%ntiles)   :: tiller_area    ! area of tillers corresponding to the root fraction in each layer
      
      ! tile LOCAL fields (exist on actual number of methane tiles)
      ! area weighting factor, water table
      REAL(dp), DIMENSION(nland,methane%mtiles)        :: areaWeightingFactor   ! area weighting factor to convert to grid cell average
      REAL(dp), DIMENSION(methane%mtiles)              :: water_table_loc
      
      ! Plant transport parameters
      REAL(dp), DIMENSION(soil%nsoil,methane%mtiles)   :: root_dist_loc   ! root distribution in each layer
      REAL(dp), DIMENSION(methane%mtiles)              :: tillers_loc     ! number of tillers
      REAL(dp), DIMENSION(soil%nsoil,methane%mtiles)   :: tiller_area_loc ! area of tillers corresponding to the root fraction in each layer
      
      ! masks
      LOGICAL, DIMENSION(methane%mtiles)               :: vegmask_loc     ! vegetation mask (is_vegetation)
      LOGICAL, DIMENSION(methane%mtiles)               :: peatmask_loc    ! peatland mask (is_peatland)
      REAL(dp), DIMENSION(methane%mtiles)              :: veg_corr        ! vegetation correction (veg_fract_correction)
      INTEGER                                          :: peatland_tile
      
      ! decomposition input
      REAL(dp), DIMENSION(methane%mtiles)              :: OxicDecompCarbon_loc  ! [mol m-2 timestep-1] carbon aerobic decomposition
      REAL(dp), DIMENSION(methane%mtiles)              :: AnoxDecompCarbon_loc  ! [mol m-2 timestep-1] carbon anaerobic decomposition
      
      
      ! other stuff
      REAL(dp)                        :: total_C_flux
      REAL(dp)                        :: conv
      REAL(dp)                        :: test
      REAL(dp)                        :: Ctest
      REAL(dp)                        :: acro_height
      REAL(dp)                        :: inun_frac_loc
      REAL(dp)                        :: stored_C_sum
      
      INTEGER                         :: iWetness_start, iWetness_end
      
      LOGICAL  :: permafrost_flag
      LOGICAL  :: compute_flag
     
      INTEGER  :: output_wetness
      
      peatland_tile = 0
      
      ! tile level output setup: output dry tile, unless methane_options%wet_tile_output = TRUE
      output_wetness = 1
      IF (methane_options%wet_tile_output) THEN
        ! set to wet tile in this case
        output_wetness = 2
      END IF
      
      IF (debug) CALL message('update_methane', 'starts')

      permafrost_flag = .TRUE.
      IF (.NOT. ASSOCIATED(soil%thaw_depth)) THEN
        permafrost_flag = .FALSE.
      END IF
     
      IF (methane_options%GHG_from_atm) THEN
        methane%CH4_mmr_air(kstart:kend) = CH4_mmr(1:nland)
        methane%CO2_mmr_air(kstart:kend) = CO2_mmr(1:nland)
        methane%CH4_conc_air(kstart:kend) = concentration_mmr_2_mol_m3(nland,CH4_mmr(1:nland),molarMassCH4_kg)
        methane%CO2_conc_air(kstart:kend) = concentration_mmr_2_mol_m3(nland,CO2_mmr(1:nland),molarMassCO2_kg)
      ELSE
        methane%CH4_conc_air(kstart:kend) = methane%CH4_air_conc
        methane%CO2_conc_air(kstart:kend) = methane%CO2_air_conc
      END IF

      ! determine carbon input during time step for oxic and anoxic conditions
      ! convert respiration flux, respiration is defined NEGATIVE
      OxicDecompCarbon = -soil_respiration * delta_time
      AnoxDecompCarbon = -soil_respiration_anoxic * delta_time
      
      ! set up layer thickness and depth vectors
      layer_thick = soil%cdel
      layer_depth = soil%clev
      
      ! set up Dz vector (distance between soil layer mid points)
      Dz(1) = soil%cmid(1)
      DO iLayer = 2,soil%nsoil
        Dz(iLayer) = soil%cmid(iLayer)-soil%cmid(iLayer-1)
      END DO
      
      ! average soil temperature, ice content, relative moisture over tiles
      DO iLayer = 1,soil%nsoil
        CALL average_tiles(soil%soil_temperature(kstart:kend,iLayer,:),is_vegetation(1:nland,:),&
                           cover_fract(1:nland,:),Tsoil(1:nland,iLayer))
        CALL average_tiles(soil%ice_content(kstart:kend,iLayer,:),is_vegetation(1:nland,:),&
                           cover_fract(1:nland,:),ice_content(1:nland,iLayer))
      END DO
      CALL average_tiles(soil%relative_moisture(kstart:kend,:),is_vegetation(1:nland,:),&
                         cover_fract(1:nland,:),rel_soil_moist)
      
! -----------------------------------------------------------------------------------------------------------
      ! consider all grid points
      DO iLand = 1, nland
        iLand_k = iLand - 1 + kstart
        
        ! set up methane tiling: aggregate over tiles (excluding peatland) for aggregated tiles, copy for non-aggregated
        ! initial setup
        CALL aggregate_canopy_setup(soil%ntiles, methane%mtiles, veg_fract_correction(iLand,:), &
                              cover_fract(iLand,:), is_vegetation(iLand,:), is_peatland(iLand,:), peatland_tile, &
                              vegmask_loc, peatmask_loc, tile_weight, veg_corr)
        ! aggregation of decomposed carbon
        CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight, &
                              OxicDecompCarbon(iLand,:), OxicDecompCarbon_loc)
        CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight, &
                              AnoxDecompCarbon(iLand,:), AnoxDecompCarbon_loc)
        
        ! set up area weighting factor for box_* output
        areaWeightingFactor(iLand,:) = veg_ratio_max(iLand) * veg_corr
        
        ! determine maximum layer above bedrock
        mxlay_above_rock = find_bedrock_layer(soil%nsoil, layer_depth, soil_param%SoilDepth(iLand_k))
        
        ! determine root distribution, plant transport parameters, water table for all tiles
        DO iTile = 1,soil%ntiles
          IF (methane_options%debug_output) THEN
            methane%tile_weight(iLand_k,iTile) = tile_weight(iTile)
          END IF
          IF (is_vegetation(iLand,iTile)) THEN
            ! determine root distribution over layers
            CALL determine_root_dist(mxlay_above_rock, layer_thick, layer_depth, cover_type(iLand,iTile), root_dist(:,iTile))
                  
            ! set up plant transport parameters
            CALL plant_setup(mxlay_above_rock, iWetness, lai(iLand,iTile), laiMax(iLand,iTile), Cpool_green(iLand,iTile), &
                              cover_type(iLand,iTile), root_dist(:,iTile), tillers(iTile), tiller_area(:,iTile))
          ELSE
            root_dist(:,iTile) = 0._dp
            tillers(iTile) = 0._dp
            tiller_area(:,iTile) = 0._dp
          END IF
          
          !  set up water table for all tiles
          water_table(iTile) = wt_inun_frac(iLand)
          IF (is_peatland(iLand,iTile)) THEN
              water_table(iTile) = wt_peat(iLand, iTile)
              peatland_tile = iTile
          END IF
        END DO
        
        ! aggregate over tiles, if needed: plant transport parameters, root distribution, water table
        CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight,   &
                              tillers, tillers_loc)
        DO iLayer = 1,mxlay_above_rock
          CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight, &
                                tiller_area(iLayer,:),tiller_area_loc(iLayer,:))
          CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight, &
                                root_dist(iLayer,:), root_dist_loc(iLayer,:))
        END DO
        CALL aggregate_canopy(soil%ntiles, methane%mtiles, is_peatland(iLand,:), tile_weight,   &
                              water_table, water_table_loc)
        
        ! loop over tiles (either all or methane tiles) for methane transport
        DO iTile = 1, methane%mtiles
          IF (vegmask_loc(iTile)) THEN
            ! compute flag required for non-aggregated 
            compute_flag = .TRUE.
            
            IF (methane_options%debug_output) THEN
              ! save tile diagnostic variables
              methane%meth_landpoint(iLand_k,iTile) = iLand_k
              methane%mask_wet(iLand_k,iTile) = 0._dp
              methane%mask_dry(iLand_k,iTile) = 0._dp
              methane%bedrock_layer(iLand_k,iTile) = dble(mxlay_above_rock)
              methane%areaWeightingFactor(iLand_k,iTile) = areaWeightingFactor(iLand,iTile)
            END IF   ! methane_options%debug_output
            
            ! methane transport code only makes sense, if soil is deep enough  -> set in minimum_no_layers
            IF (mxlay_above_rock .LT. minimum_no_layers) THEN
              compute_flag = .FALSE.
              ! add produced C to output fluxes directly to insure conservation
              methane%CH4_out_net(iLand_k,iTile) = 0._dp
              methane%CH4_out_dry(iLand_k,iTile) = 0._dp
              methane%CH4_out_wet(iLand_k,iTile) = 0._dp
              methane%CO2_out_net(iLand_k,iTile) = -(OxicDecompCarbon_loc(iTile) + AnoxDecompCarbon_loc(iTile)) / delta_time
              methane%CO2_out_dry(iLand_k,iTile) = methane%CO2_out_net(iLand_k,iTile)
              methane%CO2_out_wet(iLand_k,iTile) = 0._dp
            END IF
            
! -----------------------------------------------------------------------------------------------------------
            ! SMALL TILES: non-aggregated case
            ! methane transport code only makes sense, if cover fraction is large enough,
            ! -> set in methane_options%tile_threshold
            IF (areaWeightingFactor(iLand,iTile) .LT. methane_options%tile_threshold) THEN
              compute_flag = .FALSE.
              ! if tile is very small add produced C to CO2 output flux directly to insure conservation
              methane%CH4_out_net(iLand_k,iTile) = 0._dp
              methane%CH4_out_dry(iLand_k,iTile) = 0._dp
              methane%CH4_out_wet(iLand_k,iTile) = 0._dp
              methane%CO2_out_net(iLand_k,iTile) = -(OxicDecompCarbon_loc(iTile) + AnoxDecompCarbon_loc(iTile)) / delta_time
              
              ! flush stored C out and reset to insure conservation
              stored_C_sum = 0._dp
              IF (methane%inun_frac_pre(iLand_k,iTile) < 1._dp) THEN
                stored_C_sum = stored_C_sum + &
                               (SUM(methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile)) +   &
                                SUM(methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile))) *  &
                                (1._dp - methane%inun_frac_pre(iLand_k,iTile))
              END IF
              IF (methane%inun_frac_pre(iLand_k,iTile) > 0._dp) THEN
                stored_C_sum = stored_C_sum + &
                               (SUM(methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile)) +   &
                                SUM(methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile))) *  &
                                methane%inun_frac_pre(iLand_k,iTile)
              END IF
                              
              methane%CO2_out_net(iLand_k,iTile) = methane%CO2_out_net(iLand_k,iTile) + (stored_C_sum / delta_time)
              methane%CO2_out_dry(iLand_k,iTile) = methane%CO2_out_net(iLand_k,iTile)
              methane%CO2_out_wet(iLand_k,iTile) = 0._dp
              
              methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile)  = 0._dp
              methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile)  = 0._dp
            END IF
        
! -----------------------------------------------------------------------------------------------------------
            ! compute flag is TRUE if soil is deep enough and tile is large enough
            IF (compute_flag) THEN
            
              ! local inundated fraction
              inun_frac_loc = inun_frac(iLand,iTile)      ! inundated fraction considered
                                                          ! set to one, if peatland
                                                          ! set to zero, if < min_inun_frac
              !  INITIALISATION OF GAS POOLS
              CALL init_gas_pools(mxlay_above_rock, peatmask_loc(iTile), iLand_k, iTile, inun_frac_loc, &
                                  methane, CH4_dens_dry, CO2_dens_dry, O2_dens_dry, &
                                  CH4_dens_wet, CO2_dens_wet, O2_dens_wet)
                                  
              ! setup for wetness loop: 
              ! For mineral soil ignore wet fraction, if inundated fraction too small (inun_frac_loc = 0)
              ! for organic soil or completely flooded grid cell ignore dry fraction
              iWetness_end = 1
              IF (inun_frac_loc > 0._dp) THEN
                iWetness_end = 2
              END IF
              iWetness_start = 2
              IF (inun_frac_loc < 1._dp) THEN
                iWetness_start = 1
              END IF
              
              ! wetness loop: iWetness = 1 -> dry part of tile, iWetness = 2 -> wet part
              DO iWetness = iWetness_start, iWetness_end
                ! setup of GAS density vectors, output mask
                IF (iWetness .EQ. 1) THEN
                  CH4_dens = CH4_dens_dry
                  CO2_dens = CO2_dens_dry
                  O2_dens = O2_dens_dry
                  IF (methane_options%debug_output) THEN
                    methane%mask_dry(iLand_k,iTile) = 1._dp
                  END IF
                ELSE
                  CH4_dens = CH4_dens_wet
                  CO2_dens = CO2_dens_wet
                  O2_dens = O2_dens_wet
                  IF (methane_options%debug_output) THEN
                    methane%mask_wet(iLand_k,iTile) = 1._dp
                  END IF
                END IF
                
        
! -----------------------------------------------------------------------------------------------------------
                ! SET UP SOIL COLUMN 
                ! -------------------
                
                ! set up acrotelm height (= 0 for mineral soil)
                acro_height = 0._dp
                IF (peatmask_loc(iTile)) THEN
                  acro_height = acrotelm_height_ag(iLand, peatland_tile)+acrotelm_height_bg(iLand, peatland_tile)
                END IF
              
                CALL soil_column_setup(soil%nsoil, mxlay_above_rock, permafrost_flag, peatmask_loc(iTile), layer_thick, &
                                        soil%cmid, layer_depth, soil_param%SoilDepth(iLand_k), soil_param%SoilPorosity(iLand_k), &
                                        water_table_loc(iTile), acro_height, iWetness, &
                                        soil%layer_moisture(iLand_k,:), ice_content(iLand,:), &
                                        relative_moist, relative_ice, relative_porevol, relative_pore_air, &
                                        relative_pore_moist, dens2conc, conc2dens, &
                                        mxlay_above_wt, mxlay_acrotelm)
                                        
                IF (methane_options%debug_output) THEN
                  ! write output
                  methane%wt_layer(iLand_k,iTile) = dble(mxlay_above_wt)
                END IF
          
                IF (methane_options%tile_level_output) THEN
                  ! tile level output
                  IF ((iTile .EQ. methane_options%tile_output_no) .AND. (iWetness .EQ. output_wetness)) THEN
                    methane%tile_CH4_initial(iLand_k,1:mxlay_above_rock) = CH4_dens(1:mxlay_above_rock)
                    methane%tile_CO2_initial(iLand_k,1:mxlay_above_rock) = CO2_dens(1:mxlay_above_rock)
                    methane%tile_O2_initial(iLand_k,1:mxlay_above_rock) = O2_dens(1:mxlay_above_rock)
                    methane%effective_layer_volume(iLand_k,1:mxlay_above_rock) = conc2dens(1:mxlay_above_rock)
                    methane%tile_root_dist(iLand_k,1:mxlay_above_rock) = root_dist_loc(1:mxlay_above_rock,iTile)
                  END IF
                END IF   ! methane_options%tile_level_output
                
                IF (methane_options%outflux_output) THEN
                  ! output total gas density
                  IF (iWetness .EQ. 1) THEN
                    methane%CH4_total_initial_dry(iLand_k,iTile) = SUM(CH4_dens(1:mxlay_above_rock))
                    methane%CO2_total_initial_dry(iLand_k,iTile) = SUM(CO2_dens(1:mxlay_above_rock))
                    methane%O2_total_initial_dry(iLand_k,iTile) = SUM(O2_dens(1:mxlay_above_rock))
                  ELSE
                    methane%CH4_total_initial_wet(iLand_k,iTile) = SUM(CH4_dens(1:mxlay_above_rock))
                    methane%CO2_total_initial_wet(iLand_k,iTile) = SUM(CO2_dens(1:mxlay_above_rock))
                    methane%O2_total_initial_wet(iLand_k,iTile) = SUM(O2_dens(1:mxlay_above_rock))
                  END IF
                END IF

! -----------------------------------------------------------------------------------------------------------
                ! TILE SETUP
                
                ! Calculate the diffusivities for each gas and for water
                ! and air once and then allocate it as necessary
                CALL diffusion_setup(mxlay_above_rock, mxlay_above_wt, soil_param%bclapp(iLand_k), &
                                      peatmask_loc(iTile), relative_pore_air, relative_porevol, Tsoil(iLand,:), &
                                      D_CH4, D_CO2, D_O2, D_CH4_surface, D_CO2_surface, D_O2_surface)
                                      
                IF (methane_options%debug_output) THEN
                  methane%tillers(iLand_k,iTile) = tillers(iTile)
                END IF   ! methane_options%debug_output
              
! -----------------------------------------------------------------------------------------------------------
                ! CH4 / CO2 PRODUCTION
! -----------------------------------------------------------------------------------------------------------

                IF (methane_options%outflux_output) THEN
                  ! production output
                  methane%oxic_prod_in(iLand_k,iTile) = OxicDecompCarbon_loc(iTile)
                  methane%anox_prod_in(iLand_k,iTile) = AnoxDecompCarbon_loc(iTile)
                END IF   ! methane_options%outflux_output
                
                ! CH4 / CO2 production
                CALL production(mxlay_above_rock, mxlay_above_wt, peatmask_loc(iTile), iWetness, root_dist_loc(:,iTile), &
                                  inun_frac_loc, Tsoil(iLand,:), OxicDecompCarbon_loc(iTile), AnoxDecompCarbon_loc(iTile), &
                                  CH4_Prod, CO2_Prod, O2_Prod, CH4_prod_ratio)
                
! -----------------------------------------------------------------------------------------------------------
!              GAS TRANSPORT
! -----------------------------------------------------------------------------------------------------------
                ! PLANT TRANSPORT
                
                ! PLANT TRANSPORT OF CH4
                CALL plant_transport(1, mxlay_above_rock, mxlay_above_wt, &
                                      Tsoil(iLand,:), layer_thick, layer_depth, relative_porevol, &
                                      dens2conc, conc2dens, tiller_area_loc(:,iTile), D_CH4_surface, &
                                      methane%CH4_conc_air(iLand_k), CH4_dens, CH4_Plant)

                ! PLANT TRANSPORT OF CO2
                CALL plant_transport(2, mxlay_above_rock, mxlay_above_wt, &
                                      Tsoil(iLand,:), layer_thick, layer_depth, relative_porevol, &
                                      dens2conc, conc2dens, tiller_area_loc(:,iTile), D_CO2_surface, &
                                      methane%CO2_conc_air(iLand_k), CO2_dens, CO2_Plant)

                ! PLANT TRANSPORT OF O2
                CALL plant_transport(3, mxlay_above_rock, mxlay_above_wt, &
                                      Tsoil(iLand,:), layer_thick, layer_depth, relative_porevol, &
                                      dens2conc, conc2dens, tiller_area_loc(:,iTile), D_O2_surface,   &
                                      methane%O2_air_conc, O2_dens, O2_Plant)
                                      
                ! -------------------------------------------------------------------------------------------
                ! EBULLITION OF CH4
                
                ! Ebullition only happens in wet part of cell
                IF (iWetness .EQ. 2) THEN
                  CALL ebullition(mxlay_above_rock, mxlay_above_wt, Tsoil(iLand,:), surface_air_pressure(iLand_k), &
                                  Dz, relative_porevol, peatmask_loc(iTile), water_table_loc(iTile), &
                                  dens2conc, conc2dens, CH4_dens, CH4_Ebul)
                ELSE
                  CH4_Ebul = 0.
                END IF
                
                ! -------------------------------------------------------------------------------------------
                ! OXIDATION OF CH4
                CALL oxidation_mm(mxlay_above_rock, rel_soil_moist(iLand), Tsoil(iLand,:), iWetness, CH4_dens, CO2_dens, O2_dens, &
                                  O2_Prod, CH4_Oxid, CO2_Oxid, O2_Oxid, O2_Other, dens2conc, conc2dens)

                ! -------------------------------------------------------------------------------------------
                ! REACTION-DIFFUSION OF ALL GASES
                ! ALSO: COMPETITION FOR CH4/O2
                CALL reaction_diffusion(mxlay_above_rock, mxlay_above_wt, Tsoil(iLand,:), &
                                        layer_thick, relative_porevol, dens2conc, conc2dens, &
                                        CH4_dens, CO2_dens, O2_dens, &
                                        CH4_Prod, CO2_Prod, CH4_Oxid, CO2_Oxid, O2_Other, O2_Oxid, &
                                        CH4_Ebul, CH4_Plant, CO2_Plant, O2_Plant, &
                                        D_CH4, D_CO2, D_O2, D_CH4_surface, D_CO2_surface, D_O2_surface, & 
                                        methane%CH4_conc_air(iLand_k), methane%CO2_conc_air(iLand_k), &
                                        methane%O2_air_conc, &
                                        CH4_Diff, CO2_Diff, O2_Diff, D_used)
                                        
                ! -------------------------------------------------------------------------------------------
                ! FLUX OUTPUT
                IF (methane_options%outflux_output) THEN
                  IF (iWetness .EQ. 1) THEN     ! dry part
                    ! production
                    methane%CH4_prod_out_dry(iLand_k,iTile) = SUM(CH4_Prod)
                    methane%CO2_prod_out_dry(iLand_k,iTile) = SUM(CO2_Prod)
                    methane%O2_prod_out_dry(iLand_k,iTile) = SUM(O2_Prod)
                    ! plant transport
                    methane%CH4_plant_out_dry(iLand_k,iTile) = SUM(CH4_Plant)
                    methane%CO2_plant_out_dry(iLand_k,iTile) = SUM(CO2_Plant)
                    methane%O2_plant_out_dry(iLand_k,iTile) = SUM(O2_Plant)
                    ! oxidation
                    methane%CH4_oxid_out_dry(iLand_k,iTile) = SUM(CH4_Oxid)
                    methane%CO2_oxid_out_dry(iLand_k,iTile) = SUM(CO2_Oxid)
                    methane%O2_oxid_out_dry(iLand_k,iTile) = SUM(O2_Oxid)
                    methane%O2_other_out_dry(iLand_k,iTile) = SUM(O2_Other)
                    ! diffusion and error
                    methane%CH4_diff_out_dry(iLand_k,iTile) = CH4_Diff
                    methane%CO2_diff_out_dry(iLand_k,iTile) = CO2_Diff
                    methane%O2_diff_out_dry(iLand_k,iTile) = O2_Diff
                  ELSE      ! wet part
                    ! production
                    methane%CH4_prod_out_wet(iLand_k,iTile) = SUM(CH4_Prod)
                    methane%CO2_prod_out_wet(iLand_k,iTile) = SUM(CO2_Prod)
                    methane%O2_prod_out_wet(iLand_k,iTile) = SUM(O2_Prod)
                    methane%CH4_prod_ratio_out_wet(iLand_k,iTile) = CH4_prod_ratio
                    ! plant transport
                    methane%CH4_plant_out_wet(iLand_k,iTile) = SUM(CH4_Plant)
                    methane%CO2_plant_out_wet(iLand_k,iTile) = SUM(CO2_Plant)
                    methane%O2_plant_out_wet(iLand_k,iTile) = SUM(O2_Plant)
                    ! ebullition
                    methane%CH4_ebul_out_wet(iLand_k,iTile) = SUM(CH4_Ebul)
                    ! oxidation
                    methane%CH4_oxid_out_wet(iLand_k,iTile) = SUM(CH4_Oxid)
                    methane%CO2_oxid_out_wet(iLand_k,iTile) = SUM(CO2_Oxid)
                    methane%O2_oxid_out_wet(iLand_k,iTile) = SUM(O2_Oxid)
                    methane%O2_other_out_wet(iLand_k,iTile) = SUM(O2_Other)
                    ! diffusion 
                    methane%CH4_diff_out_wet(iLand_k,iTile) = CH4_Diff
                    methane%CO2_diff_out_wet(iLand_k,iTile) = CO2_Diff
                    methane%O2_diff_out_wet(iLand_k,iTile) = O2_Diff
                  END IF
                END IF        ! methane_options%outflux_output

                ! -----------------------------------------------------------------------------------------------------------
                !         TILE LEVEL OUTPUT FLUXES
                ! -----------------------------------------------------------------------------------------------------------
                IF (methane_options%tile_level_output) THEN
                  IF ((iTile .EQ. methane_options%tile_output_no) .AND. (iWetness .EQ. output_wetness)) THEN
                    CH4_conc(1:mxlay_above_rock) = CH4_dens(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
                    CO2_conc(1:mxlay_above_rock) = CO2_dens(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
                    O2_conc(1:mxlay_above_rock)  = O2_dens(1:mxlay_above_rock)  * dens2conc(1:mxlay_above_rock)
                    
                    methane%tile_CH4(iLand_k,1:mxlay_above_rock) = CH4_dens(1:mxlay_above_rock)
                    methane%tile_CH4_conc(iLand_k,1:mxlay_above_rock) = CH4_conc(1:mxlay_above_rock)
                    methane%tile_CO2(iLand_k,1:mxlay_above_rock) = CO2_dens(1:mxlay_above_rock)
                    methane%tile_CO2_conc(iLand_k,1:mxlay_above_rock) = CO2_conc(1:mxlay_above_rock)
                    methane%tile_O2(iLand_k,1:mxlay_above_rock) = O2_dens(1:mxlay_above_rock)
                    methane%tile_O2_conc(iLand_k,1:mxlay_above_rock) = O2_conc(1:mxlay_above_rock)

                    methane%tile_CH4_plant(iLand_k,1:mxlay_above_rock) = CH4_Plant(1:mxlay_above_rock)
                    IF (iWetness .EQ. 2) THEN
                      methane%tile_CH4_ebul(iLand_k,1:mxlay_above_rock) = CH4_Ebul(1:mxlay_above_rock)
                    END IF
                    methane%tile_CO2_plant(iLand_k,1:mxlay_above_rock) = CO2_Plant(1:mxlay_above_rock)
                    methane%tile_O2_plant(iLand_k,1:mxlay_above_rock) = O2_Plant(1:mxlay_above_rock)

                    methane%tile_CH4_prod(iLand_k,1:mxlay_above_rock) = CH4_Prod(1:mxlay_above_rock)
                    methane%tile_CO2_prod(iLand_k,1:mxlay_above_rock) = CO2_Prod(1:mxlay_above_rock)

                    methane%tile_CH4_oxid(iLand_k,1:mxlay_above_rock) = CH4_Oxid(1:mxlay_above_rock)
                    methane%tile_CO2_oxid(iLand_k,1:mxlay_above_rock) = CO2_Oxid(1:mxlay_above_rock)
                    methane%tile_O2_oxid(iLand_k,1:mxlay_above_rock)  = O2_Oxid(1:mxlay_above_rock)
                    methane%tile_O2_other(iLand_k,1:mxlay_above_rock) = O2_Other(1:mxlay_above_rock)
                    methane%D_used(iLand_k,1:mxlay_above_rock) = D_used(1:mxlay_above_rock)
                  END IF  ! tile_output_no for output
                END IF   ! methane_options%tile_level_output
                
! -----------------------------------------------------------------------------------------------------------
!       TOTAL FLUXES AND AMOUNTS
! -----------------------------------------------------------------------------------------------------------
                IF (iWetness .EQ. 1) THEN
                  ! total output fluxes
                  methane%CH4_total_out_dry(iLand_k,iTile) = CH4_Diff + SUM(CH4_Plant)
                  methane%CO2_total_out_dry(iLand_k,iTile) = CO2_Diff + SUM(CO2_Plant)
                  methane%O2_total_out_dry(iLand_k,iTile) = O2_Diff + SUM(O2_Plant)
                ELSE
                  ! total output fluxes
                  methane%CH4_total_out_wet(iLand_k,iTile) = CH4_Diff + SUM(CH4_Plant) + SUM(CH4_Ebul)
                  methane%CO2_total_out_wet(iLand_k,iTile) = CO2_Diff + SUM(CO2_Plant)
                  methane%O2_total_out_wet(iLand_k,iTile) = O2_Diff + SUM(O2_Plant)
                END IF
                IF (methane_options%outflux_output) THEN
                  IF (iWetness .EQ. 1) THEN
                    ! output total gas density
                    methane%CH4_total_final_dry(iLand_k,iTile) = SUM(CH4_dens(1:mxlay_above_rock))
                    methane%CO2_total_final_dry(iLand_k,iTile) = SUM(CO2_dens(1:mxlay_above_rock))
                    methane%O2_total_final_dry(iLand_k,iTile) = SUM(O2_dens(1:mxlay_above_rock))
                  ELSE
                    ! output total gas density
                    methane%CH4_total_final_wet(iLand_k,iTile) = SUM(CH4_dens(1:mxlay_above_rock))
                    methane%CO2_total_final_wet(iLand_k,iTile) = SUM(CO2_dens(1:mxlay_above_rock))
                    methane%O2_total_final_wet(iLand_k,iTile) = SUM(O2_dens(1:mxlay_above_rock))
                  END IF
                END IF
                
! -----------------------------------------------------------------------------------------------------------
!       FINAL BOOKKEEPING
! -----------------------------------------------------------------------------------------------------------
                ! adjust GAS densities for inundated fraction to relate them to the grid cell
                IF (.NOT. peatmask_loc(iTile)) THEN
                  methane%inun_frac_pre(iLand_k,iTile) = inun_frac_loc
                  IF (iWetness .EQ. 1) THEN
                    methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) = &
                          CH4_dens(1:mxlay_above_rock) * (1._dp - inun_frac_loc)
                    methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) = &
                          O2_dens(1:mxlay_above_rock) * (1._dp - inun_frac_loc)
                    methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) = &
                          CO2_dens(1:mxlay_above_rock) * (1._dp - inun_frac_loc)
                  ELSE
                    methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = &
                          CH4_dens(1:mxlay_above_rock) * inun_frac_loc
                    methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = &
                          O2_dens(1:mxlay_above_rock) * inun_frac_loc
                    methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = &
                          CO2_dens(1:mxlay_above_rock) * inun_frac_loc
                  END IF
                ELSE
                  methane%inun_frac_pre(iLand_k,iTile) = 1._dp
                  methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
                  methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
                  methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
                  methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = CH4_dens(1:mxlay_above_rock)
                  methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = CO2_dens(1:mxlay_above_rock)
                  methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = O2_dens(1:mxlay_above_rock)
                END IF
              
! -----------------------------------------------------------------------------------------------------------
              END DO ! iWetness
    
! -----------------------------------------------------------------------------------------------------------
!             OUTPUT FLUXES
! -----------------------------------------------------------------------------------------------------------
              ! sum fluxes over dry / wet part of grid cell, convert to tile fraction and
              ! convert output fluxes of CO2 and CH4 from timestep to second
              IF (.NOT. peatmask_loc(iTile)) THEN
                ! in non-Peatland tiles use inundated fraction to convert fluxes to tile fraction
                methane%CH4_out_dry(iLand_k,iTile) = &
                      (methane%CH4_total_out_dry(iLand_k,iTile) * (1._dp - inun_frac_loc)) / delta_time
                methane%CO2_out_dry(iLand_k,iTile) = &
                      (methane%CO2_total_out_dry(iLand_k,iTile) * (1._dp - inun_frac_loc)) / delta_time
                methane%O2_out_dry(iLand_k,iTile) = &
                      (methane%O2_total_out_dry(iLand_k,iTile) * (1._dp - inun_frac_loc)) / delta_time
                methane%CH4_out_wet(iLand_k,iTile) = &
                        (methane%CH4_total_out_wet(iLand_k,iTile) * inun_frac_loc) / delta_time
                methane%CO2_out_wet(iLand_k,iTile) = &
                        (methane%CO2_total_out_wet(iLand_k,iTile) * inun_frac_loc) / delta_time
                methane%O2_out_wet(iLand_k,iTile) = &
                        (methane%O2_total_out_wet(iLand_k,iTile) * inun_frac_loc) / delta_time
                        
                methane%CH4_out_net(iLand_k,iTile) = &
                      ((methane%CH4_total_out_dry(iLand_k,iTile) * (1._dp - inun_frac_loc)) + &
                        (methane%CH4_total_out_wet(iLand_k,iTile) * inun_frac_loc)) / delta_time
                methane%CO2_out_net(iLand_k,iTile) = &
                      ((methane%CO2_total_out_dry(iLand_k,iTile) * (1._dp - inun_frac_loc)) + &
                        (methane%CO2_total_out_wet(iLand_k,iTile) * inun_frac_loc)) / delta_time
              ELSE
                ! in Peatland tiles fluxes are tile fractions
                methane%CH4_out_dry(iLand_k,iTile) = 0._dp
                methane%CO2_out_dry(iLand_k,iTile) = 0._dp
                methane%O2_out_dry(iLand_k,iTile) = 0._dp
                methane%CH4_out_wet(iLand_k,iTile) = methane%CH4_total_out_wet(iLand_k,iTile) / delta_time
                methane%CO2_out_wet(iLand_k,iTile) = methane%CO2_total_out_wet(iLand_k,iTile) / delta_time
                methane%O2_out_wet(iLand_k,iTile) = methane%O2_total_out_wet(iLand_k,iTile) / delta_time
                
                methane%CH4_out_net(iLand_k,iTile) = methane%CH4_total_out_wet(iLand_k,iTile) / delta_time
                methane%CO2_out_net(iLand_k,iTile) = methane%CO2_total_out_wet(iLand_k,iTile) / delta_time
              END IF
                
            END IF ! compute_flag
          END IF ! is_vegetation
        END DO ! iTile
      END DO ! iLand
      
! -----------------------------------------------------------------------------------------------------------
!     FLUX ACCUMULATION
! -----------------------------------------------------------------------------------------------------------
      methane%CH4_out_dry_acc(kstart:kend,:) = methane%CH4_out_dry_acc(kstart:kend,:) + &
                                                methane%CH4_out_dry(kstart:kend,:) * delta_time
      methane%CO2_out_dry_acc(kstart:kend,:) = methane%CO2_out_dry_acc(kstart:kend,:) + &
                                                methane%CO2_out_dry(kstart:kend,:) * delta_time
      methane%O2_out_dry_acc(kstart:kend,:) = methane%O2_out_dry_acc(kstart:kend,:) + &
                                                methane%O2_out_dry(kstart:kend,:) * delta_time
      methane%CH4_out_wet_acc(kstart:kend,:) = methane%CH4_out_wet_acc(kstart:kend,:) + &
                                                methane%CH4_out_wet(kstart:kend,:) * delta_time
      methane%CO2_out_wet_acc(kstart:kend,:) = methane%CO2_out_wet_acc(kstart:kend,:) + &
                                                methane%CO2_out_wet(kstart:kend,:) * delta_time
      methane%O2_out_wet_acc(kstart:kend,:) = methane%O2_out_wet_acc(kstart:kend,:) + &
                                                methane%O2_out_wet(kstart:kend,:) * delta_time
      methane%CH4_out_net_acc(kstart:kend,:) = methane%CH4_out_net_acc(kstart:kend,:) + methane%CH4_out_net(kstart:kend,:) * delta_time
      methane%CO2_out_net_acc(kstart:kend,:) = methane%CO2_out_net_acc(kstart:kend,:) + methane%CO2_out_net(kstart:kend,:) * delta_time
      
      methane%box_CH4_out_dry(kstart:kend,:) = methane%CH4_out_dry(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_CO2_out_dry(kstart:kend,:) = methane%CO2_out_dry(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_O2_out_dry(kstart:kend,:)  = methane%O2_out_dry(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_CH4_out_wet(kstart:kend,:) = methane%CH4_out_wet(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_CO2_out_wet(kstart:kend,:) = methane%CO2_out_wet(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_O2_out_wet(kstart:kend,:)  = methane%O2_out_wet(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_CH4_out_net(kstart:kend,:) = methane%CH4_out_net(kstart:kend,:) * areaWeightingFactor(:,:)
      methane%box_CO2_out_net(kstart:kend,:) = methane%CO2_out_net(kstart:kend,:) * areaWeightingFactor(:,:)
      
      methane%box_CH4_out_dry_acc(kstart:kend,:) = methane%box_CH4_out_dry_acc(kstart:kend,:) + &
                                                    methane%box_CH4_out_dry(kstart:kend,:) * delta_time
      methane%box_CO2_out_dry_acc(kstart:kend,:) = methane%box_CO2_out_dry_acc(kstart:kend,:) + &
                                                    methane%box_CO2_out_dry(kstart:kend,:) * delta_time
      methane%box_O2_out_dry_acc(kstart:kend,:)  = methane%box_O2_out_dry_acc(kstart:kend,:) + &
                                                    methane%box_O2_out_dry(kstart:kend,:) * delta_time
      methane%box_CH4_out_wet_acc(kstart:kend,:) = methane%box_CH4_out_wet_acc(kstart:kend,:) + &
                                                    methane%box_CH4_out_wet(kstart:kend,:) * delta_time
      methane%box_CO2_out_wet_acc(kstart:kend,:) = methane%box_CO2_out_wet_acc(kstart:kend,:) + &
                                                    methane%box_CO2_out_wet(kstart:kend,:) * delta_time
      methane%box_O2_out_wet_acc(kstart:kend,:) = methane%box_O2_out_wet_acc(kstart:kend,:) + &
                                                    methane%box_O2_out_wet(kstart:kend,:) * delta_time
      methane%box_CH4_out_net_acc(kstart:kend,:) = methane%box_CH4_out_net_acc(kstart:kend,:) + &
                                                methane%box_CH4_out_net(kstart:kend,:) * delta_time
      methane%box_CO2_out_net_acc(kstart:kend,:) = methane%box_CO2_out_net_acc(kstart:kend,:) + &
                                                methane%box_CO2_out_net(kstart:kend,:) * delta_time
      
      IF (debug) CALL message('update_methane', 'ends')

      RETURN

    END SUBROUTINE update_methane

! -----------------------------------------------------------------------------------------------------------
! -----------------------------------------------------------------------------------------------------------
    PURE FUNCTION find_bedrock_layer(nsoil, layer_bound, soil_depth) RESULT(bedrock_layer)
    
      IMPLICIT NONE
      INTEGER,                    INTENT(in)  :: nsoil
      REAL(dp), DIMENSION(nsoil), INTENT(in)  :: layer_bound
      REAL(dp),                   INTENT(in)  :: soil_depth

      INTEGER :: bedrock_layer
      INTEGER :: iLayer                        ! layer counter
      
      bedrock_layer = nsoil
      DO iLayer = nsoil,2,-1
        IF(layer_bound(iLayer-1) .GE. soil_depth) THEN
          bedrock_layer = iLayer - 1
        ELSE
          IF ((soil_depth - layer_bound(iLayer-1)) .LT. 1.e-3_dp) THEN
            bedrock_layer = bedrock_layer - 1
          END IF
        END IF
      END DO
      
    END FUNCTION find_bedrock_layer

! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE soil_column_setup(nsoil, mxlay_above_rock, permafrost_flag, is_peatland, layer_thick, &
                                  layer_mid, layer_bound, soil_depth, soil_porosity, water_table, acrotelm_height, &
                                  iWetness, layer_moisture, &
                                  ice_content, relative_moist, relative_ice, relative_porevol, relative_pore_air, &
                                  relative_pore_moist, dens2conc, conc2dens, &
                                  mxlay_above_wt, mxlay_acrotelm)
                                  
      ! determine soil column setup
      
      IMPLICIT NONE
      INTEGER,                INTENT(IN)  :: nsoil
      INTEGER,                INTENT(IN)  :: mxlay_above_rock     ! layer number above bedrock
      LOGICAL,                INTENT(IN)  :: permafrost_flag      ! permafrost flag
      LOGICAL,                INTENT(IN)  :: is_peatland          ! peatland flag
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_thick          ! soil layer thickness
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_mid            ! soil layer mid depth
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_bound          ! soil layer boundary
      REAL(dp),               INTENT(IN)  :: soil_depth           ! grid cell soil depth
      REAL(dp),               INTENT(IN)  :: soil_porosity        ! grid cell soil porosity
      REAL(dp),               INTENT(IN)  :: water_table          ! tile water table position
      REAL(dp),               INTENT(IN)  :: acrotelm_height      ! [m] height of acrotelm
      INTEGER,                INTENT(IN)  :: iWetness             ! indicate dry / wet part of tile -> 1 = dry, 2 = wet
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_moisture       ! soil layer moisture content
      REAL(dp), DIMENSION(:), INTENT(IN)  :: ice_content          ! soil layer ice content
      REAL(dp), DIMENSION(:), INTENT(OUT) :: relative_moist       ! soil layer relative moisture content
      REAL(dp), DIMENSION(:), INTENT(OUT) :: relative_ice         ! soil layer relative ice content
      REAL(dp), DIMENSION(:), INTENT(OUT) :: relative_porevol     ! [-] relative pore volume in layer
      REAL(dp), DIMENSION(:), INTENT(OUT) :: relative_pore_air    ! [-] relative pore air content in layer
      REAL(dp), DIMENSION(:), INTENT(OUT) :: relative_pore_moist  ! [-] relative pore moisture in layer
      REAL(dp), DIMENSION(:), INTENT(OUT) :: dens2conc            ! conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(OUT) :: conc2dens            ! conversion factor from concentration to density
      INTEGER,                INTENT(OUT) :: mxlay_above_wt       ! layer number above water table
      INTEGER,                INTENT(OUT) :: mxlay_acrotelm       ! layer number for acrotelm end
      
      ! locals
      REAL(dp), DIMENSION(nsoil) :: effective_layer_volume
      REAL(dp), PARAMETER        :: relative_moist_saturated = 0.95_dp
      REAL(dp), PARAMETER        :: relative_porevol_min     = minimum_porevol/2._dp
      REAL(dp)                   :: current_thickness
      INTEGER                    :: iLayer
      
      relative_moist = 0._dp
      relative_ice = 0._dp

      relative_porevol = 0._dp
      relative_pore_moist = 0._dp
      relative_pore_air = 0._dp
      effective_layer_volume = 0._dp
      conc2dens = 0._dp
      dens2conc = 0._dp
      
      !  determine relative moisture and ice content in soil layers ->  divide by layer thickness
      DO iLayer = 1,mxlay_above_rock
        current_thickness = layer_thick(iLayer)
        IF ((iLayer .GT. 1) .AND. (layer_bound(iLayer) .GT. soil_depth)) THEN
          current_thickness = soil_depth - layer_bound(iLayer-1)
        END IF
        relative_moist(iLayer) = layer_moisture(iLayer) / current_thickness
        relative_ice(iLayer) = ice_content(iLayer) / current_thickness
      END DO
      relative_moist(mxlay_above_rock+1:nsoil) = 0._dp
      relative_ice(mxlay_above_rock+1:nsoil) = 1._dp
                                  
      IF (.NOT. permafrost_flag) THEN
        relative_ice = 0._dp
      END IF

      IF (iWetness .EQ. 1) THEN
        mxlay_above_wt = mxlay_above_rock
        mxlay_acrotelm = 0
      ELSE
        ! determine, in which layer water table is (remember: water table below surface is negative)
        mxlay_above_wt = find_layer(-water_table, mxlay_above_rock, layer_mid)

        ! determine, in which layer acrotelm ends
        mxlay_acrotelm = find_layer(acrotelm_height, mxlay_above_rock, layer_mid)
      END IF
              
      ! determine relative pore volume, corrected by ice
      relative_porevol(1:mxlay_above_rock) = soil_porosity - relative_ice(1:mxlay_above_rock)
      relative_porevol = MAX(relative_porevol, relative_porevol_min)

      ! calculate the relative moisture content of ice free pores
      relative_pore_moist(1:mxlay_above_rock) = relative_moist(1:mxlay_above_rock) / &
                            relative_porevol(1:mxlay_above_rock)
      relative_pore_moist = MIN(relative_pore_moist, relative_moist_saturated)

      ! correct relative moisture and relative moisture content for layers below 
      ! water table -> set to relative_moist_saturated 
      relative_pore_moist((mxlay_above_wt+1):mxlay_above_rock) = relative_moist_saturated
      relative_moist((mxlay_above_wt+1):mxlay_above_rock) = &
            relative_pore_moist((mxlay_above_wt+1):mxlay_above_rock) * &
            relative_porevol((mxlay_above_wt+1):mxlay_above_rock)

      relative_pore_air(1:mxlay_above_rock) = 1._dp - relative_pore_moist(1:mxlay_above_rock)
      
      ! helper for transferring between gas densities and concentrations
      effective_layer_volume(1:mxlay_above_rock) = layer_thick(1:mxlay_above_rock) * &
                              relative_porevol(1:mxlay_above_rock)
    
      conc2dens(1:mxlay_above_rock) = effective_layer_volume(1:mxlay_above_rock)
      dens2conc(1:mxlay_above_rock) = 1._dp / effective_layer_volume(1:mxlay_above_rock)
    
    END SUBROUTINE soil_column_setup
        
! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE init_gas_pools(mxlay_above_rock, is_peatland, iLand_k, iTile, inun_frac, &
                              methane, CH4_dens_dry, CO2_dens_dry, O2_dens_dry, &
                              CH4_dens_wet, CO2_dens_wet, O2_dens_wet)
    
      ! initialise soil gas pools 
      IMPLICIT NONE
      INTEGER,                INTENT(IN)    :: mxlay_above_rock   ! layer number above bedrock
      LOGICAL,                INTENT(IN)    :: is_peatland        ! peatland flag
      INTEGER,                INTENT(IN)    :: iLand_k            ! land point number
      INTEGER,                INTENT(IN)    :: iTile              ! tile number
      REAL(dp),               INTENT(INOUT) :: inun_frac          ! inundated fraction of grid cell
      TYPE(methane_type),     INTENT(IN)    :: methane            ! structure with methane specific variables
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CH4_dens_dry       ! [mol m-2] CH4 density in layer, dry fraction
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CO2_dens_dry       ! [mol m-2] CO2 density in layer, dry fraction
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: O2_dens_dry        ! [mol m-2]  O2 density in layer, dry fraction
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CH4_dens_wet       ! [mol m-2] CH4 density in layer, wet fraction
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CO2_dens_wet       ! [mol m-2] CO2 density in layer, wet fraction
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: O2_dens_wet        ! [mol m-2]  O2 density in layer, wet fraction
      
      ! locals
      REAL(dp) :: delta_inun                                      ! change in inundated fraction
      REAL(dp) :: transfer_frac                                   ! fraction to be transfered
      REAL(dp), DIMENSION(mxlay_above_rock) :: tmp_GAS            ! temporary GAS storage
      
      CH4_dens_dry = 0._dp
      CO2_dens_dry = 0._dp
      O2_dens_dry = 0._dp
      CH4_dens_wet = 0._dp
      CO2_dens_wet = 0._dp
      O2_dens_wet = 0._dp
      
      IF (.NOT. is_peatland) THEN
        ! for mineral soils, gas densities in methane%GAS_WETNESS are relative to tile / gridcell 
        ! -> convert to densities relative to inundated / non-inundated area of grid cell
        ! changes in inundation require a gas transfer from wet to dry part or vice versa
        
        IF (inun_frac .LT. min_inun_frac) THEN   ! impose minimum inundation size
          inun_frac = 0._dp
        END IF ! inun_frac .LT. min_inun_frac
        inun_frac = MIN(inun_frac, 1._dp)   ! insure inundated fraction <= 1
        
        ! transfer amount and direction depends on change in inundation
        delta_inun = inun_frac - methane%inun_frac_pre(iLand_k,iTile)
        IF (ABS(delta_inun) .EQ. 0._dp) THEN
          CH4_dens_dry(1:mxlay_above_rock) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile)
          CH4_dens_wet(1:mxlay_above_rock) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile)

          CO2_dens_dry(1:mxlay_above_rock) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile)
          CO2_dens_wet(1:mxlay_above_rock) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile)
          
          O2_dens_dry(1:mxlay_above_rock) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile)
          O2_dens_wet(1:mxlay_above_rock) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile)
        ELSE
          IF (delta_inun .GT. 0._dp) THEN
            ! inundated area grows -> transfer from dry to wet part of grid cell
            transfer_frac = delta_inun / (1._dp - methane%inun_frac_pre(iLand_k,iTile)) 
            transfer_frac = MIN(transfer_frac, 1._dp)
            
            ! make sure we don't get incredible values from restart
            IF (methane%inun_frac_pre(iLand_k,iTile) .LT. min_inun_frac) THEN
              methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
            END IF
            
            ! CH4
            tmp_GAS(1:mxlay_above_rock) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            CH4_dens_dry(1:mxlay_above_rock) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            CH4_dens_wet(1:mxlay_above_rock) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
                                                        
            ! update restart values immediately in case it is not considered in further calculations
            methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            
                                                        
            ! CO2
            tmp_GAS(1:mxlay_above_rock) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            CO2_dens_dry(1:mxlay_above_rock) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            CO2_dens_wet(1:mxlay_above_rock) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
                                                        
            ! update restart values immediately in case it is not considered in further calculations
            methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            
            ! O2
            tmp_GAS(1:mxlay_above_rock) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            O2_dens_dry(1:mxlay_above_rock) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            O2_dens_wet(1:mxlay_above_rock) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
                                                        
            ! update restart values immediately in case it is not considered in further calculations
            methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)

          ELSE   ! delta_inun is NEGATIVE
            ! inundated area shrinks -> transfer from wet to dry part of grid cell
            transfer_frac = -delta_inun / methane%inun_frac_pre(iLand_k,iTile)
            transfer_frac = MIN(transfer_frac, 1._dp)
            
            ! CH4
            tmp_GAS(1:mxlay_above_rock) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            CH4_dens_dry(1:mxlay_above_rock) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            CH4_dens_wet(1:mxlay_above_rock) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            
            ! update restart values immediately in case it is not considered in further calculations
            methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%CH4_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
                                                        
            ! CO2
            tmp_GAS(1:mxlay_above_rock) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            CO2_dens_dry(1:mxlay_above_rock) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            CO2_dens_wet(1:mxlay_above_rock) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            
            ! update restart values immediately in case it is not considered in further calculations
            methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%CO2_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            
            ! O2
            tmp_GAS(1:mxlay_above_rock) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) * transfer_frac
            O2_dens_dry(1:mxlay_above_rock) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            O2_dens_wet(1:mxlay_above_rock) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
            
            ! update restart values immediately in case it is not considered in further calculations
            methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) = methane%O2_dry(iLand_k,1:mxlay_above_rock,iTile) + &
                                                        tmp_GAS(1:mxlay_above_rock)
            methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) - &
                                                        tmp_GAS(1:mxlay_above_rock)
                                                        
            ! make sure restart value is zero in case of zero inundation
            IF (inun_frac .LT. min_inun_frac) THEN
              methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
              methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile) = 0._dp
            END IF
          END IF  ! delta_inun
        END IF ! ABS(delta_inun)
        
        ! convert densities to inundated / non-inundated tile fraction
        IF (inun_frac < 1._dp) THEN
          CH4_dens_dry(1:mxlay_above_rock) = CH4_dens_dry(1:mxlay_above_rock) / (1._dp - inun_frac)
          CO2_dens_dry(1:mxlay_above_rock) = CO2_dens_dry(1:mxlay_above_rock) / (1._dp - inun_frac)
          O2_dens_dry(1:mxlay_above_rock) = O2_dens_dry(1:mxlay_above_rock) / (1._dp - inun_frac)
        ELSE
          CH4_dens_dry(1:mxlay_above_rock) = 0._dp
          CO2_dens_dry(1:mxlay_above_rock) = 0._dp
          O2_dens_dry(1:mxlay_above_rock) = 0._dp
        END IF
        
        IF (inun_frac > 0._dp) THEN
          CH4_dens_wet(1:mxlay_above_rock) = CH4_dens_wet(1:mxlay_above_rock) / inun_frac
          CO2_dens_wet(1:mxlay_above_rock) = CO2_dens_wet(1:mxlay_above_rock) / inun_frac
          O2_dens_wet(1:mxlay_above_rock) = O2_dens_wet(1:mxlay_above_rock) / inun_frac
        ELSE
          CH4_dens_wet(1:mxlay_above_rock) = 0._dp
          CO2_dens_wet(1:mxlay_above_rock) = 0._dp
          O2_dens_wet(1:mxlay_above_rock) = 0._dp
        END IF
        
      ELSE
        ! for organic soils, gas densities are relative to peatland tile / grid cell
        ! there is no dry part of tile
        ! -> no conversion necessary
        ! FOR NOW WE ASSUME THAT PEATLAND TILE SIZES ARE STATIC
        CH4_dens_wet(1:mxlay_above_rock) = methane%CH4_wet(iLand_k,1:mxlay_above_rock,iTile)
        CO2_dens_wet(1:mxlay_above_rock) = methane%CO2_wet(iLand_k,1:mxlay_above_rock,iTile)
        O2_dens_wet(1:mxlay_above_rock)  = methane%O2_wet(iLand_k,1:mxlay_above_rock,iTile)
        inun_frac = 1._dp
      END IF  ! is_peatland
      
    END SUBROUTINE init_gas_pools
    
! -----------------------------------------------------------------------------------------------------------
    PURE FUNCTION find_layer(depth, nsoil, midpoints) RESULT(endLayer)
      ! determine, in which layer roots end or
      ! determine, in which layer water table is or
      ! determine, in which layer acrotelm ends

      IMPLICIT NONE

      INTEGER,  INTENT(in)  :: nsoil
      REAL(dp), INTENT(in)  :: depth, midpoints(nsoil)

      ! local
      INTEGER :: iLayer                        ! layer counter
      INTEGER :: endLayer

      endLayer = 0                ! default value -> at or above surface

      IF (depth .GE. midpoints(1)) THEN
        endLayer = nsoil
        DO iLayer = 1, nsoil-1
          IF ((depth .GE. midpoints(iLayer)) .AND. (depth .LT. midpoints(iLayer+1))) THEN
            endLayer = iLayer
          END IF
        END DO
      END IF

      RETURN

    END FUNCTION find_layer
    
! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE determine_root_dist(mxlay_above_rock, layer_thick, layer_depth, cover_type, root_dist)
    
      ! determine root distribution on tile
      ! based on Jackson 1996
    
      IMPLICIT NONE

      INTEGER,                INTENT(IN)  :: mxlay_above_rock     ! layer number above bedrock
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_thick          ! soil layer thickness
      REAL(dp), DIMENSION(:), INTENT(IN)  :: layer_depth          ! soil layer depth
      INTEGER,                INTENT(IN)  :: cover_type           ! tile cover type
      REAL(dp), DIMENSION(:), INTENT(OUT) :: root_dist            ! root distribution in each layer
      INTEGER, PARAMETER                  :: cover_type_max = 22  
      
      ! locals
      ! root distribution parameters
      ! beta in Jackson equation
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: root_dist_beta = (/ -99._dp, 0.962_dp, 0.961_dp, 0.976_dp, 0.966_dp, &   
                                                                0.966_dp, 0.966_dp, 0.976_dp, 0.966_dp, 0.964_dp, &
                                                                0.964_dp, 0.943_dp, 0.972_dp, -99._dp, 0.943_dp, &
                                                                0.972_dp, 0.914_dp, -99._dp, 0.961_dp, 0.943_dp, &
                                                                0.972_dp, 0.943_dp /)
                                                                
      REAL(dp), DIMENSION(mxlay_above_rock)  :: root_dist_cum         ! cumulative root distribution for layers
      INTEGER  :: iLayer                                              ! layer counter
      
      root_dist = 0._dp
      
      IF ((root_dist_beta(cover_type) .LT. 0._dp) .OR. (cover_type .GT. cover_type_max)) THEN
        WRITE(message_text,*) 'CANNOT DETERMINE ROOT DISTRIBUTION FOR COVER TYPE ',cover_type, ' USING DEFAULT'
        CALL message('update_methane determine_root_dist', message_text, all_print=.TRUE., level=em_warn)
        root_dist(1:4) = layer_thick(1:4)
      ELSE
        DO iLayer = 1, mxlay_above_rock
          root_dist_cum(iLayer) = 1._dp - (root_dist_beta(cover_type) ** (layer_depth(iLayer) * 100._dp))
          IF (iLayer .EQ. 1) THEN
            root_dist(iLayer) = root_dist_cum(iLayer)
          ELSE
            root_dist(iLayer) = root_dist_cum(iLayer) - root_dist_cum(iLayer-1)
          END IF
        END DO
      END IF
      IF (SUM(root_dist) .GT. 0._dp) THEN
        root_dist = root_dist / SUM(root_dist)
      ELSE
        root_dist = 0._dp
      END IF
    
    END SUBROUTINE determine_root_dist

! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE aggregate_canopy_setup(ntiles, ctiles, veg_fract_correction, cover_fract, &
                                      is_vegetation, is_peatland, peatland_tile, vegmask_loc, &
                                      peatmask_loc, tile_weight, tile_corr)
      IMPLICIT NONE

      INTEGER,                  INTENT(IN)  :: ntiles                     ! number of tiles, JSBACH
      INTEGER,                  INTENT(IN)  :: ctiles                     ! number of tiles, methane (poss. aggregated)
      REAL(dp), DIMENSION(:),   INTENT(IN)  :: veg_fract_correction       ! canopy correction factor
      REAL(dp), DIMENSION(:),   INTENT(IN)  :: cover_fract                ! tile cover fraction
      LOGICAL,  DIMENSION(:),   INTENT(IN)  :: is_vegetation              ! tile vegetation flag
      LOGICAL,  DIMENSION(:),   INTENT(IN)  :: is_peatland                ! tile peatland flag
      INTEGER,                  INTENT(OUT) :: peatland_tile              ! number of peatland tile
      LOGICAL,  DIMENSION(ctiles),   INTENT(OUT) :: vegmask_loc           ! tile vegetation flag (methane tiles)
      LOGICAL,  DIMENSION(ctiles),   INTENT(OUT) :: peatmask_loc          ! tile peatland flag (methane tiles)
      REAL(dp), DIMENSION(ntiles),   INTENT(OUT)  :: tile_weight          ! weight of tile in aggregation
      REAL(dp), DIMENSION(ctiles),   INTENT(OUT)  :: tile_corr            ! canopy correction for tile (methane tiles)

      REAL(dp) :: cover_fract_sum, tile_corr_peat
      INTEGER  :: iTile
      
      vegmask_loc = .FALSE.
      peatmask_loc = .FALSE.
      
      peatland_tile = 0
      
      tile_weight = 1._dp
      tile_corr = 0._dp
      
      cover_fract_sum = 0._dp
      tile_corr_peat = 0._dp
      
      IF (ctiles .EQ. ntiles) THEN
        tile_corr = veg_fract_correction * cover_fract
        vegmask_loc = is_vegetation
        peatmask_loc = is_peatland
        DO iTile = 1,ntiles
          IF (is_peatland(iTile)) &
            peatland_tile = iTile
        END DO
      ELSE
        IF (ANY(is_vegetation))  &
          vegmask_loc(1) = .TRUE.
        DO iTile = 1,ntiles
          IF (is_peatland(iTile)) THEN
            peatland_tile = iTile
            vegmask_loc(2) = .TRUE.
            peatmask_loc(2) = .TRUE.
            tile_weight(iTile) = 0._dp
            tile_corr_peat = veg_fract_correction(iTile) * cover_fract(iTile)
          ELSE
            IF (is_vegetation(iTile)) THEN
              tile_weight(iTile) = cover_fract(iTile)
              cover_fract_sum = cover_fract_sum + cover_fract(iTile)
            ELSE
              tile_weight(iTile) = 0._dp
            END IF
          END IF
        END DO
        IF (cover_fract_sum > 0._dp) THEN
          tile_weight = tile_weight / cover_fract_sum
        ELSE
          tile_weight = 0._dp
        END IF
        tile_corr(1) = SUM(tile_weight*veg_fract_correction)*cover_fract_sum
        tile_corr(2) = tile_corr_peat
      END IF
      
    END SUBROUTINE aggregate_canopy_setup
      
! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE aggregate_canopy(ntiles, ctiles, is_peatland, tile_weight, disaggregated_field, aggregated_field)
      IMPLICIT NONE

      INTEGER,                  INTENT(IN)  :: ntiles                     ! number of tiles, JSBACH
      INTEGER,                  INTENT(IN)  :: ctiles                     ! number of tiles, methane (poss. aggregated)
      LOGICAL,  DIMENSION(:),   INTENT(IN)  :: is_peatland                ! tile peatland flag
      REAL(dp), DIMENSION(:),   INTENT(IN)  :: tile_weight        
      REAL(dp), DIMENSION(:),   INTENT(IN)  :: disaggregated_field        ! field to be aggregated (ntiles)
      REAL(dp), DIMENSION(:),   INTENT(OUT) :: aggregated_field           ! aggregated field (ctiles)
      
      ! locals
      INTEGER :: iTile
      
      IF (ntiles .EQ. ctiles) THEN
        aggregated_field = disaggregated_field
      ELSE
        aggregated_field = 0._dp
        DO iTile = 1,ntiles
          IF (.NOT. is_peatland(iTile)) THEN
            aggregated_field(1) = aggregated_field(1) + disaggregated_field(iTile)*tile_weight(iTile)
          ELSE
            aggregated_field(2) = disaggregated_field(iTile)
          END IF
        END DO
      END IF
    END SUBROUTINE aggregate_canopy
    
! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE production(mxlay_above_rock, mxlay_above_wt, is_peatland, iWetness, root_dist, &
                            inun_frac, Tsoil, OxicDecompCarbon, AnoxDecompCarbon, &
                            CH4_Prod, CO2_Prod, O2_Uptake, CH4_prod_ratio)
                            
      ! Determine the CH4 / CO2 production and vertical distribution
    
      IMPLICIT NONE

      INTEGER,                INTENT(IN)    :: mxlay_above_rock   ! layer number above bedrock
      INTEGER,                INTENT(IN)    :: mxlay_above_wt     ! layer number above water table
      LOGICAL,                INTENT(IN)    :: is_peatland        ! peatland flag (TRUE if peatland)
      INTEGER,                INTENT(IN)    :: iWetness           ! wetness state, 1 = dry, 2 = wet
      REAL(dp), DIMENSION(:), INTENT(IN)    :: root_dist          ! root distribution in each layer
      REAL(dp),               INTENT(IN)    :: inun_frac          !  [-] grid cell inundated fraction
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Tsoil              !  [-] soil temperature
      REAL(dp),               INTENT(IN)    :: OxicDecompCarbon   ! [mol m-2 timestep-1] carbon production from oxic decomposition in tile
      REAL(dp),               INTENT(IN)    :: AnoxDecompCarbon   ! [mol m-2 timestep-1] carbon production from anaerobic decomposition in tile
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CH4_Prod           ! [mol m-2 timestep-1] CH4 production per layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CO2_Prod           ! [mol m-2 timestep-1] CO2 production per layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: O2_Uptake          ! [mol m-2 timestep-1] O2 uptake during oxic CO2 production per layer
      REAL(dp),               INTENT(OUT)   :: CH4_Prod_ratio     !  [-] ratio of CH4 to total anoxic production
      
      ! locals
      REAL(dp), DIMENSION(mxlay_above_rock) :: carbon_dist        ! [mol m-2 timestep-1] vertical distribution of carbon
      REAL(dp), DIMENSION(mxlay_above_rock) :: CO2_Prod_oxic      ! [mol m-2 timestep-1] CO2 production per layer, oxic
      REAL(dp), DIMENSION(mxlay_above_rock) :: CO2_Prod_anox      ! [mol m-2 timestep-1] CO2 production per layer, anoxic
      REAL(dp), DIMENSION(mxlay_above_rock) :: root_dist_peat     ! root distribution in peatland
      REAL(dp) :: carbon_oxic                                     ! [-] carbon decomposed oxically
      REAL(dp) :: carbon_anox                                     ! [-] carbon decomposed anaerobically
      REAL(dp) :: carbon_dist_sum_oxic                            ! [-] sum of carbon in oxic layers
      REAL(dp) :: carbon_dist_sum_anox                            ! [-] sum of carbon in anoxic layer
      REAL(dp) :: carbon_dist_sum_acro                            ! [-] sum of carbon in anoxic acrotelm
      REAL(dp) :: carbon_dist_sum_cato                            ! [-] sum of carbon in catotelm
      REAL(dp) :: carbon_dist_sum_oxic_inv                        ! [-] inverse of the sum of carbon in oxic layers
      REAL(dp) :: carbon_dist_sum_anox_inv                        ! [-] inverse of the sum of carbon in anoxic layers
      REAL(dp) :: carbon_dist_sum_acro_inv                        ! [-] inverse of the sum of carbon in anoxic acrotelm
      REAL(dp) :: carbon_dist_sum_cato_inv                        ! [-] inverse of the sum of carbon in catotelm
      REAL(dp), DIMENSION(mxlay_above_rock) :: f_ch4              ! [-] fraction of C decomposed into CH4
      REAL(dp), PARAMETER :: Q10basetemp = 295._dp
      
      CH4_Prod = 0._dp
      CO2_Prod = 0._dp
      CO2_Prod_oxic = 0._dp
      CO2_Prod_anox = 0._dp
      O2_Uptake = 0._dp
      carbon_dist = 0._dp
      root_dist_peat = 1._dp                ! we assume equally distributed C emissions per layer in peatland
      CH4_Prod_ratio = 0._dp
      
      ! production is different for peatlands and inundated areas:
      ! peatlands have vertically stacked oxic / anoxic layers, while
      ! inundated areas are completely anoxic in the inundated fraction 
      ! and completely oxic in the non-inundated fraction
      IF (.NOT. is_peatland) THEN
        ! convert fluxes in non-peatlands to values per m2 in inundated / non-inundated fraction
        IF (inun_frac .LT. 1._dp) THEN
          carbon_oxic = OxicDecompCarbon / (1._dp - inun_frac)
        ELSE
          carbon_oxic = 0._dp
        END IF ! inun_frac .LT. 1._dp
        
        IF (inun_frac .GT. 0._dp) THEN
          carbon_anox = AnoxDecompCarbon / inun_frac
        ELSE
          carbon_anox = 0._dp
        END IF ! inun_frac .GT. 0._dp
      ELSE
        carbon_oxic = OxicDecompCarbon
        carbon_anox = AnoxDecompCarbon
      END IF ! .NOT. is_peatland
      
      ! In non-peatlands, inundated fraction is completely anoxic. This simplifies things substantially.
      ! we assume mineral soils in this case, using frac_CH4_anox_mineral
      IF (.NOT. is_peatland) THEN
        ! vertical distribution of anoxic carbon - entire soil column is either saturated or not
        IF (iWetness .EQ. 1) THEN
          ! carbon is input according to root distribution
          carbon_dist(1:mxlay_above_rock) = root_dist(1:mxlay_above_rock) * carbon_oxic
                  
          ! dry part of grid cell is completely oxic, becoming CO2 
          CO2_Prod_oxic(1:mxlay_above_rock) = carbon_dist(1:mxlay_above_rock)
        ELSE
          f_ch4 = methane_options%frac_CH4_anox_mineral * methane_options%meth_q10**((Tsoil(1:mxlay_above_rock)-Q10basetemp)/10._dp)
          f_ch4 = MIN(f_ch4,0.5_dp)
          ! carbon is input according to root distribution
          carbon_dist(1:mxlay_above_rock) = root_dist(1:mxlay_above_rock) * carbon_anox
                  
          ! C decomposed under anaerobic conditions becomes both CH4 and CO2, with
          ! fractions determined by frac_CH4_anox_mineral
          ! determine CO2 densities and concentrations produced anaerobically
          CO2_Prod_anox(1:mxlay_above_rock) = (1._dp - f_ch4(1:mxlay_above_rock)) * carbon_dist(1:mxlay_above_rock)
                  
          ! determine CH4 densities and concentrations produced
          CH4_Prod(1:mxlay_above_rock) = f_ch4(1:mxlay_above_rock) * carbon_dist(1:mxlay_above_rock)
        END IF
      ELSE   ! is_peatland
        f_ch4 = methane_options%frac_CH4_anox_organic * methane_options%meth_q10**((Tsoil(1:mxlay_above_rock)-Q10basetemp)/10._dp)
        f_ch4 = MIN(f_ch4,0.5_dp)

        ! we assume organic soils in this case, using frac_CH4_anox_organic
        
        ! sum of carbon in oxic, anoxic acrotelm and catotelm
        ! NEED TO MODIFY THIS ONCE WE HAVE CATOTELM
        carbon_dist_sum_oxic = SUM(root_dist_peat(1:mxlay_above_wt))
        carbon_dist_sum_anox = SUM(root_dist_peat((mxlay_above_wt+1):mxlay_above_rock))

        ! inverse of the carbon distribution sum
        IF (carbon_dist_sum_oxic .GT. 0._dp) THEN
          carbon_dist_sum_oxic_inv = 1._dp / carbon_dist_sum_oxic
        ELSE
          carbon_dist_sum_oxic_inv = 0._dp
        END IF
        IF (carbon_dist_sum_anox .GT. 0._dp) THEN
          carbon_dist_sum_anox_inv = 1._dp / carbon_dist_sum_anox
        ELSE
          carbon_dist_sum_anox_inv = 0._dp
        END IF

        ! calculate the concentration of CO2 out of the
        ! density of decomposed carbon, assuming, that all
        ! carbon above the water table and half of the
        ! carbon below the water table becomes CO2

        ! determine CO2 densities produced above the water table
        ! consider very high water table as well to conserve carbon
        IF ((mxlay_above_wt .LE. 1) .OR. (carbon_dist_sum_oxic_inv .LT. 1.e-12_dp)) THEN
          CO2_Prod_oxic(1) = carbon_oxic
        ELSE
          CO2_Prod_oxic(1:mxlay_above_wt) = &
                  root_dist_peat(1:mxlay_above_wt) * carbon_dist_sum_oxic_inv * carbon_oxic
        END IF

        ! vertical distribution of anoxic carbon in saturated part
        ! consider very low water table as well to conserve carbon
        IF ((mxlay_above_wt .LT. mxlay_above_rock) .AND. (carbon_dist_sum_anox_inv .GT. 1.e-12_dp)) THEN
          carbon_dist((mxlay_above_wt+1):mxlay_above_rock) = &
                  root_dist_peat((mxlay_above_wt+1):mxlay_above_rock) * carbon_dist_sum_anox_inv * carbon_anox
        ELSE
          carbon_dist(mxlay_above_rock) = carbon_anox
        END IF

        ! determine CO2 densities produced below the water table
        CO2_Prod_anox(1:mxlay_above_rock) = &
                (1._dp - f_ch4(1:mxlay_above_rock)) * carbon_dist(1:mxlay_above_rock)
        ! determine CH4 densities produced
        CH4_Prod(1:mxlay_above_rock) = f_ch4(1:mxlay_above_rock) * carbon_dist(1:mxlay_above_rock)
      END IF ! NOT is_peatland
      
      IF (SUM(CH4_Prod(1:mxlay_above_rock)+CO2_Prod_anox(1:mxlay_above_rock)) .GT. 0._dp) &
        CH4_Prod_ratio = SUM(CH4_prod(1:mxlay_above_rock))/SUM(CH4_Prod(1:mxlay_above_rock)+CO2_Prod_anox(1:mxlay_above_rock))
        
      
      CO2_Prod(1:mxlay_above_rock) = CO2_Prod_oxic(1:mxlay_above_rock) + CO2_Prod_anox(1:mxlay_above_rock)
      O2_Uptake(1:mxlay_above_rock) = -CO2_Prod(1:mxlay_above_rock) * 2._dp   ! 2 mol of O for 1 mol of CO2
      
    END SUBROUTINE production
    
! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE oxidation_mm(mxlay_above_rock, rel_soil_moist, Tsoil, iWetness, CH4_dens, CO2_dens, O2_dens, &
                            O2_Uptake_Prod, CH4_Oxid, CO2_Oxid, O2_Oxid, O2_Other, dens2conc, conc2dens)
      ! oxidation following Michaelis-Menten kinetics
    
      IMPLICIT NONE

      INTEGER,                INTENT(IN)    :: mxlay_above_rock   ! layer number above bedrock
      REAL(dp),               INTENT(IN)    :: rel_soil_moist     ! relative soil moisture
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Tsoil              ! [K] Soil temperature
      INTEGER,                INTENT(IN)    :: iWetness           ! wetness state -- 1 = dry, 2 = wet
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CH4_dens           ! [mol m-2] CH4 density in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CO2_dens           ! [mol m-2] CO2 density in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: O2_dens            ! [mol m-2] O2 density in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: O2_Uptake_Prod     ! [mol m-2 timestep-1] O2 uptake during CO2 production
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CH4_Oxid           ! [mol m-2 timestep-1] CH4 density oxidised in layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CO2_Oxid           ! [mol m-2 timestep-1] CO2 density oxidised in layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: O2_Oxid            ! [mol m-2 timestep-1] O2 density oxidised in layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: O2_Other           ! [mol m-2 timestep-1] O2 density utilised by other processes
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dens2conc          ! [-] conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: conc2dens          ! [-] conversion factor from concentration to density 

      ! local variable
      INTEGER :: iLayer
      ! Parameters Riley
      REAL(dp), PARAMETER :: v_Max_wet = 1.25e-5_dp               ! [mol m-3 s-1] max. reaction velocity (based on W&H, 2000)
      REAL(dp), PARAMETER :: K_M_CH4_wet = 5.e-3_dp               ! [mol m-3] Michaelis-Menten constant CH4: concentration where v = 0.5 * v_Max (W&H, 2000)
      REAL(dp), PARAMETER :: v_Max_dry = v_Max_wet/10._dp         ! [mol m-3 s-1] max. reaction velocity (reduced for upland)
      REAL(dp), PARAMETER :: K_M_CH4_dry = K_M_CH4_wet/10._dp     ! [mol m-3] Michaelis-Menten constant CH4: concentration where v = 0.5 * v_Max (reduced for upland)
      REAL(dp), PARAMETER :: K_M_O2  = 2.e-2_dp                   ! [mol m-3] Michaelis-Menten constant O2: concentration where v = 0.5 * v_Max
      REAL(dp), PARAMETER :: Q10_Oxid = 1.9_dp                    ! [-] Q10 value for CH4 oxidation rate
      REAL(dp), PARAMETER :: ten = 10._dp                         ! [-] divisor for Q10 exponent
      REAL(dp), PARAMETER :: stoich = 2._dp                       ! [-] stoichiometric CH4 oxidation: 2mol O2 for 1mol CH4
      REAL(dp), PARAMETER :: frac_O2_Ox  = 0.4_dp                 ! [-] fraction of O2 needed for other oxidation processes
      REAL(dp), PARAMETER :: frac_O2_Ph  = 0.1_dp                 ! [-] fraction of O2 needed for other physical processes
      REAL(dp), PARAMETER :: frac_O2_Other = frac_O2_Ox + frac_O2_Ph ! [-] fraction of O2 needed for other processes
      REAL(dp) :: O2_avail
      REAL(dp) :: MMkin
      REAL(dp) :: moist_lim                                       ! moisture limitation
      REAL(dp) :: v_Max_eff
      REAL(dp) :: K_M_CH4_eff

      REAL(dp), DIMENSION(mxlay_above_rock) :: CH4_conc           ! [mol m-3] CH4 concentration
      REAL(dp), DIMENSION(mxlay_above_rock) :: CH4_conc_oxid      ! [mol m-3] CH4 concentration oxidised
      REAL(dp), DIMENSION(mxlay_above_rock) :: O2_conc            ! [mol m-3] O2 concentration
      REAL(dp), DIMENSION(mxlay_above_rock) :: O2_dens_local

      CH4_Oxid = 0._dp
      CO2_Oxid = 0._dp
      O2_Oxid  = 0._dp
      O2_Other = 0._dp
      CH4_conc_oxid = 0._dp
      
      IF (iWetness .EQ. 1) THEN
        v_Max_eff = v_Max_dry*methane_options%oxid_scale_dry
        K_M_CH4_eff = K_M_CH4_dry
      ELSE
        v_Max_eff = v_Max_wet*methane_options%oxid_scale_wet
        K_M_CH4_eff = K_M_CH4_wet
      END IF
      
      O2_dens_local = O2_dens(1:mxlay_above_rock)

      DO iLayer = 1, mxlay_above_rock
        ! other O2 requirements: uptake during CO2 production, physical processes, other oxidation processes
        ! maximum requirement is half availability
        O2_Other(iLayer) = -MIN((-O2_Uptake_Prod(iLayer) + frac_O2_Ph * O2_dens(iLayer)), (frac_O2_Other * O2_dens(iLayer)))
      END DO
      O2_dens_local = O2_dens_local + O2_Other(1:mxlay_above_rock)

      
      CH4_conc = CH4_dens(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
      O2_conc = O2_dens_local(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
      
      
      moist_lim = 1.0_dp
      
      DO iLayer = 1, mxlay_above_rock
        IF (CH4_conc(iLayer) .GT. 0._dp) THEN
          ! O2 availability
          O2_avail = O2_conc(iLayer) / stoich
          ! Michaelis-Menten kinetics
          MMkin = v_Max_eff * &
                  (CH4_conc(iLayer) / (K_M_CH4_eff + CH4_conc(iLayer))) *  &
                  (O2_conc(iLayer) / (K_M_O2  +  O2_conc(iLayer))) *   &
                  Q10_Oxid**((Tsoil(iLayer) - (tmelt + ten)) / ten) * &
                  moist_lim * delta_time
          
          CH4_conc_oxid(iLayer) = -MMkin
        END IF
      END DO
      
      CH4_Oxid(1:mxlay_above_rock) = CH4_conc_oxid * conc2dens(1:mxlay_above_rock)
      CO2_Oxid = -CH4_Oxid
      O2_Oxid = CH4_Oxid * stoich

    END SUBROUTINE oxidation_mm

! -----------------------------------------------------------------------------------------------------------
    SUBROUTINE diffusion_setup(mxlay_above_rock, mxlay_above_wt, bclapp, is_peatland, &
                                relative_pore_air, relative_porevol, Tsoil, &
                                D_CH4, D_CO2, D_O2, D_CH4_surface, D_CO2_surface, D_O2_surface)

      ! Calculate the diffusivities for each gas in both water
      ! and air once, to be allocated as needed
    
      IMPLICIT NONE

      INTEGER,                INTENT(IN)  :: mxlay_above_rock     ! layer number above bedrock
      INTEGER,                INTENT(IN)  :: mxlay_above_wt       ! layer number above water table
      REAL(dp),               INTENT(IN)  :: bclapp               ! exponent b in Clapp and Hornberger
      LOGICAL,                INTENT(IN)  :: is_peatland          ! peatland flag (TRUE = peatland)
      REAL(dp), DIMENSION(:), INTENT(IN)  :: relative_pore_air    ! [-] relative pore air content in layer
      REAL(dp), DIMENSION(:), INTENT(IN)  :: relative_porevol     ! [-] relative pore volume in layer
      REAL(dp), DIMENSION(:), INTENT(IN)  :: Tsoil                ! [K] Soil temperature
      REAL(dp), DIMENSION(:), INTENT(OUT) :: D_CH4                ! [m2 s-1] diffusivity of CH4 on layers
      REAL(dp), DIMENSION(:), INTENT(OUT) :: D_CO2                ! [m2 s-1] diffusivity of CO2 on layers
      REAL(dp), DIMENSION(:), INTENT(OUT) :: D_O2                 ! [m2 s-1] diffusivity of O2 on layers
      REAL(dp),               INTENT(OUT) :: D_CH4_surface        ! [m2 s-1] diffusivity of CH4 in surface air
      REAL(dp),               INTENT(OUT) :: D_CO2_surface        ! [m2 s-1] diffusivity of CO2 in surface air
      REAL(dp),               INTENT(OUT) :: D_O2_surface         ! [m2 s-1] diffusivity of O2 in surface air
      
      ! locals
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_CH4_air          ! [m2 s-1] diffusivity of CH4 in air
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_CO2_air          ! [m2 s-1] diffusivity of CO2 in air
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_O2_air           ! [m2 s-1] diffusivity of O2 in air
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_CH4_water        ! [m2 s-1] diffusivity of CH4 in water
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_CO2_water        ! [m2 s-1] diffusivity of CO2 in water
      REAL(dp), DIMENSION(mxlay_above_rock) :: D_O2_water         ! [m2 s-1] diffusivity of O2 in water
      REAL(dp), DIMENSION(mxlay_above_rock) :: Tsoil_C            ! soil temperature on Celsius scale
      
      REAL(dp) :: conv                                            ! conversion factor
      INTEGER  :: iLayer                                          ! layer counter
      
      D_CH4 = 0._dp
      D_CO2 = 0._dp
      D_O2  = 0._dp
      
      Tsoil_C(1:mxlay_above_rock) = Tsoil(1:mxlay_above_rock) - tmelt

      DO iLayer = 1, mxlay_above_rock
        ! Diffusivity in air
        ! From Lerman (1979)
        ! Units are [cm2 s-1]
        D_CH4_air(iLayer) =  0.1875_dp + 0.0013_dp * Tsoil_C(iLayer)
        D_CO2_air(iLayer) = 0.1325_dp + 0.0009_dp * Tsoil_C(iLayer)
        D_O2_air(iLayer) = 0.1759_dp + 0.00117_dp * Tsoil_C(iLayer)

        ! Diffusivity in water
        ! following Broecker and Peng (1974)
        ! Units are [cm2 s-1]
        D_CH4_water(iLayer) = (0.9798_dp + 0.02986_dp * Tsoil_C(iLayer) + &
              0.0004381_dp * Tsoil_C(iLayer) ** 2._dp) * 1.e-5_dp
        D_CO2_water(iLayer) = (0.939_dp + 0.02671_dp * Tsoil_C(iLayer) + &
              0.0004095_dp * Tsoil_C(iLayer) ** 2._dp) * 1.e-5_dp
        D_O2_water(iLayer) = (1.172_dp + 0.03443_dp * Tsoil_C(iLayer) + &
              0.0005048_dp * Tsoil_C(iLayer)** 2._dp) * 1.e-5_dp
      END DO
      
      ! Use Millington and Quirk 1961 (MQ) Model tested in
      ! Iiyama and Hasegawa 2005.
      ! When Fair is less then 0.05, then use the diffusivity
      ! of water.  The cut-off of 0.05 is where Dwater is
      ! about equal D using the MQ model.
      
      ! Original Wania code assigns D_GAS_air, if relative_pore_air(iLayer) > 0.05
      ! We assume that this is the case ABOVE the water table

      DO iLayer = 1, mxlay_above_wt
        IF (.NOT. is_peatland) THEN
          ! Moldrup et al. diffusivity modification for soil pore air in mineral soils
          conv = ((relative_pore_air(iLayer) * relative_porevol(iLayer)) ** 2._dp) * (relative_pore_air(iLayer) ** (3._dp/bclapp))
        ELSE
          ! Millington & Quirk diffusivity modification for soil pore air in organic soils
          conv = ((relative_pore_air(iLayer) * relative_porevol(iLayer)) ** (10._dp/3._dp)) / (relative_porevol(iLayer) ** 2._dp)
        END IF
        D_CH4(iLayer) = D_CH4_air(iLayer) * conv
        D_CO2(iLayer) = D_CO2_air(iLayer) * conv
        D_O2(iLayer) = D_O2_air(iLayer) * conv
      END DO
      DO iLayer = (mxlay_above_wt + 1), mxlay_above_rock
        ! Moldrup et al. diffusivity modification for soil pore water
        conv = relative_porevol(iLayer) ** 2._dp
        D_CH4(iLayer) = D_CH4_water(iLayer) * conv
        D_CO2(iLayer) = D_CO2_water(iLayer) * conv
        D_O2(iLayer) = D_O2_water(iLayer) * conv
      END DO
      
      ! Ensure that layer diffusivity is not larger than for layer(s) above
      DO iLayer = 2, mxlay_above_rock
        IF (D_CH4(iLayer) .GT. D_CH4(iLayer-1)) &
          D_CH4(iLayer) = D_CH4(iLayer-1)
        IF (D_CO2(iLayer) .GT. D_CO2(iLayer-1)) &
          D_CO2(iLayer) = D_CO2(iLayer-1)
        IF (D_O2(iLayer) .GT. D_O2(iLayer-1)) &
          D_O2(iLayer) = D_O2(iLayer-1)
      END DO

      ! Convert diffusivity from cm2 s-1 to m2 s-1
      ! cm2 / 10000 = m2
      ! Wanias actual units are m2 day-1 -> she also multiplies with 86400
      ! -------------------------------------------
      D_CH4(1:mxlay_above_rock) = D_CH4(1:mxlay_above_rock) / 10000._dp
      D_CO2(1:mxlay_above_rock) = D_CO2(1:mxlay_above_rock) / 10000._dp
      D_O2(1:mxlay_above_rock)  = D_O2(1:mxlay_above_rock)  / 10000._dp
      
      D_CH4_surface = D_CH4_air(1) / 10000._dp
      D_CO2_surface = D_CO2_air(1) / 10000._dp
      D_O2_surface  = D_O2_air(1) / 10000._dp
    
    END SUBROUTINE diffusion_setup
    
! -----------------------------------------------------------------------------------------------------------    
    SUBROUTINE plant_setup(mxlay_above_rock, iWetness, LAI, LAI_max, Cpool_green, cover_type, &
                                  root_dist, tillers, tiller_area)
                                  
      ! set up plant transport parameters for all plant transports on tile
      ! determines tiller_area and tiller_surface
    
      IMPLICIT NONE
      INTEGER,                INTENT(IN)  :: mxlay_above_rock     ! layer number above bedrock
      INTEGER,                INTENT(IN)  :: iWetness             ! wetness state -- 1 = dry, 2 = wet
      REAL(dp),               INTENT(IN)  :: LAI                  ! [-] leaf area index
      REAL(dp),               INTENT(IN)  :: LAI_max              ! [-] maximum leaf area index
      REAL(dp),               INTENT(IN)  :: Cpool_green          ! C-pool for leaves, fine roots, vegetative organs and other living parts 
                                                                  ! of vegetation [mol(C)/m^2(canopy)]
      INTEGER,                INTENT(IN)  :: cover_type           ! tile cover type
      REAL(dp), DIMENSION(:), INTENT(IN)  :: root_dist            ! root distribution in each layer
      REAL(dp),               INTENT(OUT) :: tillers              ! number of tillers
      REAL(dp), DIMENSION(:), INTENT(OUT) :: tiller_area          ! area of tillers corresponding to the root fraction in each layer
      
      ! locals
      REAL(dp), PARAMETER     :: tiller_weight = 0.0183_dp        ! [mol C] Individual tiller weight, Wania original is 0.22 gC -> converted to mol C
      REAL(dp), PARAMETER     :: tiller_radius = 0.003_dp         ! [m] Radius of an average tiller 
      REAL(dp), PARAMETER     :: tiller_por_grass = 0.7_dp        ! Tiller porosity grass (Wania)
      REAL(dp), PARAMETER     :: tiller_por_tree = 0.3_dp         ! Tiller porosity tree (arbitrary)
      REAL(dp), PARAMETER     :: tiller_por_min = 0.05_dp         ! Tiller porosity min (Riley)
      REAL(dp), PARAMETER     :: dry_ratio = 0.3_dp               ! Tiller porosity tree (arbitrary)
      REAL(dp)                :: tiller_frac                      ! fraction of tillers weighted by root biomass in each layer
      REAL(dp)                :: tiller_por                       ! Tiller porosity
      INTEGER                 :: iLayer                           ! layer counter
      
      tiller_area = 0._dp
      
      ! Root biomass distribution of all plants, modelled on Wania's 
      ! parameterisation for flood-tolerant graminoids
      ! ------------------------------------------------

      ! Wania uses dphen(d,pft) to have a phenology in the roots as
      ! they'll have to be built up in spring and plant transport
      ! will depend on existence of stems and leaves.
      ! We use ratio of LAI to LAI_max instead, which should give similar results

      ! Wania thinks that the limiting factor to plant transport are
      ! the number of tillers as they represent the
      ! cross-sectional area available to gas transport. She relates
      ! the biomass to tiller density based on Schimel 1995. The
      ! average biomass was 185g/m2 and the average number of
      ! tillers was 380/m2. This gives us 2.05 tillers per g
      ! biomass and 0.48 g per tiller, which corresponds to 0.22 g
      ! C per tiller

      ! TILLER SETUP for all gases
      ! --------------------------
      ! tiller # = phenology state x root mass / tiller_weight
      !
      ! We assume that 1/2 of Cpool_green is fine root mass
      ! we scale this with tiller_weight in mol C / m2
      tillers = (LAI / LAI_max) * (Cpool_green * 0.5_dp / tiller_weight)

      IF (cover_type .LT. 12) THEN    ! tree and shrub PFTs
        tiller_por = tiller_por_tree
      ELSE
        tiller_por = tiller_por_grass
      END IF
      IF (iWetness .EQ. 1) THEN
        tiller_por = tiller_por * dry_ratio
      END IF
      tiller_por = MAX(tiller_por,tiller_por_min)

      DO iLayer = 1, mxlay_above_rock
        tiller_frac = tillers  * root_dist(iLayer) 
        tiller_area(iLayer) = MAX(0.0001_dp, tiller_radius ** 2._dp * pi * tiller_frac * tiller_por)
      END DO

    END SUBROUTINE plant_setup

! -----------------------------------------------------------------------------------------------------------    
    SUBROUTINE plant_transport(GAS_type, mxlay_above_rock, mxlay_above_wt, Tsoil, &
                                layer_thick, layer_depth, relative_porevol, &
                                dens2conc, conc2dens, tiller_area, D_GAS, GAS_conc_atm, GAS_dens, &
                                GAS_Plant)
                                  
      ! plant transport for GAS
      ! determines GAS transported through plants
    
      IMPLICIT NONE
      INTEGER,                INTENT(IN)    :: GAS_type           ! GAS to be considered: 1=CH4, 2=CO2, 3=O2
      INTEGER,                INTENT(IN)    :: mxlay_above_rock   ! layer number above bedrock
      INTEGER,                INTENT(IN)    :: mxlay_above_wt     ! layer number above water table
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Tsoil              ! [K] Soil temperature
      REAL(dp), DIMENSION(:), INTENT(IN)    :: layer_thick        ! [m] soil layer thickness
      REAL(dp), DIMENSION(:), INTENT(IN)    :: layer_depth        ! [m] soil layer depth
      REAL(dp), DIMENSION(:), INTENT(IN)    :: relative_porevol   ! [-] relative pore volume in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dens2conc          ! [-] conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: conc2dens          ! [-] conversion factor from concentration to density 
      REAL(dp), DIMENSION(:), INTENT(IN)    :: tiller_area        ! area of tillers corresponding to the root fraction in each layer
      REAL(dp),               INTENT(IN)    :: D_GAS              ! [m2 s-1] Diffusivity of GAS (using SURFACE AIR diffusivity for the moment)
      REAL(dp),               INTENT(IN)    :: GAS_conc_atm       ! [mol m-3] GAS concentration in atmosphere
      REAL(dp), DIMENSION(:), INTENT(IN)    :: GAS_dens           ! [mol m-2] GAS density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: GAS_Plant          ! [mol m-2 timestep-1] GAS density transported by plants per layer
      
      
      ! locals
      REAL(dp), DIMENSION(mxlay_above_rock) :: GAS_conc           ! [mol m-3] GAS concentration in ice free pore space of layer
      REAL(dp), DIMENSION(mxlay_above_rock) :: GAS_conc_gaseous   ! [mol m-3] GAS concentration in gaseous form
      REAL(dp), DIMENSION(mxlay_above_rock) :: kHCC               ! [-] Henry factor relating gaseous to aqueous concentration
      REAL(dp), DIMENSION(mxlay_above_rock) :: effective_layer_volume   ! [m3] effective volume of layer
      REAL(dp)                              :: J                  ! [mol m-2 s-1] GAS flux in layer
      REAL(dp), PARAMETER                   :: root_length_ratio = 3.0_dp  ! [m m-1] ratio of root length to depth
      INTEGER                               :: iLayer             ! layer counter
      
      GAS_conc = 0._dp
      GAS_Plant = 0._dp
      
      effective_layer_volume = conc2dens(1:mxlay_above_rock)
      
      kHCC = determine_Henry_cc(GAS_type, mxlay_above_rock, Tsoil(1:mxlay_above_rock))
      
      ! Convert GAS densities [mol layer-1] to concentrations [mol m-3]
      GAS_conc(1:mxlay_above_rock) = GAS_dens(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
      
      ! determine concentration of gas in gaseous form: Below water table this is GAS_conc/kHCC
      GAS_conc_gaseous = GAS_conc
      GAS_conc_gaseous(mxlay_above_wt+1:mxlay_above_rock) = GAS_conc(mxlay_above_wt+1:mxlay_above_rock) / & 
                                                                              kHCC(mxlay_above_wt+1:mxlay_above_rock)
      
      DO iLayer = 1, mxlay_above_rock
        IF (relative_porevol(iLayer) .GT. minimum_porevol) THEN
          J = -D_GAS * tiller_area(iLayer) * (GAS_conc_gaseous(iLayer) - GAS_conc_atm) / (layer_depth(iLayer) * root_length_ratio)
          GAS_Plant(iLayer) = J * delta_time * (effective_layer_volume(iLayer) / layer_thick(iLayer))
        END IF
      END DO

    END SUBROUTINE plant_transport
    
! -----------------------------------------------------------------------------------------------------------
    FUNCTION dissolved_gas(GAS_type, nLayer, Tsoil, GAS_dens, dens2conc) RESULT(dissolved_GAS_dens)
    
      ! determine gas concentration in water
      ! based on Henry's law, as described by Wania
      
      IMPLICIT NONE
      INTEGER,                INTENT(IN)  :: GAS_type             ! GAS to be considered: 1=CH4, 2=CO2, 3=O2
      INTEGER,                INTENT(IN)  :: nLayer               ! number of layers
      REAL(dp), DIMENSION(:), INTENT(IN)  :: Tsoil                ! [K] Soil temperature in layer
      REAL(dp), DIMENSION(:), INTENT(IN)  :: GAS_dens             ! [mol] GAS density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(IN)  :: dens2conc            ! [-] conversion factor from density to concentration
      
      ! locals
      REAL(dp), DIMENSION(nLayer) :: GAS_concentration            ! [mol m-3] concentration of GAS in layer
      REAL(dp), DIMENSION(nLayer) :: kHCC                         ! dimensionless Henry coefficient relating aqueous to gaseous concentration
      REAL(dp), DIMENSION(nLayer) :: GAS_conc_diss                ! [mol m-3] concentration of GAS dissolved in water
      REAL(dp), DIMENSION(nLayer) :: dissolved_GAS_dens           ! [mol m-2] density of GAS dissolved in water
      
      GAS_concentration = GAS_dens(1:nLayer) * dens2conc(1:nLayer)
      
      kHCC = determine_Henry_cc(GAS_type, nLayer, Tsoil(1:nLayer))
      
      ! Henry's law: kHCC = ca/cg -> ca = kHCC * cg
      ! ca: aqueous concentration cg: gaseous concentration

      GAS_conc_diss = kHCC * GAS_concentration
      dissolved_GAS_dens = GAS_conc_diss / dens2conc(1:nLayer)
     
    END FUNCTION dissolved_gas
    
! -----------------------------------------------------------------------------------------------------------
    PURE FUNCTION determine_Henry_cc(GAS_type, nLayer, Tsoil) RESULT(kHCC)
    
      ! determine gas concentration in water
      ! based on Henry's law, as described by Wania
      
      IMPLICIT NONE
      INTEGER,                INTENT(IN) :: GAS_type              ! GAS to be considered: 1=CH4, 2=CO2, 3=O2
      INTEGER,                INTENT(IN) :: nLayer                ! number of layers
      REAL(dp), DIMENSION(:), INTENT(IN) :: Tsoil                 ! [K] Soil temperature in layer
      
      REAL(dp), DIMENSION(3), PARAMETER :: henry_k_inv = (/714.29_dp, 29.4_dp, 769.23_dp/)      ! [L atm mol-1] inverted Henry constant at 298K
      REAL(dp), DIMENSION(3), PARAMETER :: henry_const = (/1600.0_dp, 2400.0_dp, 1500.0_dp/)    ! [K-1] Coefficients in Henry's law (Sander 1999)
      
      REAL(dp)                          :: henry_coeff_inv        ! Henry's T dependent coefficient, inverted
      
      ! locals
      REAL(dp)                          :: henry_coeff            ! non-inverted Henry coefficient
      REAL(dp), DIMENSION(nLayer)       :: kHCC                   ! dimensionless Henry coefficient relating aqueous to gaseous concentration
      INTEGER                           :: iLayer
      
      kHCC = 0._dp
      
      IF ((GAS_type < 1) .OR. (GAS_type > 3)) THEN
        kHCC = -9999999999999999999999999999999999999._dp
      ELSE
        ! Calculate concentration of GAS in equilibrium with the
        ! atmosphere using Henry's law
        ! Henry's constant/coefficient depends on T
        ! UNITS: henry_k [L atm mol-1], const_GAS [K], T [K]
        ! henry_coeff_inv [L atm mol-1]
        ! -------------------------------------------------------
        
        DO iLayer = 1, nLayer
          henry_coeff_inv = henry_k_inv(GAS_type) * exp(-henry_const(GAS_type) * &
                            (1.0_dp / Tsoil(iLayer) - 1.0_dp / (tmelt + 25._dp)))
          henry_coeff = 1._dp / henry_coeff_inv
        
          ! Henry's law: kHCC = ca/cg -> ca = kHCC * cg
          ! ca: aqueous concentration cg: gaseous concentration
          kHCC(iLayer) = henry_coeff * Tsoil(iLayer) * UniversalGasConstant_atm_l
        END DO
      END IF

    END FUNCTION determine_Henry_cc
    
! -----------------------------------------------------------------------------------------------------------    
    SUBROUTINE ebullition(mxlay_above_rock, mxlay_above_wt, Tsoil, surface_air_pressure, &
                          Dz, relative_porevol, is_peatland, water_table, &
                          dens2conc, conc2dens, CH4_dens, CH4_Ebul)
                          
      ! ebullition of CH4
      ! determines CH4 transported through ebullition

      IMPLICIT NONE
      INTEGER,                INTENT(IN)    :: mxlay_above_rock       ! layer number above bedrock
      INTEGER,                INTENT(IN)    :: mxlay_above_wt         ! layer number above water table
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Tsoil                  ! [K] Soil temperature
      REAL(dp),               INTENT(IN)    :: surface_air_pressure   ! [Pa] = [N/m^2] = [1/101325 atm] surface air pressure
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Dz                     ! distance from soil layer above
      REAL(dp), DIMENSION(:), INTENT(IN)    :: relative_porevol       ! [-] relative pore volume in layer
      LOGICAL,                INTENT(IN)    :: is_peatland            ! peatland flag
      REAL(dp),               INTENT(IN)    :: water_table            ! [m] water table position
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dens2conc              ! [-] conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: conc2dens              ! [-] conversion factor from concentration to density 
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CH4_dens               ! [mol m-2] CH4 density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: CH4_Ebul               ! [mol m-2 timestep-1] CH4 density per layer transported by ebullition
      
      ! locals
      REAL(dp)                              :: CH4_diss_max           ! maximum concentration of dissolved CH4 [ml CH4 mlH2O]
      REAL(dp)                              :: CH4_diss_max_m3        ! [mol m-3] maximum dissolved CH4 concentration
      REAL(dp)                              :: CH4_diss_max_mol       ! [mol layer-1] maximum dissolved CH4 density
      
      ! Ebullition dissolution / gas
      REAL(dp), DIMENSION(mxlay_above_rock) :: CH4_gas                ! [mol] CH4 density as gas in layer
      REAL(dp), DIMENSION(mxlay_above_rock) :: CH4_diss               ! [mol] CH4 density dissolved in layer
      
      REAL(dp), DIMENSION(mxlay_above_rock) :: effective_layer_volume ! effective pore volume of layer
      
      REAL(dp)                              :: water_height           ! height of water at current layer
      REAL(dp)                              :: hydro_press            ! [Pa] hydrostatic pressure caused by water above layer
      INTEGER                               :: iLayer                 ! layer counter
      
      LOGICAL                               :: newebul_flag           ! swich to Wania's new ebullotion scheme
      REAL(dp), PARAMETER                   :: vgc_high = 0.15_dp
      REAL(dp), PARAMETER                   :: vgc_low = 0.145_dp
      REAL(dp), PARAMETER                   :: bubble_CH4_frac = 0.57_dp
      
      REAL(dp)                              :: CH4_gas_vol
      REAL(dp)                              :: CH4_ebul_vol
      REAL(dp)                              :: CH4_vgc
      
      newebul_flag = .FALSE.
      
      effective_layer_volume = conc2dens(1:mxlay_above_rock)
      CH4_Ebul = 0._dp
      CH4_diss = 0._dp
      CH4_gas = 0._dp
      
      ! water height is >= 0
      ! water table should be > 0 in inundated areas, <= 0 in peatlands
      ! water height is height of wt above surface
      water_height = MAX(water_table, 0._dp)
      
      CH4_diss = dissolved_gas(1, mxlay_above_rock, Tsoil, CH4_dens, dens2conc)
      CH4_gas = CH4_dens(1:mxlay_above_rock) - CH4_diss
      
      ! SOLUBILITY OF CH4
      ! -----------------
      ! Estimate how much methane can be dissolved at current T
      ! from Yamamoto et al. 1976. Yamamoto's relationship
      ! holds only up to about 37 degrees, after which the
      ! dissolubility increases again when using the eqn below.
      ! UNITS: [ml CH4 per ml H20]
      
      DO iLayer = mxlay_above_wt+1, mxlay_above_rock
        CH4_diss_max = 0.05708_dp - 0.001545_dp * (max(tmelt, Tsoil(iLayer)) - tmelt) + &
                        0.00002069_dp * ((max(tmelt, Tsoil(iLayer)) - tmelt) ** 2._dp) ![ml CH4 ml-1 H2O]

        ! below water table: increase water_height by layer thickness
        IF (iLayer .GT. mxlay_above_wt) THEN
          water_height = water_height + Dz(iLayer)  ![m]
        END IF
        
        ! Calculate hydrostatic pressure
        hydro_press = rhoh2o * grav * water_height ![kg m s-2 or N]

        ! [mL CH4 mL-1 H2O] is equivalent to [m3 CH4 m-3 H2O in soil] 
        ! To calculate the volume of CH4 per layer, multiply by the
        ! the layer's water content V_water.
        ! We use effective_layer_volume
        ! -----------------------------------------------------------
        CH4_diss_max_m3 = CH4_diss_max * effective_layer_volume(iLayer) ![m3 CH4 layer-1]

        ! Use the Ideal Gas Law to convert [m3 CH4 layer-1] to
        ! [mol CH4 layer-1]
        ! Add hydrostatic pressure to atmospheric pressure.
        ! pressure is in [Pa], which is [N m-2], so hydro_press
        ! has to be divided by 1m2 to have the units [N m-2] or [Pa]
        ! ----------------------------------------------------------
        CH4_diss_max_mol = CH4_diss_max_m3 * (surface_air_pressure + hydro_press) / (UniversalGasConstant * Tsoil(iLayer)) ![mol CH4 layer-1]

        ! If the total density of CH4 is higher than what can be
        ! dissolved in the given water volume times the
        ! threshold for bubble initiation, then increase
        ! the gaseous CH4 pool.
        ! Units for concentrations are in [g CH4-C layer-1]
        ! Units for volume is in [m3]
        ! ------------------------------------------------------
        ! determine dissolved CH4
        IF (newebul_flag) THEN
          CH4_diss(iLayer) = MIN(CH4_dens(iLayer), CH4_diss_max_mol) ![mol CH4 layer-1]
        
          ! determine CH4 as gas in layer
          CH4_gas(iLayer) = CH4_dens(iLayer) - CH4_diss(iLayer) ![mol CH4 m-2]
        
          ! ebullition flux is gas density in layer (but negative as flux removes from soil)
          CH4_Ebul(iLayer) = -CH4_gas(iLayer) ! [mol CH4 layer-1 timestep-1] 
          CH4_gas(iLayer) = 0.0
        ELSE
          CH4_gas_vol = CH4_gas(iLayer) * ((UniversalGasConstant * Tsoil(iLayer)) / &
                        (surface_air_pressure + hydro_press))
          CH4_vgc = CH4_gas_vol / effective_layer_volume(iLayer)

          IF (CH4_vgc > vgc_high*bubble_CH4_frac) THEN
            CH4_ebul_vol = (CH4_vgc - (vgc_low*bubble_CH4_frac)) * effective_layer_volume(iLayer)
            CH4_vgc = vgc_low*bubble_CH4_frac
            CH4_gas_vol = CH4_vgc * effective_layer_volume(iLayer)
            CH4_gas(iLayer) = CH4_gas_vol / ((UniversalGasConstant * Tsoil(iLayer)) / &
                              (surface_air_pressure + hydro_press))
            
            CH4_Ebul(iLayer) = -CH4_ebul_vol / ((UniversalGasConstant * Tsoil(iLayer)) / &
                                      (surface_air_pressure + hydro_press))
          END IF
          
          IF (CH4_Ebul(iLayer) > 0._dp) THEN
            WRITE(message_text,*) 'Ebullition positive in layer ', iLayer
            CALL message('update_methane', message_text, all_print=.TRUE., level=em_warn)
            WRITE(message_text,*) 'ebulvol vgc gasvol gas ebul ', CH4_ebul_vol, CH4_vgc, CH4_gas_vol, CH4_gas(iLayer), CH4_Ebul(iLayer)
            CALL message('update_methane', message_text, all_print=.TRUE., level=em_warn)
          END IF
        END IF
        
      END DO
      
      ! ebullition flux SHOULD be added to soil just above water table, if wt is below surface
      ! done in reaction-diffusion
    END SUBROUTINE ebullition
    
!--------------------------------------------------------------------------
    SUBROUTINE reaction_diffusion(mxlay_above_rock, mxlay_above_wt, Tsoil,                                &
                          layer_thick, relative_porevol, dens2conc, conc2dens,                            &
                          CH4_dens, CO2_dens, O2_dens,                                                    &
                          CH4_Prod, CO2_Prod, CH4_Oxid, CO2_Oxid, O2_Other, O2_Oxid,                      &
                          CH4_Ebul, CH4_Plant, CO2_Plant, O2_Plant, D_CH4, D_CO2, D_O2,                   &
                          D_CH4_surf, D_CO2_surf, D_O2_surf, surf_CH4_conc, surf_CO2_conc, surf_O2_conc,  &
                          surf_CH4_flux, surf_CO2_flux, surf_O2_flux, D_used)
                          
      ! reaction-diffusion for all soil layers and all gases
      
      IMPLICIT NONE

      INTEGER,                INTENT(IN)    :: mxlay_above_rock       ! layer number above bedrock
      INTEGER,                INTENT(IN)    :: mxlay_above_wt         ! layer number above water table
      REAL(dp), DIMENSION(:), INTENT(IN)    :: Tsoil                  ! [K] Soil temperature
      REAL(dp), DIMENSION(:), INTENT(IN)    :: layer_thick            ! soil layer thickness
      REAL(dp), DIMENSION(:), INTENT(IN)    :: relative_porevol       ! [-] relative pore volume in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dens2conc              ! [-] conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: conc2dens              ! [-] conversion factor from concentration to density 
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CH4_dens               ! [mol m-2] CH4 density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CO2_dens               ! [mol m-2] CO2 density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: O2_dens                ! [mol m-2] O2 density in ice free pore space of layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CH4_Prod               ! [mol m-2 timestep-1] CH4 production in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CO2_Prod               ! [mol m-2 timestep-1] CO2 production in layer
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CH4_Oxid               ! [mol m-2 timestep-1] CH4 removal through oxidation in layer
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CO2_Oxid               ! [mol m-2 timestep-1] CO2 production from oxidation in layer
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: O2_Other               ! [mol m-2 timestep-1] O2 consumption through other processes
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: O2_Oxid                ! [mol m-2 timestep-1] O2 consumption through oxidation of CH4
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CH4_Ebul               ! [mol m-2 timestep-1] CH4 flux by ebullition on layers
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: CH4_Plant              ! [mol m-2 timestep-1] CH4 plant flux on layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: CO2_Plant              ! [mol m-2 timestep-1] CO2 plant flux on layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: O2_Plant               ! [mol m-2 timestep-1] O2 plant flux on layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: D_CH4                  ! [m2 s-1] diffusivity of CH4 on layers
      REAL(dp), DIMENSION(:), INTENT(IN)    :: D_CO2                  ! [m2 s-1] diffusivity of CO2 on layers
      REAL(dp), DIMENSION(:), INTENT(IN)    :: D_O2                   ! [m2 s-1] diffusivity of O2 on layers
      REAL(dp),               INTENT(IN)    :: D_CH4_surf             ! [m2 s-1] diffusivity of CH4 on surface
      REAL(dp),               INTENT(IN)    :: D_CO2_surf             ! [m2 s-1] diffusivity of CO2 on surface
      REAL(dp),               INTENT(IN)    :: D_O2_surf              ! [m2 s-1] diffusivity of O2 on surface
      REAL(dp),               INTENT(IN)    :: surf_CH4_conc          ! [mol m-3] concentration of CH4 on surface
      REAL(dp),               INTENT(IN)    :: surf_CO2_conc          ! [mol m-3] concentration of CO2 on surface
      REAL(dp),               INTENT(IN)    :: surf_O2_conc           ! [mol m-3] concentration of O2 on surface
      REAL(dp),               INTENT(OUT)   :: surf_CH4_flux          ! [mol m-2 timestep-1] CH4 flux on surface
      REAL(dp),               INTENT(OUT)   :: surf_CO2_flux          ! [mol m-2 timestep-1] CO2 flux on surface
      REAL(dp),               INTENT(OUT)   :: surf_O2_flux           ! [mol m-2 timestep-1] O2 flux on surface
      REAL(dp), DIMENSION(:), INTENT(OUT)   :: D_used
      
      ! locals
      REAL(dp), DIMENSION(mxlay_above_rock) :: Di                     ! [m2 s-1] diffusivity of GAS on layers used
      REAL(dp) :: O2_demand                                           ! [mol m-2 timestep-1] O2 demand in layer
      REAL(dp) :: O2_stress                                           ! O2 stress factor
      REAL(dp) :: CH4_demand                                          ! [mol m-2 timestep-1] CH4 demand in layer
      REAL(dp) :: CH4_Ebul_sum                                        ! [mol m-2 timestep-1] total Ch4 transported by ebullition
      REAL(dp) :: CH4_stress                                          ! CH4 stress factor
      REAL(dp), DIMENSION(mxlay_above_rock) :: CH4_source             ! [mol m-2 timestep-1] CH4 source / sink on layer
      REAL(dp), DIMENSION(mxlay_above_rock) :: CO2_source             ! [mol m-2 timestep-1] CO2 source / sink on layer
      REAL(dp), DIMENSION(mxlay_above_rock) :: O2_source              ! [mol m-2 timestep-1] O2 source / sink on layer
      REAL(dp), DIMENSION(mxlay_above_rock) :: kHCC                   ! dimensionless Henry coefficient relating aqueous to gaseous concentration
      INTEGER :: iLayer
      
      CH4_source = 0._dp
      CO2_source = 0._dp
      O2_source = 0._dp
      
      DO iLayer = 1,mxlay_above_rock
        O2_demand = -(O2_Oxid(iLayer) + O2_Other(iLayer))   ! O2_Oxid and O2_Other are defined negative
        O2_stress = 1._dp
        IF (O2_demand > 0._dp) THEN
          O2_stress = MIN((O2_dens(iLayer) + O2_Plant(iLayer)) / O2_demand, 1._dp)
        END IF
        
        CH4_demand = -(CH4_Oxid(iLayer) + CH4_Plant(iLayer) + CH4_Ebul(iLayer))  ! demand variables are defined negative
        CH4_stress = 1._dp
        IF (CH4_demand > 0._dp) THEN
          CH4_stress = MIN((CH4_dens(iLayer) + CH4_Prod(iLayer)) / CH4_demand, 1._dp)
        END IF
        
        ! resolve oxidation stress
        IF (CH4_stress <= O2_stress) THEN   ! CH4 limited
          IF (O2_stress < 1) THEN
            O2_demand = -O2_Other(iLayer)   ! O2_Oxid and O2_Other are defined negative
            O2_stress = 1._dp
            IF (O2_demand > 0._dp) THEN
              O2_stress = MIN((O2_dens(iLayer) + O2_Plant(iLayer) + &   ! should be -, but O2_oxid defined negative
                          (CH4_stress * O2_Oxid(iLayer))) / O2_demand, 1._dp)
            END IF
          END IF
          CH4_Oxid(iLayer) = CH4_Oxid(iLayer) * CH4_stress
          O2_Oxid(iLayer) = O2_Oxid(iLayer) * CH4_stress
        ELSE    ! O2 limited
          IF (CH4_stress < 1) THEN
            CH4_demand = -(CH4_Ebul(iLayer) + CH4_Plant(iLayer))
            CH4_stress = 1._dp
            IF (CH4_demand > 0._dp) THEN
              CH4_stress = MIN((CH4_dens(iLayer) + CH4_Prod(iLayer) + &   ! should be -, but CH4_oxid defined negative
                            (O2_stress * CH4_Oxid(iLayer))) / CH4_demand, 1._dp)
            END IF
          END IF
          CH4_Oxid(iLayer) = CH4_Oxid(iLayer) * O2_stress
          O2_Oxid(iLayer) = O2_Oxid(iLayer) * O2_stress
        END IF
        CO2_Oxid(iLayer) = -CH4_Oxid(iLayer)
        CH4_Ebul(iLayer) = CH4_Ebul(iLayer) * CH4_stress
        CH4_Plant(iLayer) = CH4_Plant(iLayer) * CH4_stress
        O2_Other(iLayer) = O2_Other(iLayer) * O2_stress
        
        IF (O2_stress < 0._dp) THEN
          WRITE(message_text,*) 'O2 stress negative in layer ', iLayer
          CALL message('update_methane', message_text, all_print=.TRUE., level=em_warn)
        END IF
        IF (CH4_stress < 0._dp) THEN
          WRITE(message_text,*) 'CH4 stress negative in layer ', iLayer
          CALL message('update_methane', message_text, all_print=.TRUE., level=em_warn)
        END IF
      END DO   ! iLayer
      
      ! add density from CH4 ebullition to layer above water table, if water table is below surface
      CH4_Ebul_sum = SUM(CH4_Ebul(1:mxlay_above_rock))   ! this is NEGATIVE, since CH4_Ebul is defined negative
      IF (mxlay_above_wt > 0) THEN
        CH4_Ebul(mxlay_above_wt) = CH4_Ebul(mxlay_above_wt)-CH4_Ebul_sum
        CH4_Ebul_sum = 0._dp
      END IF
      
      CH4_source = (CH4_Prod(1:mxlay_above_rock) + CH4_Oxid(1:mxlay_above_rock) + &
                    CH4_Plant(1:mxlay_above_rock) + CH4_Ebul(1:mxlay_above_rock))
      CO2_source = (CO2_Prod(1:mxlay_above_rock) + CO2_Oxid(1:mxlay_above_rock) + CO2_Plant(1:mxlay_above_rock))
      O2_source = (O2_Other(1:mxlay_above_rock) + O2_Oxid(1:mxlay_above_rock) + O2_Plant(1:mxlay_above_rock))
      
      ! diffusion calculation: CH4
      
      ! set up diffusion coefficients
      Di(1:mxlay_above_rock) = D_CH4(1:mxlay_above_rock)
      
      kHCC = determine_Henry_cc(1, mxlay_above_rock, Tsoil(1:mxlay_above_rock))
      
      CALL diffusion_cn(1, mxlay_above_rock, mxlay_above_wt, CH4_dens, surf_CH4_conc, surf_CH4_flux, &
                        CH4_source, kHCC, Di, D_CH4_surf, layer_thick, dens2conc, conc2dens)
      
      ! diffusion calculation: CO2
      
      ! set up diffusion coefficients
      Di(1:mxlay_above_rock) = D_CO2(1:mxlay_above_rock)
      
      D_used(1:mxlay_above_rock) = Di(1:mxlay_above_rock)
      kHCC = determine_Henry_cc(2, mxlay_above_rock, Tsoil(1:mxlay_above_rock))
      
      CALL diffusion_cn(2, mxlay_above_rock, mxlay_above_wt, CO2_dens, surf_CO2_conc, surf_CO2_flux, &
                        CO2_source, kHCC, Di, D_CO2_surf, layer_thick, dens2conc, conc2dens)
      
      
      ! diffusion calculation: O2
      
      ! set up diffusion coefficients
      Di(1:mxlay_above_rock) = D_O2(1:mxlay_above_rock)
      kHCC = determine_Henry_cc(3, mxlay_above_rock, Tsoil(1:mxlay_above_rock))
      
      CALL diffusion_cn(3, mxlay_above_rock, mxlay_above_wt, O2_dens, surf_O2_conc, surf_O2_flux, &
                        O2_source, kHCC, Di, D_O2_surf, layer_thick, dens2conc, conc2dens)
      
      
    END SUBROUTINE reaction_diffusion

!--------------------------------------------------------------------------
    SUBROUTINE diffusion_cn(GAS_type, mxlay_above_rock, mxlay_above_wt,         &
                            GAS_dens, surf_GAS_conc, surf_GAS_flux,             &
                            GAS_source, kHCC, diff_coeff, &
                            diff_coeff_surf, layer_thick, dens2conc, conc2dens)

      IMPLICIT NONE

      INTEGER,                INTENT(IN)    :: GAS_type           ! GAS to be considered: 1=CH4, 2=CO2, 3=O2
      INTEGER ,               INTENT(IN)    :: mxlay_above_rock   ! layer number above bedrock
      INTEGER,                INTENT(IN)    :: mxlay_above_wt     ! layer number above water table
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: GAS_dens           ! [mol m-2] GAS density in layer
      REAL(dp),               INTENT(IN)    :: surf_GAS_conc      ! [mol m-3] GAS concentration at surface
      REAL(dp),               INTENT(OUT)   :: surf_GAS_flux      ! [mol m-2 timestep-1] GAS flux through surface
      REAL(dp), DIMENSION(:), INTENT(IN)    :: GAS_source         ! [mol m-2 timestep-1] GAS source / sink in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: kHCC               ! dimensionless Henry coefficient relating aqueous to gaseous concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: diff_coeff         ! [m2 s-1] Layer diffusion coefficients
      REAL(dp),               INTENT(IN)    :: diff_coeff_surf    ! [m2 s-1] surface diffusion coefficient
      REAL(dp), DIMENSION(:), INTENT(IN)    :: layer_thick        ! [m] Layer thickness
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dens2conc          ! [-] conversion factor from density to concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: conc2dens          ! [-] conversion factor from concentration to density 

      ! locals
      
      ! For diffusion calculation, we use a different layer counting scheme:
      ! We add a surface layer at atmospheric CH4 concentration, therefore 
      ! all soil layers are moved down by one
      ! surface layer has same thickness as first belowsurface layer
      
      ! layer counters
      INTEGER :: outside_layer, iLayer, num_iLayers
      INTEGER  :: iStep, nStep
      REAL(dp) :: nStep_fac
      
      ! local vectors of concentrations, cofficients, depths -- one element longer to consider surface state as well
      REAL(dp), DIMENSION(mxlay_above_rock+1) :: GAS_conc_loc              ! [mol m-3] GAS concentration
      REAL(dp), DIMENSION(mxlay_above_rock+1) :: src_GAS_conc_loc          ! [mol m-3] source GAS concentration

      REAL(dp), DIMENSION(mxlay_above_rock+1) :: kHCC_loc                  ! [-] Henry coefficient
      REAL(dp), DIMENSION(mxlay_above_rock+1) :: diff_coeff_loc            ! [m2 s-1] diffusivity
      REAL(dp), DIMENSION(mxlay_above_rock+1) :: dz_loc                    ! [m] layer thickness
      
      ! bookkeeping
      REAL(dp)  :: tot_dens_initial      ! [mol m-2] total GAS density in soil column before diffusion
      REAL(dp)  :: tot_dens_final        ! [mol m-2] total GAS density in soil column after diffusion
      REAL(dp)  :: tot_dens_source       ! [mol m-2] total GAS density in soil column 
                                                                            ! from sources and sinks
      REAL(dp)  :: delta_time_loc
      
      nStep = methane_options%diffusion_stepnum    ! change to add more diffusion steps per time step
      nStep_fac = dble(nStep)
      ! initialisation
      num_iLayers = mxlay_above_rock + 1
      
      ! concentration / density conversions
      GAS_conc_loc(1) = surf_GAS_conc
      GAS_conc_loc(2:mxlay_above_rock+1) = GAS_dens(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
      src_GAS_conc_loc(1) = 0._dp
      src_GAS_conc_loc(2:mxlay_above_rock+1) = GAS_source(1:mxlay_above_rock) * dens2conc(1:mxlay_above_rock)
      
      ! totals for balance checks
      tot_dens_initial = SUM(GAS_dens(1:mxlay_above_rock))
      tot_dens_source = SUM(GAS_source(1:mxlay_above_rock))
      
      kHCC_loc(1) = kHCC(1)
      kHCC_loc(2:mxlay_above_rock+1) = kHCC(1:mxlay_above_rock)
      diff_coeff_loc(1) = diff_coeff_surf
      diff_coeff_loc(2:mxlay_above_rock+1) = diff_coeff(1:mxlay_above_rock)
      dz_loc(1) = layer_thick(1)
      dz_loc(2:mxlay_above_rock+1) = layer_thick(1:mxlay_above_rock)
      
      delta_time_loc = delta_time / nStep_fac
      src_GAS_conc_loc = src_GAS_conc_loc / nStep_fac
      
      DO iStep = 1, nStep
        CALL diffusion_step_variable(num_iLayers, mxlay_above_wt, GAS_conc_loc, src_GAS_conc_loc, &
                                     kHCC_loc, diff_coeff_loc, dz_loc, delta_time_loc)
      END DO

      !------------------------------------------------------------
      ! final balance and output flux
      GAS_dens(1:mxlay_above_rock) = GAS_conc_loc(2:mxlay_above_rock+1) * conc2dens(1:mxlay_above_rock)

      ! negative densities might be possible --> reset to zero, difference will be added to surface flux
      IF (ANY(GAS_dens(1:mxlay_above_rock) < 0._dp)) THEN
        WHERE (GAS_dens(1:mxlay_above_rock) < 0._dp)
          GAS_dens(1:mxlay_above_rock) = 0._dp
        END WHERE
      END IF
      tot_dens_final = SUM(GAS_dens(1:mxlay_above_rock))
      
      surf_GAS_flux = tot_dens_final - (tot_dens_initial + tot_dens_source)
    END SUBROUTINE diffusion_cn

!-----------------------------------------------------------------------------
! diffusion_step_variable 
! should allow variable set up of implicit / explicit 
! contributions to diffision problem
!
    SUBROUTINE diffusion_step_variable(num_iLayers, mxlay_above_wt, GAS_conc_loc, src_GAS_conc_loc, &
                                       kHCC_loc, diff_coeff_loc, dz_loc, delta_time_loc)
    
      IMPLICIT NONE

      INTEGER ,               INTENT(IN)    :: num_iLayers        ! no. of internal layers
      INTEGER,                INTENT(IN)    :: mxlay_above_wt     ! (outside) layer number above water table
      REAL(dp), DIMENSION(:), INTENT(INOUT) :: GAS_conc_loc       ! [mol m-3] GAS concentration in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: src_GAS_conc_loc   ! [mol m-3] source GAS concentration in layer
      REAL(dp), DIMENSION(:), INTENT(IN)    :: kHCC_loc           ! dimensionless Henry coefficient relating aqueous to gaseous concentration
      REAL(dp), DIMENSION(:), INTENT(IN)    :: diff_coeff_loc     ! [m2 s-1] Layer diffusion coefficients
      REAL(dp), DIMENSION(:), INTENT(IN)    :: dz_loc             ! [m] Layer thickness
      REAL(dp),               INTENT(IN)    :: delta_time_loc     ! [s] time step length

      ! locals
      
      ! For diffusion calculation, we use a different layer counting scheme:
      ! We add a surface layer at atmospheric CH4 concentration, therefore 
      ! all soil layers are moved down by one
      ! surface layer has same thickness as first belowsurface layer
      
      ! layer counters
      INTEGER :: outside_layer, iLayer

      ! Diffusion constants averaged over adjacent layers.
      REAL(dp) :: D_below, D_above

      ! Layer-dependent weighting factors in Crank-Nicholson scheme.
      REAL(dp) :: dz_factor, W_below, W_above
      REAL(dp) :: dz_here, dz_above, dz_below
      REAL(dp) :: C_here, C_above, C_below

      ! diagonal, left and right subdiagonals for Crank-Nicholson matrix
      REAL(dp), DIMENSION(num_iLayers) :: left
      REAL(dp), DIMENSION(num_iLayers) :: diag
      REAL(dp), DIMENSION(num_iLayers) :: right

      ! Right hand side vector for Crank-Nicholson scheme equations
      ! This is overwritten with solution by dgtsv tridiagonal solver
      REAL(dp), DIMENSION(num_iLayers) :: rhs
      
      ! implicit contribution to C-N integration
      REAL(dp) :: implicit_contrib
      
      ! bookkeeping

      REAL(dp)                                    :: correction                 ! [mol m-2] correction from inaccuracies of CN-scheme
      INTEGER                                     :: INFO                  ! dgtsv status variable      
      LOGICAL                                     :: consider_aqueous      ! switch to consider aqueous concentrations at interface
    
      consider_aqueous = .TRUE.
      implicit_contrib = methane_options%implicit_contrib
      
      !------------------------------------------------------------
      ! build tridiagonal matrix and known right hand side

      ! Process the local layers
      DO iLayer = 1, num_iLayers
        ! outside layers are shifted by one
        outside_layer = iLayer-1

        ! Extract sensible values to use for concentration and
        ! thickness of the current layer, the layer above and below
        dz_here = dz_loc(iLayer)
        C_here = GAS_conc_loc(iLayer)
        IF (iLayer .EQ. 1) THEN
          dz_above = 0._dp
          C_above = 0._dp
        ELSE
          dz_above = dz_loc(iLayer-1)
          C_above = GAS_conc_loc(iLayer-1)
          ! just below water table: use aqueous concentration of gas
          IF ((outside_layer .EQ. mxlay_above_wt+1) .AND. consider_aqueous) THEN
            C_above = C_above*kHCC_loc(iLayer-1)
          END IF
        END IF
        IF (iLayer .EQ. num_iLayers) THEN
          dz_below = 0._dp
          C_below = 0._dp
        ELSE
          dz_below = dz_loc(iLayer+1)
          C_below = GAS_conc_loc(iLayer+1)
        END IF

        ! Determine diffusion coefficients to the layers above and below the current layer.
        IF (iLayer .EQ. 1) THEN
          ! upwards diffusivity in uppermost layer is zero
          D_above = 0._dp
        ELSE
          ! for the layers below, upwards diffusivity is the weighted mean of the layer 
          ! diffusivity in layer and layer above
          D_above = (dz_loc(iLayer-1)*diff_coeff_loc(iLayer-1) + &
                      dz_loc(iLayer)*diff_coeff_loc(iLayer)) / &
                    (dz_loc(iLayer-1) + dz_loc(iLayer))
          IF ((outside_layer .EQ. mxlay_above_wt+1) .AND. consider_aqueous) THEN
            D_above = (dz_loc(iLayer-1)*(diff_coeff_loc(iLayer-1)/kHCC_loc(iLayer-1)) + &
                        dz_loc(iLayer)*diff_coeff_loc(iLayer)) / &
                      (dz_loc(iLayer-1) + dz_loc(iLayer))
          END IF
        END IF
        IF (iLayer .EQ. num_iLayers) THEN
          ! downwards diffusivity in the bottom layer is set to zero
          ! to impose no flux boundary condition
          D_below = 0._dp
        ELSE
          ! for the layers above, downwards diffusivity is the weighted mean of the 
          ! diffusivity in the layer and the layer below
          D_below = (dz_loc(iLayer)*diff_coeff_loc(iLayer) + &
                      dz_loc(iLayer+1)*diff_coeff_loc(iLayer+1)) / &
                    (dz_loc(iLayer) + dz_loc(iLayer+1))
          IF ((outside_layer .EQ. mxlay_above_wt) .AND. consider_aqueous) THEN
            D_below = (dz_loc(iLayer)*(diff_coeff_loc(iLayer)/kHCC_loc(iLayer)) + &
                        dz_loc(iLayer+1)*diff_coeff_loc(iLayer+1)) / &
                      (dz_loc(iLayer) + dz_loc(iLayer+1))
          END IF
        END IF

        ! Calculate layer-dependent weighting factors.
        dz_factor = 0.25_dp * (dz_below + 2._dp * dz_here + dz_above)
        W_below = D_below * (delta_time_loc / dz_factor) * (2._dp / (dz_below + dz_here))
        W_above = D_above * (delta_time_loc / dz_factor) * (2._dp / (dz_here + dz_above))

        ! boundary conditions for surface and bottom layers: no flux through top / bottom
        IF (iLayer .EQ. 1) THEN
          W_above = 0._dp
        END IF
        IF (iLayer .EQ. num_iLayers) THEN
          W_below = 0._dp
        END IF
        
        ! Fill in matrix diagonal and off-diagonal elements.
        diag(iLayer) = 1.0_dp + (implicit_contrib * (W_below + W_above))
        IF ((outside_layer .EQ. mxlay_above_wt) .AND. consider_aqueous) THEN
          diag(iLayer) = 1.0_dp + (implicit_contrib * (W_below*kHCC_loc(iLayer) + W_above))
        END IF
        left(iLayer) = -implicit_contrib * W_above
        IF ((outside_layer .EQ. mxlay_above_wt + 1) .AND. consider_aqueous) THEN
          left(iLayer) = -implicit_contrib * W_above*kHCC_loc(iLayer-1)
        END IF
        right(iLayer) = -implicit_contrib * W_below

        ! Calculate right hand side vector values.
        rhs(iLayer) = (1.0_dp - (1.0_dp - implicit_contrib)*(W_below + W_above)) * C_here + &
                      (1.0_dp - implicit_contrib)*W_below*C_below +                         &
                      (1.0_dp - implicit_contrib)*W_above*C_above +                         &
                       src_GAS_conc_loc(iLayer)
        IF ((outside_layer .EQ. mxlay_above_wt) .AND. consider_aqueous) THEN
          rhs(iLayer) = (1.0_dp - (1.0_dp - implicit_contrib)*((W_below*kHCC_loc(iLayer)) + W_above))*C_here + &
                        (1.0_dp - implicit_contrib)*W_below*C_below +                       &
                        (1.0_dp - implicit_contrib)*W_above*C_above +                       &
                         src_GAS_conc_loc(iLayer)
        END IF
      END DO
      
      ! Semi-implicit case -- whenever implicit_contrib > 0.1, 
      ! fully explicit case is solced already ( = rhs)
      IF (implicit_contrib >= 0.1_dp) THEN
        !------------------------------------------------------------
        ! solve tridiagonal system using dgtsv from NETLIB
        CALL dgtsv(num_iLayers, 1, left(2:num_iLayers), diag, &
                   right(1:num_iLayers-1), rhs, num_iLayers, INFO)
        IF (INFO .NE. 0) THEN
          WRITE(message_text,*) 'dgtsv INFO ', INFO
          CALL message('update_methane', message_text, all_print=.TRUE., level=em_warn)
        END IF
      END IF
      ! solution is ALWAYS written into the rhs vector, also in the fully explicit case
      GAS_conc_loc = rhs
      
    END SUBROUTINE diffusion_step_variable

! -----------------------------------------------------------------------------------------------------------
    FUNCTION concentration_vmr_2_mol_m3(GAS_vmr) RESULT(GAS_concentration)
      ! convert concentration from volume mixing ratio to mol/m3
      
      IMPLICIT NONE
      REAL(dp), INTENT(IN)    :: GAS_vmr                          ! Volume mixing ratio of gas
      
      ! locals
      REAL(dp)                :: GAS_concentration                ! [mol m-3] concentration of GAS
      REAL(dp), parameter     :: T_ref = 288.0_dp                 ! reference temperature [K]
      
      ! from ideal gas law: PV = nRT <=> V/n = RT/P <=> n = V/(RT/P)
      ! volume mixing ratio is molar mixing ratio (1 mol gas = constant volume, independent of gas)
      ! => determine # of moles in volume
      GAS_concentration = GAS_vmr / (UniversalGasConstant * T_ref / p_sealevel)
     
    END FUNCTION concentration_vmr_2_mol_m3

! -----------------------------------------------------------------------------------------------------------
    FUNCTION concentration_mmr_2_mol_m3(nland, GAS_mmr, molarMassGAS) RESULT(GAS_conc)
      ! convert concentration from mass mixing ratio to mol/m3
      
      USE mo_jsbach_constants, ONLY: molarMassDryAir_kg      
      
      IMPLICIT NONE
      INTEGER,  INTENT(in)    :: nland                            ! number of land points
      REAL(dp), INTENT(IN)    :: GAS_mmr(nland)                   ! Mass mixing ratio of gas
      REAL(dp), INTENT(IN)    :: molarMassGAS                     ! [kg mol-1] molar mass of gas
      
      ! locals
      REAL(dp)                :: GAS_conc(nland)                  ! [mol m-3] concentration of GAS
      REAL(dp), parameter     :: T_ref = 288.0_dp                 ! reference temperature [K]
      
      ! from ideal gas law: PV = nRT <=> V/n = RT/P
      ! volume mixing ratio is molar mixing ratio (1 mol gas = constant volume, independent of gas)
      ! => determine # of moles in volume
      GAS_conc(1:nland) = GAS_mmr(1:nland) * (molarMassDryAir_kg/molarMassGAS) &
                        / (UniversalGasConstant * T_ref / p_sealevel)
     
    END FUNCTION concentration_mmr_2_mol_m3

    
!-----------------------------------------------------------------------------
    SUBROUTINE update_methane_fire(nland, ntiles, CO2_fire_emission,    &
                                   cover_fract, cover_type,             &
                                   veg_fract_correction, veg_ratio_max, &
                                   methane)
                                   
      USE mo_jsbach_grid,      ONLY: kstart, kend           ! first and last value of kindex() 
      USE mo_jsbach_constants, ONLY: molarMassCO2_kg, molarMassCH4_kg, molarMassC_kg, C_2_biomass_ratio
      USE mo_jsbach,           ONLY: missing_value
    
      INTEGER,  INTENT(in) :: nland                                    ! number of land points
      INTEGER,  INTENT(in) :: ntiles                                   ! number of tiles
      REAL(dp), INTENT(in) :: CO2_fire_emission(nland)                 ! [kg(CO2)/m2(grid cell)/s] CO2 emissions from fire
      REAL(dp), INTENT(in) :: cover_fract(nland,ntiles)                ! tile cover fraction
      INTEGER,  INTENT(in) :: cover_type(nland,ntiles)                 ! tile cover type
      REAL(dp), INTENT(in) :: veg_fract_correction(nland,ntiles)       ! correction factor for area weighting factor to convert to grid cell average
      REAL(dp), INTENT(in) :: veg_ratio_max(nland)                     ! veg_ratio_max, needed for area weighting factor to convert to grid cell average
      TYPE(methane_type), INTENT(inout) :: methane                     ! structure with methane specific variables
      
      ! locals
      INTEGER             :: iLand, iLand_k, iTile
      INTEGER, PARAMETER  :: cover_type_max = 22
      
      REAL(dp), DIMENSION(nland) :: CH4_fire_emission_kg
      REAL(dp), DIMENSION(nland) :: CH4_fire_emission_mol
      REAL(dp), DIMENSION(nland) :: matter_burned_kg
      REAL(dp), DIMENSION(nland) :: NO_fire_emission_kg
      REAL(dp), DIMENSION(nland) :: CO_fire_emission_kg
      REAL(dp), DIMENSION(nland) :: iso_fire_emission_kg
      
      REAL(dp)                   :: efactor_CH4_tile_sum
      REAL(dp)                   :: efactor_NO_tile_sum
      REAL(dp)                   :: efactor_CO_tile_sum
      REAL(dp)                   :: efactor_iso_tile_sum
      
      ! locals
      ! CO2 emission factor from Kaiser et al., 2012, doi:10.5194/bg-9-527-2012
      REAL(dp), PARAMETER  :: efactor_CO2_SA = 1646._dp        ! [g(CO2)/kg(dry matter)] emission factor for savannah 
      REAL(dp), PARAMETER  :: efactor_CO2_TF = 1626._dp        ! [g(CO2)/kg(dry matter)] emission factor for tropical forest
      REAL(dp), PARAMETER  :: efactor_CO2_EF = 1572._dp        ! [g(CO2)/kg(dry matter)] emission factor for extratropical forest
      REAL(dp), PARAMETER  :: efactor_CO2_AG = 1308._dp        ! [g(CO2)/kg(dry matter)] emission factor for agriculture
      REAL(dp), PARAMETER  :: efactor_CO2_PT = 1703._dp        ! [g(CO2)/kg(dry matter)] emission factor for peat
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: efactor_CO2 = (/ -99._dp, efactor_CO2_TF, efactor_CO2_TF,       &
                                                                         efactor_CO2_EF, efactor_CO2_EF, efactor_CO2_EF, &
                                                                         efactor_CO2_EF, efactor_CO2_EF, efactor_CO2_EF, &
                                                                         efactor_CO2_TF, efactor_CO2_EF, efactor_CO2_SA, &
                                                                         efactor_CO2_SA, -99._dp, efactor_CO2_SA,        &
                                                                         efactor_CO2_SA, efactor_CO2_SA, -99._dp,        &
                                                                         efactor_CO2_AG, efactor_CO2_AG, efactor_CO2_AG, &
                                                                         efactor_CO2_PT /)
      
      ! CH4 emission factor from Kaiser et al., 2012, doi:10.5194/bg-9-527-2012
      REAL(dp), PARAMETER  :: efactor_CH4_SA = 2.2_dp          ! [g(CH4)/kg(dry matter)] emission factor for savannah 
      REAL(dp), PARAMETER  :: efactor_CH4_TF = 6.6_dp          ! [g(CH4)/kg(dry matter)] emission factor for tropical forest
      REAL(dp), PARAMETER  :: efactor_CH4_EF = 4.8_dp          ! [g(CH4)/kg(dry matter)] emission factor for extratropical forest
      REAL(dp), PARAMETER  :: efactor_CH4_AG = 8.4_dp          ! [g(CH4)/kg(dry matter)] emission factor for agriculture
      REAL(dp), PARAMETER  :: efactor_CH4_PT = 20.8_dp         ! [g(CH4)/kg(dry matter)] emission factor for peat
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: efactor_CH4 = (/ -99._dp, efactor_CH4_TF, efactor_CH4_TF,       &
                                                                         efactor_CH4_EF, efactor_CH4_EF, efactor_CH4_EF, &
                                                                         efactor_CH4_EF, efactor_CH4_EF, efactor_CH4_EF, &
                                                                         efactor_CH4_TF, efactor_CH4_EF, efactor_CH4_SA, &
                                                                         efactor_CH4_SA, -99._dp, efactor_CH4_SA,        &
                                                                         efactor_CH4_SA, efactor_CH4_SA, -99._dp,        &
                                                                         efactor_CH4_AG, efactor_CH4_AG, efactor_CH4_AG, &
                                                                         efactor_CH4_PT /)

      ! NOx emission factor from Kaiser et al., 2012, doi:10.5194/bg-9-527-2012
      REAL(dp), PARAMETER  :: efactor_NO_SA = 2.1_dp          ! [g(NOx)/kg(dry matter)] emission factor for savannah 
      REAL(dp), PARAMETER  :: efactor_NO_TF = 2.3_dp          ! [g(NOx)/kg(dry matter)] emission factor for tropical forest
      REAL(dp), PARAMETER  :: efactor_NO_EF = 3.4_dp          ! [g(NOx)/kg(dry matter)] emission factor for extratropical forest
      REAL(dp), PARAMETER  :: efactor_NO_AG = 2.3_dp          ! [g(NOx)/kg(dry matter)] emission factor for agriculture
      REAL(dp), PARAMETER  :: efactor_NO_PT = 1.0_dp          ! [g(NOx)/kg(dry matter)] emission factor for peat
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: efactor_NO = (/ -99._dp, efactor_NO_TF, efactor_NO_TF,       &
                                                                         efactor_NO_EF, efactor_NO_EF, efactor_NO_EF, &
                                                                         efactor_NO_EF, efactor_NO_EF, efactor_NO_EF, &
                                                                         efactor_NO_TF, efactor_NO_EF, efactor_NO_SA, &
                                                                         efactor_NO_SA, -99._dp, efactor_NO_SA,       &
                                                                         efactor_NO_SA, efactor_NO_SA, -99._dp,       &
                                                                         efactor_NO_AG, efactor_NO_AG, efactor_NO_AG, &
                                                                         efactor_NO_PT /)
                                                                         
      ! CO emission factor from Kaiser et al., 2012, doi:10.5194/bg-9-527-2012
      REAL(dp), PARAMETER  :: efactor_CO_SA = 61.0_dp           ! [g(CO)/kg(dry matter)] emission factor for savannah 
      REAL(dp), PARAMETER  :: efactor_CO_TF = 101.0_dp          ! [g(CO)/kg(dry matter)] emission factor for tropical forest
      REAL(dp), PARAMETER  :: efactor_CO_EF = 106.0_dp          ! [g(CO)/kg(dry matter)] emission factor for extratropical forest
      REAL(dp), PARAMETER  :: efactor_CO_AG = 92.0_dp           ! [g(CO)/kg(dry matter)] emission factor for agriculture
      REAL(dp), PARAMETER  :: efactor_CO_PT = 210.0_dp          ! [g(CO)/kg(dry matter)] emission factor for peat
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: efactor_CO = (/ -99._dp, efactor_CO_TF, efactor_CO_TF,        &
                                                                         efactor_CO_EF, efactor_CO_EF, efactor_CO_EF,  &
                                                                         efactor_CO_EF, efactor_CO_EF, efactor_CO_EF,  &
                                                                         efactor_CO_TF, efactor_CO_EF, efactor_CO_SA,  &
                                                                         efactor_CO_SA, -99._dp, efactor_CO_SA,        &
                                                                         efactor_CO_SA, efactor_CO_SA, -99._dp,        &
                                                                         efactor_CO_AG, efactor_CO_AG, efactor_CO_AG,  &
                                                                         efactor_CO_PT /)
                                                                         
      ! isoprene emission factor from Kaiser et al., 2012, doi:10.5194/bg-9-527-2012
      REAL(dp), PARAMETER  :: efactor_iso_SA = 0.026_dp         ! [g(isoprene)/kg(dry matter)] emission factor for savannah 
      REAL(dp), PARAMETER  :: efactor_iso_TF = 0.22_dp          ! [g(isoprene)/kg(dry matter)] emission factor for tropical forest
      REAL(dp), PARAMETER  :: efactor_iso_EF = 0.11_dp          ! [g(isoprene)/kg(dry matter)] emission factor for extratropical forest
      REAL(dp), PARAMETER  :: efactor_iso_AG = 0.40_dp          ! [g(isoprene)/kg(dry matter)] emission factor for agriculture
      REAL(dp), PARAMETER  :: efactor_iso_PT = 1.4_dp           ! [g(isoprene)/kg(dry matter)] emission factor for peat
      REAL(dp), DIMENSION(cover_type_max), PARAMETER  :: efactor_iso = (/ -99._dp, efactor_iso_TF, efactor_iso_TF,        &
                                                                          efactor_iso_EF, efactor_iso_EF, efactor_iso_EF, &
                                                                          efactor_iso_EF, efactor_iso_EF, efactor_iso_EF, &
                                                                          efactor_iso_TF, efactor_iso_EF, efactor_iso_SA, &
                                                                          efactor_iso_SA, -99._dp, efactor_iso_SA,        &
                                                                          efactor_iso_SA, efactor_iso_SA, -99._dp,        &
                                                                          efactor_iso_AG, efactor_iso_AG, efactor_iso_AG, &
                                                                          efactor_iso_PT /)

      IF (methane_options%do_fire) THEN
        ! Very likely CO2_fire_emission should not actually be interpreted as a CO2 flux, but rather as a C loss flux.
        ! Therefore convert CO2_fire_emission to C (dry biomass)
        matter_burned_kg = ((CO2_fire_emission / molarMassCO2_kg) * molarMassC_kg) / C_2_biomass_ratio        
        ! this SHOULD now be kg(dry matter)/m2(grid cell)/s
        
        !  CO2_fire_emission is a box flux, expressed as kg(CO2)/m2(grid cell)
        !  --> need to use cover fractions to convert emission factor to grid cell level
        
        CH4_fire_emission_kg(:) = 0._dp
        NO_fire_emission_kg(:)  = 0._dp
        CO_fire_emission_kg(:)  = 0._dp
        iso_fire_emission_kg(:) = 0._dp
        
        DO iLand = 1, nland
          iLand_k = iLand - 1 + kstart
          
          efactor_CH4_tile_sum = 0._dp
          efactor_NO_tile_sum  = 0._dp
          efactor_CO_tile_sum  = 0._dp
          efactor_iso_tile_sum = 0._dp
          DO iTile = 1, ntiles
            efactor_CH4_tile_sum = efactor_CH4_tile_sum + &
                                   cover_fract(iLand,iTile) * veg_ratio_max(iLand) * &
                                   efactor_CH4(cover_type(iLand,iTile)) 
            efactor_NO_tile_sum  = efactor_NO_tile_sum + &
                                   cover_fract(iLand,iTile) * veg_ratio_max(iLand) * &
                                   efactor_NO(cover_type(iLand,iTile)) 
            efactor_CO_tile_sum  = efactor_CO_tile_sum + &
                                   cover_fract(iLand,iTile) * veg_ratio_max(iLand) * &
                                   efactor_CO(cover_type(iLand,iTile)) 
            efactor_iso_tile_sum = efactor_iso_tile_sum + &
                                   cover_fract(iLand,iTile) * veg_ratio_max(iLand) * &
                                   efactor_iso(cover_type(iLand,iTile)) 
          END DO
          CH4_fire_emission_kg(iLand) = matter_burned_kg(iLand) * efactor_CH4_tile_sum / 1000._dp
          NO_fire_emission_kg(iLand)  = matter_burned_kg(iLand) * efactor_NO_tile_sum  / 1000._dp
          CO_fire_emission_kg(iLand)  = matter_burned_kg(iLand) * efactor_CO_tile_sum  / 1000._dp
          iso_fire_emission_kg(iLand) = matter_burned_kg(iLand) * efactor_iso_tile_sum / 1000._dp
        END DO
        
        CH4_fire_emission_mol = -CH4_fire_emission_kg / molarMassCH4_kg        ! flip sign for JSBACH sign convention -> loss of CH4 is negative
      ELSE
        CH4_fire_emission_mol(1:nland) = missing_value
        NO_fire_emission_kg(1:nland)   = missing_value
        CO_fire_emission_kg(1:nland)   = missing_value
        iso_fire_emission_kg(1:nland)  = missing_value
      END IF
      
      methane%box_CH4_out_fire(kstart:kend) = CH4_fire_emission_mol
      methane%box_CH4_out_fire_acc(kstart:kend) = methane%box_CH4_out_fire_acc(kstart:kend) + &
                                                  CH4_fire_emission_mol * delta_time
      methane%fire_em_NO(kstart:kend)  = NO_fire_emission_kg
      methane%fire_em_CO(kstart:kend)  = CO_fire_emission_kg
      methane%fire_em_iso(kstart:kend) = iso_fire_emission_kg * 1000._dp    ! isoprene emissions need to be saved as g, otherwise output does not work
   
    END SUBROUTINE update_methane_fire

!-----------------------------------------------------------------------------
    SUBROUTINE update_methane_termites(nland, ntiles, climbuf, GPP,         &
                                       cover_fract, cover_type,             &
                                       veg_fract_correction, veg_ratio_max, &
                                       methane)
                                   
      USE mo_jsbach_grid,      ONLY: kstart, kend           ! first and last value of kindex() 
      USE mo_jsbach_constants, ONLY: molarMassCO2_kg, molarMassCH4_kg, molarMassC_kg
      USE mo_jsbach,           ONLY: new_year, missing_value
      USE mo_climbuf,          ONLY: climbuf_type
    
      INTEGER,  INTENT(in) :: nland                                    ! number of land points
      INTEGER,  INTENT(in) :: ntiles                                   ! number of tiles
      REAL(dp), INTENT(in) :: cover_fract(nland,ntiles)                ! tile cover fraction
      TYPE(climbuf_type), INTENT(in) :: climbuf                        ! climate buffer
      REAL(dp), INTENT(in) :: GPP(nland,ntiles)                        ! Gross Primary Production [mol(C)/m^2(canopy) s]
      INTEGER,  INTENT(in) :: cover_type(nland,ntiles)                 ! tile cover type
      REAL(dp), INTENT(in) :: veg_fract_correction(nland,ntiles)       ! correction factor for area weighting factor to convert to grid cell average
      REAL(dp), INTENT(in) :: veg_ratio_max(nland)                     ! veg_ratio_max, needed for area weighting factor to convert to grid cell average
      TYPE(methane_type), INTENT(inout) :: methane                     ! structure with methane specific variables
      
      ! locals
      INTEGER             :: iLand, iLand_k, iTile
      
      REAL(dp), DIMENSION(ntiles) :: termite_CH4_g_h
      REAL(dp), DIMENSION(ntiles) :: termite_CH4_mol_s
      REAL(dp)                    :: termite_CH4_g_h_tile_sum
      REAL(dp)                    :: areafactor_sum
      REAL(dp)                    :: non_crop_mean
      REAL(dp)                    :: annual_GPP_g
      REAL(dp)                    :: termite_biomass_g
      
      REAL(dp), PARAMETER  :: efactor_CH4_TRO = 2.8e-6_dp     ! [g CH4 / g termite / h]
      REAL(dp), PARAMETER  :: efactor_CH4_TEM = 1.7e-6_dp     ! [g CH4 / g termite / h]
      REAL(dp), PARAMETER  :: seconds_per_year = 31536000._dp
      REAL(dp), PARAMETER  :: seconds_per_hour = 3600._dp

      IF (new_year .OR. lstart) THEN
        methane%gpp_prev_year(kstart:kend,:) = methane%gpp_ann_sum(kstart:kend,:)
        methane%gpp_ann_sum(kstart:kend,:) = GPP(1:nland,:) * delta_time
      ELSE
        methane%gpp_ann_sum(kstart:kend,:)  = methane%gpp_ann_sum(kstart:kend,:) + GPP(1:nland,:) * delta_time
      END IF

      IF (methane_options%do_termite) THEN
        DO iLand = 1, nland
          iLand_k = iLand - 1 + kstart
          
          termite_CH4_g_h_tile_sum = 0._dp
          termite_CH4_g_h = 0._dp
          areafactor_sum = 0._dp
          DO iTile = 1, ntiles
            termite_CH4_g_h(iTile) = 0._dp
            termite_biomass_g = 0._dp
            IF (cover_type(iLand,iTile) .LT. 17) THEN
              ! tropical termite biomass / emission factor assumed for cover types 2 (tropical broadleaf evergreen), 
              ! 3 (tropical broadleaf deciduous), 10 (raingreen shrubs), 13 (C4 grass), 16 (C4 pasture)
              IF ((cover_type(iLand,iTile) .EQ. 2) .OR. (cover_type(iLand,iTile) .EQ. 3) .OR. &
                  (cover_type(iLand,iTile) .EQ. 10) .OR. (cover_type(iLand,iTile) .EQ. 13) .OR. &
                  (cover_type(iLand,iTile) .EQ. 16)) THEN
                annual_GPP_g = methane%gpp_prev_year(iLand_k,iTile) * molarMassC_kg * 1000._dp;
                termite_biomass_g = 1.21_dp*exp(0.0008_dp*annual_GPP_g)
                termite_CH4_g_h(iTile) = termite_biomass_g * efactor_CH4_TRO
              ELSE
                ! non-tropical environment fixed termite biomass
                ! only if gddsum > 1200 and tmin > 3
                IF ((climbuf%min_mmtemp20(iLand_k) .GT. 3_dp) .AND. (climbuf%prev_year_gdd(iLand_k,iTile) .GT. 1200._dp)) THEN
                  termite_biomass_g = 3._dp
                  termite_CH4_g_h(iTile) = termite_biomass_g * efactor_CH4_TEM
                END IF
              END IF
              termite_CH4_g_h_tile_sum = termite_CH4_g_h_tile_sum + cover_fract(iLand,iTile) * veg_fract_correction(iLand,iTile) * termite_CH4_g_h(iTile)
              areafactor_sum = areafactor_sum + cover_fract(iLand,iTile) * veg_fract_correction(iLand,iTile)
            END IF
            methane%termite_biomass(iLand_k,iTile) = termite_biomass_g
          END DO
          non_crop_mean = termite_CH4_g_h_tile_sum/areafactor_sum
          DO iTile = 1, ntiles
            IF ((cover_type(iLand,iTile) .GE. 19) .AND. (cover_type(iLand,iTile) .LE. 21)) THEN
              !  Crops are 40% of non-crop mean
              termite_CH4_g_h(iTile) = non_crop_mean * 0.4_dp
            END IF
          END DO
          
          termite_CH4_mol_s = termite_CH4_g_h / 1000._dp / molarMassCH4_kg / seconds_per_hour
          methane%CH4_out_termite(iLand_k,:) = -methane_options%termite_scale*termite_CH4_mol_s                ! flip sign for JSBACH sign convention -> loss of CH4 is negative
        END DO
        methane%box_CH4_out_termite(kstart:kend,:) = methane%CH4_out_termite(kstart:kend,:) * cover_fract(1:nland,:) * &
                                                    veg_fract_correction(1:nland,:) * SPREAD(veg_ratio_max(1:nland),DIM=2,NCOPIES=ntiles)
      ELSE
        methane%box_CH4_out_termite(kstart:kend,:) = missing_value
      END IF
        
      methane%box_CH4_out_termite_acc(kstart:kend,:) = methane%box_CH4_out_termite_acc(kstart:kend,:) + &
                                                       methane%box_CH4_out_termite(kstart:kend,:) * delta_time
    END SUBROUTINE update_methane_termites
    
!-----------------------------------------------------------------------------
    SUBROUTINE update_methane_herbivores(nland, ntiles, herbivory2atm,       &
                                       cover_fract, cover_type,             &
                                       veg_fract_correction, veg_ratio_max, &
                                       methane)
                                   
      USE mo_jsbach_grid,      ONLY: kstart, kend           ! first and last value of kindex() 
      USE mo_jsbach_constants, ONLY: molarMassCO2_kg, molarMassCH4_kg, molarMassC_kg, C_2_biomass_ratio
      USE mo_jsbach,           ONLY: missing_value
    
      INTEGER,  INTENT(in) :: nland                                    ! number of land points
      INTEGER,  INTENT(in) :: ntiles                                   ! number of tiles
      REAL(dp), INTENT(inout) :: herbivory2atm(nland,ntiles)           ! herbivory flux to atmosphere
      REAL(dp), INTENT(in) :: cover_fract(nland,ntiles)                ! tile cover fraction
      INTEGER,  INTENT(in) :: cover_type(nland,ntiles)                 ! tile cover type
      REAL(dp), INTENT(in) :: veg_fract_correction(nland,ntiles)       ! correction factor for area weighting factor to convert to grid cell average
      REAL(dp), INTENT(in) :: veg_ratio_max(nland)                     ! veg_ratio_max, needed for area weighting factor to convert to grid cell average
      TYPE(methane_type), INTENT(inout) :: methane                     ! structure with methane specific variables
      
      ! locals
      INTEGER             :: iTile
      REAL(dp)            :: herbivore_methane(nland,ntiles)           ! methane flux from herbivores
      
      REAL(dp), PARAMETER  :: CH4prod_mammal = 14.9_dp      ! mean species value by Clauss et al., 2020
                                                            ! [g(CH4) / kg (DM)] We assume: DM = biomass

      REAL(dp), PARAMETER  :: mammalfrac_forest = 0.02_dp   ! herbivory fraction by mammals in forest
      REAL(dp), PARAMETER  :: mammalfrac_grass = 0.4_dp     ! herbivory fraction by mammals in grassland
      
      REAL(dp)             :: mammalfrac_tile(ntiles)
      
      mammalfrac_tile(1:ntiles) = 0._dp
      mammalfrac_tile(1:6) = mammalfrac_forest
      mammalfrac_tile(7:11) = mammalfrac_grass

      IF (methane_options%do_herbivore) THEN
        DO iTile = 1, ntiles
          herbivore_methane(1:nland,iTile) = herbivory2atm(1:nland,iTile) * molarMassC_kg / C_2_biomass_ratio * &
                                             mammalfrac_tile(iTile) * CH4prod_mammal * methane_options%herbivore_scale
        END DO
        methane%CH4_out_herbivore(kstart:kend,:) = herbivore_methane(1:nland,:) / 1000._dp / &
                                                   molarMassCH4_kg   ! convert to mol
        methane%box_CH4_out_herbivore(kstart:kend,:) = methane%CH4_out_herbivore(kstart:kend,:) * cover_fract(1:nland,:) * &
                                                       veg_fract_correction(1:nland,:) * SPREAD(veg_ratio_max(1:nland),DIM=2,NCOPIES=ntiles)
      ELSE
        methane%box_CH4_out_herbivore(kstart:kend,:) = missing_value
      END IF
        
      methane%box_CH4_out_herbivore_acc(kstart:kend,:) = methane%box_CH4_out_herbivore_acc(kstart:kend,:) + &
                                                         methane%box_CH4_out_herbivore(kstart:kend,:) * delta_time
    END SUBROUTINE update_methane_herbivores
    
END MODULE mo_methane
