# site specific compiler settings
COMP = x86_64-intel 
C_N = ifort 
M_K = gmake --no-print-directory 
F_C = $(C_N) -c -cpp -fp-model strict -fp-speculation=off -D __QUINCY_NO_JSB__ 
F_O = -O2 -I../src/include -I$(MODDIR) -module ${MODDIR}
F_L = $(C_N)
