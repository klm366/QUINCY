# default SLM usecase: 03_autotestrun_500yr_std_s0d_def
# 
# used by the script: ./contrib/additional_scripts/automated_slm_testrun.sh
# for automated test runs of SLM
# 

slmModel="land"
forcingDataSet="fluxnet"
forcingMode="static"
singleSiteName=""

specialFluxnetOutput="F"
compareSimCRUNCEPvsGFDB="F"
paramSensitivitySim="F"

sb_model_scheme="simple_0d"
flag_sb_prescribe_po4="T"
biomass_alloc_scheme="dynamic"
leaf_stoichom_scheme="dynamic"
soil_depth=9.5
nsoil_layer=15

simulation_length_number=500
output_interval_pool="weekly"
output_interval_flux="weekly"
output_start_first_day_year=1
output_end_last_day_year=500

useSiteSpecificAWC="T"
n_deposition_scheme="dynamic"
p_deposition_scheme="dynamic"
queue="io_perform"
