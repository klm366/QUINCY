# default SLM usecase: 20_land_300yr_fluxnet_all_def
# 
# very basic usecase for running SLM land over 300 years
#  sites: all fluxnet sites
#  output: monthly over 300 years
#

slmModel="land"

forcingDataSet="fluxnet"
forcingMode="static"
customSiteList="F"
singleSiteName=""

simulation_length_number=300
output_interval_pool="monthly"
output_interval_flux="monthly"
output_start_first_day_year=1
output_end_last_day_year=300
