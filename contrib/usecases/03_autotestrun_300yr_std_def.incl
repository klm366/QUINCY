# default SLM usecase: 03_autotestrun_300yr_std_def
# 
# used by the script: ./contrib/additional_scripts/automated_slm_testrun.sh
# for automated testruns
# 

slmModel="land"
forcingDataSet="fluxnet"
forcingMode="static"
customSiteList="F"
singleSiteName=""

simulation_length_number=300
output_interval_pool="weekly"
output_interval_flux="weekly"
output_start_first_day_year=1
output_end_last_day_year=300

useSiteSpecificAWC="F"
queue="io"
