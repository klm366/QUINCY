&VEGETATION_CTL
  ! options for the vegetation, read by the plant_model_driver
  output_interval_pool="daily"
  output_interval_flux="daily"
  output_start_first_day_year=1
  output_end_last_day_year=30
  flag_optimal_Nfraction=.TRUE.
  flag_optimal_Nleaf=.FALSE.
  flag_optimal_allocation=.FALSE.
  flag_calc_soil_uptake=.TRUE.
  flag_calc_soil_moisture=.FALSE.
  flag_base_soil_model=.FALSE.
  soil_awc_prescribe=300.0
  soil_theta_prescribe=100.0
  plant_functional_type_id=1
/
&FORCING_CTL
  ! options for plant model forcing
  ! create forcing: constant readfile generate
  option_forcing="readfile"
/
&GRID_CTL
  latitude=50.0
  longitude=0.0
/
&BASE_CTL
  ! basic model config
  dt_time_step_length_sec=1800.0
  ! units: y years, w weeks, d days
  simulation_length_unit="y"
  ! integer values
  simulation_length_number=30
/

