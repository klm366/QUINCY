&VEGETATION_CTL
  ! options for the vegetation
  output_interval_pool="weekly"
  output_interval_flux="weekly"
  output_start_first_day_year=1
  output_end_last_day_year=30
  n_uptake_scheme="standard"
  flag_calc_soil_moisture=.FALSE.
  flag_tile_veg_dynamics=.FALSE.
  flag_optimal_Nleaf=.FALSE.
  flag_optimal_allocation=.FALSE.
  soil_awc_prescribe=300.0
  soil_theta_prescribe=100.0
  plant_functional_type_id=5
/
&ASSIMILATION_CTL
  ! options for the assimilation and vegetation-growth
  ! [FALSE TRUE]
  flag_optimal_Nfraction=.FALSE.
  flag_heterogeneous_canopy=.FALSE.
  flag_t_resp_acclimation=.FALSE.
  flag_t_jmax_acclimation=.FALSE.
  ! number of canopy layers [int value, may default to 20]
  ncanopy=20
  ! canopy layer depth calculation [standard = 0.5, fapar]
  canopy_layer_scheme="standard"
/
&PHENOLOGY_CTL
  ! tba
/
&GRID_CTL
  latitude=50.0
  longitude=0.0
/
&SOIL_CTL
  ! number of soil layers [default is 5] [energy==water]
  nsoil_energy=5
  nsoil_water=5
/
&BASE_CTL
  ! basic model config
  dtime_step_length_sec=1800.0
  ! units: y years, w weeks, d days
  simulation_length_unit="y"
  ! integer values
  simulation_length_number=30
  ! SLM model: land plant soil canopy test_canopy
  slm_model_name="land"
  ! if fluxnet sites: output per timestep for last forcing period [FALSE TRUE]
  fluxnet_output=.FALSE.
  ! length of forcing period [years] provided by data file
  fluxnet_output_length=2
  ! output of the complete veg%litterfall pool plus some biophysic variables per timestep [FALSE TRUE]
  flag_litterfall_output=.FALSE.
  ! set parameter values from file [FALSE TRUE]
  set_parameter_values_from_file=.FALSE.
  ! use only the 1st year of climate input [FALSE TRUE]
  flag_climate_forcing_one_year=.FALSE.
/

