# Example config for a standard Quincy standalone experiment
#

ENVIRONMENT  = levante
ACCOUNT      = mj0143

EXP_TYPE     = jsbalone-R2B4
EXP_OPTIONS  = quincy_standard_options_8
QUINCY_MODEL = land         # Quincy model config: land,plant,canopy
SIM_TYPE     = spin_up           # Simulation type: spin_up, S2, S0
DYN_NITROGEN = false          ###### true (cn simulation) or false (c simulation)
CLIMATE_FORCING = GSWP3        # GSWP3. ICON-XPP

## LOOK AT THE INIT DATE
INITIAL_DATE = eval('1830-01-01' if '$SIM_TYPE' == 'spin_up' else '2045-01-01')
FINAL_DATE   = eval('1850-01-01' if '$SIM_TYPE' == 'spin_up' else ('2014-12-31' if '$CLIMATE_FORCING' == 'ICON-XPP' else '2056-01-01'))


#PARENT_EXP_ID    = spin_si_gswp3_CN_restart
PARENT_EXP_ID    = ndep_test7
PARENT_DATE      = 18300101
#PARENT_DIR       = /scratch/b/b301072/build_run/IQL_C_v0009/experiments/spin_si_gswp3_CN_restart/work/
PARENT_DIR       = /scratch/b/b301106/build_run/ndep_test1/experiments/ndep_test7/work

[jobs]
  [[run]]
    use_mpmd = false
    use_hostfile = false
  [[run_start]]
    [[[namelists]]]
      [[[[icon_master.namelist]]]]
        [[[[[master_nml]]]]]
          lrestart = true
        [[[[[master_time_control_nml]]]]]
          experimentstartdate = $$reference_date
        [[[[[jsb_control_nml]]]]]
          restart_jsbach = true
    [[[files]]]
      [[[[land]]]]
        [[[[[restart_data]]]]]
          .base_dir = $LAND_PARENT_DIR
          multifile_restart_jsbach_data.mfr = ${LAND_PARENT_EXP_ID}_restart_jsbalone_${LAND_PARENT_DATE}T000000Z.mfr
        [[[[[restart]]]]]
          .base_dir = .
          .method = "ln -svnf"
          multifile_restart_jsbach.mfr = multifile_restart_jsbach_data.mfr

