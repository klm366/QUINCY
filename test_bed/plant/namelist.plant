&VEGETATION_CTL
  ! options for the vegetation, read by the plant_model_driver
  read_output_interval_pool="weekly"
  read_output_interval_flux="weekly"
  output_start_first_day_year=1
  output_end_last_day_year=10
  flag_optimal_Nfraction=.FALSE.
  flag_optimal_Nleaf=.FALSE.
  flag_calc_soil_uptake=.FALSE.
  plant_functional_type_id=1
/
&FORCING_CTL
  ! options for plant model forcing
  ! create forcing: constant readfile generate
  create_forcing="readfile"
/
&GRID_CTL
  read_latitude=50.0
  read_longitude=0.0
/
&BASE_CTL
  ! basic model config
  time_step_length_sec=1800.0
  ! units: y years, w weeks, d days
  simulation_length_unit="y"
  ! integer values
  simulation_length_number=20
/

