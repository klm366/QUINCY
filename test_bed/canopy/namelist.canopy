&VEGETATION_CTL
  ! options for the vegetation, read by the canopy_model_driver
  flag_optimal_Nfraction=.FALSE.
  flag_optimal_Nleaf=.FALSE.
  flag_calc_soil_moisture=.FALSE.
  soil_awc_prescribe=300.0
  soil_theta_prescribe=100.0
  plant_functional_type_id=1
/
&FORCING_CTL
  ! options for plant model forcing
  ! create forcing: constant readfile generate
  option_forcing="readfile"
/
&GRID_CTL
  latitude=50.0
  longitude=0.0
/
&BASE_CTL
  ! basic model config
  dt_time_step_length_sec=1800.0
  ! units: y years, w weeks, d days
  simulation_length_unit="y"
  ! integer values
  simulation_length_number=5
/

